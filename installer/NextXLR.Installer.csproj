<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\nextXLR_icon.ico</ApplicationIcon>
    <AssemblyName>NextXLR-Setup-0.1.8-alpha</AssemblyName>
    <Product>NEXT : XLR Setup</Product>
    <Version>0.1.8-alpha</Version>
    <AssemblyVersion>0.1.8.0</AssemblyVersion>
    <FileVersion>0.1.8.0</FileVersion>
    <Company>plysystems</Company>
    <Copyright>© plysystems. All rights reserved.</Copyright>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="payload.zip" Condition="Exists('payload.zip')" />
    <EmbeddedResource Include="..\nextXLR_logo.png" Link="nextXLR_logo.png" />
    <EmbeddedResource Include="..\nextXLR_icon.ico" Link="nextXLR_icon.ico" />
  </ItemGroup>

</Project>

