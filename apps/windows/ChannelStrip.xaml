<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NextXLR.ChannelStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NextXLR"
    xmlns:controls="using:NextXLR.Controls">

    <!-- Responsive channel strip: modular studio console bay -->
    <Border Width="{x:Bind ViewModel.StripWidth, Mode=OneWay}" Background="{ThemeResource SurfaceL2Brush}" CornerRadius="12" Padding="6,10" MinWidth="84"
            VerticalAlignment="Stretch" BorderBrush="{ThemeResource SurfaceStrokeBrush}" BorderThickness="1">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="34" />
                <RowDefinition Height="*" MinHeight="180" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Icon Button + Edit + Hardware Fader Letter Badge (Single-mode) -->
            <Grid Height="42">
                <Button x:Name="CustomizeButton" x:Uid="MixerCustomize" Width="40" Height="40" Padding="0"
                        CornerRadius="20" HorizontalAlignment="Center" BorderThickness="1"
                        BorderBrush="{ThemeResource SurfaceStrokeBrush}"
                        Background="{x:Bind ChannelIconBackground(ViewModel.Accent), Mode=OneWay}"
                        IsHitTestVisible="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ChannelTooltip(ViewModel.CanEdit, ViewModel.Name), Mode=OneWay}">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFFFFF" Opacity="0.9" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FFFFFF" Opacity="0.7" />
                    </Button.Resources>
                    <FontIcon Glyph="{x:Bind ViewModel.Glyph, Mode=OneWay}" FontSize="18"
                              Foreground="{x:Bind ChannelIconForeground(ViewModel.Accent), Mode=OneWay}" />
                    <Button.Flyout>
                        <Flyout x:Name="CustomizeFlyout" Placement="Right" Opening="CustomizeFlyout_Opening">
                            <StackPanel Width="320" Spacing="14">
                                <TextBlock x:Uid="MixerCustomizeTitle" Style="{StaticResource CardTitle}" />
                                <TextBox x:Name="LabelBox" x:Uid="MixerLabelBox" MaxLength="24"
                                         KeyDown="LabelBox_KeyDown" />
                                <StackPanel Spacing="8">
                                    <TextBlock x:Uid="MixerIconHeader" Style="{StaticResource Caption}" />
                                    <GridView x:Name="IconGrid" ItemsSource="{x:Bind Icons}" SelectionMode="Single"
                                              IsItemClickEnabled="True" ItemClick="IconGrid_ItemClick"
                                              MaxHeight="260">
                                        <GridView.ItemTemplate>
                                            <DataTemplate x:DataType="local:IconCatalogEntry">
                                                <Border Width="44" Height="40">
                                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" />
                                                </Border>
                                            </DataTemplate>
                                        </GridView.ItemTemplate>
                                    </GridView>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                    <Button x:Uid="MixerResetIcon" Click="ResetIcon_Click" />
                                    <Button x:Uid="MixerSave" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- Edit name & icon button (pencil) - only visible for editable channels -->
                <Button x:Uid="MixerEditButton" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="4"
                        Background="Transparent" BorderThickness="0" Click="Edit_Click"
                        Visibility="{x:Bind ViewModel.CanEdit, Mode=OneWay}">
                    <FontIcon Glyph="&#xE70F;" FontSize="11" Foreground="{ThemeResource TextMutedBrush}" />
                </Button>

                <!-- Hardware fader letter badge (Single-Mix mode only; in Dual-Mix mode it's placed on the active mix column) -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="6" Padding="6,2"
                        Background="{ThemeResource SurfaceL3Brush}" BorderBrush="{x:Bind ViewModel.Accent, Mode=OneWay}"
                        BorderThickness="1"
                        Visibility="{x:Bind ShowSingleBadge(ViewModel.HasFader, ViewModel.ShowDualMix), Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.FaderLetter, Mode=OneWay}" FontSize="10" FontWeight="Bold"
                               Foreground="{x:Bind ViewModel.Accent, Mode=OneWay}" />
                </Border>
            </Grid>

            <!-- Row 1: Channel Name: 2 lines wrapped so "Headphones" and "Broadcast" never truncate! -->
            <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" MaxLines="2" />

            <!-- Row 2: Dual-Mix Fader Assembly OR Single Fader Assembly -->
            <!-- Dual-Mix Mode: Kopfhörer-Mix [Default/Links] & Stream-Mix [Rechts] side-by-side stretching full card height -->
            <Grid Grid.Row="2" Grid.RowSpan="3"
                  Visibility="{x:Bind ShowIfDual(ViewModel.ShowDualMix, ViewModel.IsFixed, ViewModel.IsOutput), Mode=OneWay}"
                  ColumnSpacing="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Kopfhörer-Mix (Submix) -->
                <Border CornerRadius="8" Padding="3,6"
                        VerticalAlignment="Stretch"
                        Background="{ThemeResource SurfaceL3Brush}"
                        BorderBrush="{x:Bind TrackBorderPhones(ViewModel.ShowFaderOnPhones), Mode=OneWay}"
                        BorderThickness="1">
                    <Grid RowSpacing="6" VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="140" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Tall precision Kopfhörer Fader with meter -->
                        <controls:Fader x:Name="PhonesFader" Width="48"
                                        HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                        Minimum="{x:Bind ViewModel.MinVolumePercent, Mode=OneWay}"
                                        Maximum="{x:Bind ViewModel.MaxVolumePercent, Mode=OneWay}"
                                        Value="{x:Bind ViewModel.SubmixVolumePercent, Mode=OneWay}"
                                        Accent="{StaticResource HeadphoneBrush}"
                                        MeterLevel="{x:Bind ViewModel.Meter, Mode=OneWay}"
                                        PeakHold="{x:Bind ViewModel.PeakHold, Mode=OneWay}"
                                        IsMetered="{x:Bind ViewModel.Metered, Mode=OneWay}" />

                        <!-- Volume dB readout -->
                        <Border Grid.Row="1" Background="{ThemeResource SurfaceL2Brush}" CornerRadius="4" Padding="5,1"
                                HorizontalAlignment="Center" BorderBrush="{ThemeResource SurfaceStrokeSubtleBrush}" BorderThickness="1">
                            <TextBlock Text="{x:Bind ViewModel.SubmixVolumeDbLabel, Mode=OneWay}"
                                       FontSize="12" FontWeight="Bold" FontFamily="{StaticResource MonoFont}"
                                       Foreground="{StaticResource HeadphoneBrush}" HorizontalAlignment="Center"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.SubmixVolumePercentLabel, Mode=OneWay}" />
                        </Border>

                        <!-- Kopfhörer Pill + Hardware Fader Badge -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center">
                            <Border Background="{ThemeResource SurfaceL2Brush}" CornerRadius="4" Padding="5,2">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <FontIcon Glyph="&#xE7F6;" FontSize="9" Foreground="{StaticResource HeadphoneBrush}" />
                                    <TextBlock Text="PHONES" FontSize="9" FontWeight="Bold" Foreground="{StaticResource HeadphoneBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Visibility="{x:Bind ViewModel.ShowFaderOnPhones, Mode=OneWay}"
                                    Background="{ThemeResource SurfaceL2Brush}" CornerRadius="4" Padding="4,2"
                                    BorderBrush="{StaticResource HeadphoneBrush}" BorderThickness="1">
                                <TextBlock Text="{x:Bind ViewModel.FaderLetter, Mode=OneWay}" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource HeadphoneBrush}" />
                            </Border>
                        </StackPanel>

                        <!-- Kopfhörer Mute Toggle -->
                        <ToggleButton Grid.Row="3" Height="30" Width="38" Padding="0" HorizontalAlignment="Center"
                                      Style="{StaticResource SmoothDangerToggle}" IsThreeState="False"
                                      IsChecked="{x:Bind ViewModel.SubmixMuted, Mode=TwoWay}"
                                      ToolTipService.ToolTip="Kopfhörer stummschalten">
                            <FontIcon Glyph="{x:Bind MuteGlyph(ViewModel.SubmixMuted), Mode=OneWay}" FontSize="12" />
                        </ToggleButton>
                    </Grid>
                </Border>

                <!-- Subtle vertical divider between Kopfhörer and Stream tracks -->
                <Border Grid.Column="1" Width="1" Background="{ThemeResource SurfaceStrokeSubtleBrush}"
                        VerticalAlignment="Stretch" Margin="0,4" />

                <!-- Right Column: Stream-Mix -->
                <Border Grid.Column="2" CornerRadius="8" Padding="3,6"
                        VerticalAlignment="Stretch"
                        Background="{ThemeResource SurfaceL3Brush}"
                        BorderBrush="{x:Bind TrackBorderStream(ViewModel.ShowFaderOnStream), Mode=OneWay}"
                        BorderThickness="1">
                    <Grid RowSpacing="6" VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="140" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Tall precision Stream Fader with meter -->
                        <controls:Fader x:Name="StreamFader" Width="48"
                                        HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                        Minimum="{x:Bind ViewModel.MinVolumePercent, Mode=OneWay}"
                                        Maximum="{x:Bind ViewModel.MaxVolumePercent, Mode=OneWay}"
                                        Value="{x:Bind ViewModel.StreamVolumePercent, Mode=OneWay}"
                                        Accent="{x:Bind ViewModel.Accent, Mode=OneWay}"
                                        MeterLevel="{x:Bind ViewModel.Meter, Mode=OneWay}"
                                        PeakHold="{x:Bind ViewModel.PeakHold, Mode=OneWay}"
                                        IsMetered="{x:Bind ViewModel.Metered, Mode=OneWay}" />

                        <!-- Volume dB readout -->
                        <Border Grid.Row="1" Background="{ThemeResource SurfaceL2Brush}" CornerRadius="4" Padding="5,1"
                                HorizontalAlignment="Center" BorderBrush="{ThemeResource SurfaceStrokeSubtleBrush}" BorderThickness="1">
                            <TextBlock Text="{x:Bind ViewModel.StreamVolumeDbLabel, Mode=OneWay}"
                                       FontSize="12" FontWeight="Bold" FontFamily="{StaticResource MonoFont}"
                                       Foreground="{StaticResource BrandBrush}" HorizontalAlignment="Center"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.StreamVolumePercentLabel, Mode=OneWay}" />
                        </Border>

                        <!-- Stream Pill + Hardware Fader Badge -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center">
                            <Border Background="{ThemeResource SurfaceL2Brush}" CornerRadius="4" Padding="5,2">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <FontIcon Glyph="&#xE774;" FontSize="9" Foreground="{StaticResource BrandBrush}" />
                                    <TextBlock Text="STREAM" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrandBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Visibility="{x:Bind ViewModel.ShowFaderOnStream, Mode=OneWay}"
                                    Background="{ThemeResource SurfaceL2Brush}" CornerRadius="4" Padding="4,2"
                                    BorderBrush="{StaticResource BrandBrush}" BorderThickness="1">
                                <TextBlock Text="{x:Bind ViewModel.FaderLetter, Mode=OneWay}" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource BrandBrush}" />
                            </Border>
                        </StackPanel>

                        <!-- Stream Mute Toggle -->
                        <ToggleButton Grid.Row="3" Height="30" Width="38" Padding="0" HorizontalAlignment="Center"
                                      Style="{StaticResource SmoothDangerToggle}" IsThreeState="False"
                                      IsChecked="{x:Bind ViewModel.Muted, Mode=TwoWay}"
                                      ToolTipService.ToolTip="Stream stummschalten">
                            <FontIcon Glyph="{x:Bind MuteGlyph(ViewModel.Muted), Mode=OneWay}" FontSize="12" />
                        </ToggleButton>
                    </Grid>
                </Border>
            </Grid>

            <!-- Single-Mix Mode (Kopfhörer or Stream) & Output Channels & Meter Channels:
                 Sculpted recessed studio console track bay -->
            <Border Grid.Row="2" Grid.RowSpan="3"
                    Visibility="{x:Bind ShowIfSingle(ViewModel.ShowDualMix, ViewModel.IsFixed, ViewModel.IsOutput), Mode=OneWay}"
                    CornerRadius="8" Padding="4,6" MaxWidth="124"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="{ThemeResource SurfaceL3Brush}"
                    BorderBrush="{x:Bind SingleTrackBorder(ViewModel.HasFader, ViewModel.IsSubmixActive, ViewModel.Accent), Mode=OneWay}"
                    BorderThickness="1">
                <Grid RowSpacing="6" VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="140" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Precision Fader with meter -->
                    <controls:Fader x:Name="Fader" Width="58"
                                    HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                    Minimum="{x:Bind ViewModel.MinVolumePercent, Mode=OneWay}"
                                    Maximum="{x:Bind ViewModel.MaxVolumePercent, Mode=OneWay}"
                                    Value="{x:Bind ViewModel.VolumePercent, Mode=OneWay}"
                                    MeterLevel="{x:Bind ViewModel.Meter, Mode=OneWay}"
                                    PeakHold="{x:Bind ViewModel.PeakHold, Mode=OneWay}"
                                    IsMetered="{x:Bind ViewModel.Metered, Mode=OneWay}"
                                    Accent="{x:Bind SingleFaderAccent(ViewModel.IsSubmixActive, ViewModel.Accent), Mode=OneWay}" />

                    <!-- Row 1: Volume dB readout (Click to edit) -->
                    <Grid Grid.Row="1" HorizontalAlignment="Center">
                        <Border Background="{ThemeResource SurfaceL2Brush}" CornerRadius="6" Padding="6,2"
                                BorderBrush="{ThemeResource SurfaceStrokeSubtleBrush}" BorderThickness="1">
                            <StackPanel x:Name="LevelDisplayPanel" Orientation="Horizontal" HorizontalAlignment="Center"
                                        Background="Transparent"
                                        ToolTipService.ToolTip="{x:Bind EditTooltip(ViewModel.IsFixed), Mode=OneWay}"
                                        Tapped="LevelDisplay_Tapped" PointerPressed="LevelDisplay_PointerPressed">
                                <TextBlock Text="{x:Bind LevelText(ViewModel.IsFixed, ViewModel.VolumeDbLabel, ViewModel.PeakLabel), Mode=OneWay}"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource BrandBrush}"
                                           FontFamily="{StaticResource MonoFont}" HorizontalAlignment="Center"
                                           IsHitTestVisible="False" />
                            </StackPanel>
                        </Border>
                        <TextBox x:Name="LevelInputBox" Width="68" TextAlignment="Center" FontSize="13" Height="28" Padding="2"
                                 FontFamily="{StaticResource MonoFont}"
                                 Visibility="Collapsed" KeyDown="LevelInputBox_KeyDown" LostFocus="LevelInputBox_LostFocus" />
                    </Grid>

                    <!-- Row 2: Sub-label (% and Peak or Mute restore or Meter-Only) -->
                    <TextBlock Grid.Row="2" HorizontalAlignment="Center" Style="{StaticResource Caption}" FontSize="10"
                               Foreground="{ThemeResource TextMutedBrush}"
                               Text="{x:Bind SubLabel(ViewModel.ActiveMuted, ViewModel.RestoreLabel, ViewModel.Metered, ViewModel.PeakLabel, ViewModel.IsFixed, ViewModel.VolumePercentLabel), Mode=OneWay}" />

                    <!-- Row 3: Active Mix & Hardware Fader Badge Bar -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center">
                        <!-- Active Mix Badge Pill -->
                        <Border Background="{ThemeResource SurfaceL2Brush}" CornerRadius="4" Padding="5,2">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <FontIcon Glyph="{x:Bind SingleMixGlyph(ViewModel.IsOutput, ViewModel.IsSubmixActive), Mode=OneWay}"
                                          FontSize="9"
                                          Foreground="{x:Bind SingleMixForeground(ViewModel.IsOutput, ViewModel.IsSubmixActive), Mode=OneWay}" />
                                <TextBlock Text="{x:Bind SingleMixBadgeText(ViewModel.IsOutput, ViewModel.IsSubmixActive), Mode=OneWay}"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="{x:Bind SingleMixForeground(ViewModel.IsOutput, ViewModel.IsSubmixActive), Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <!-- Hardware Fader Assignment Pill (e.g. [ A ]) -->
                        <Border Visibility="{x:Bind SingleFaderBadgeVisibility(ViewModel.HasFader), Mode=OneWay}"
                                Background="{ThemeResource SurfaceL2Brush}" CornerRadius="4" Padding="4,2"
                                BorderBrush="{x:Bind SingleTrackBorder(ViewModel.HasFader, ViewModel.IsSubmixActive, ViewModel.Accent), Mode=OneWay}"
                                BorderThickness="1">
                            <TextBlock Text="{x:Bind ViewModel.FaderLetter, Mode=OneWay}" FontSize="9" FontWeight="Bold"
                                       Foreground="{x:Bind SingleTrackBorder(ViewModel.HasFader, ViewModel.IsSubmixActive, ViewModel.Accent), Mode=OneWay}" />
                        </Border>
                    </StackPanel>

                    <!-- Row 4: Smart Mute toggle button -->
                    <ToggleButton Grid.Row="4" Height="30" Width="38" Padding="0" HorizontalAlignment="Center"
                                  Style="{StaticResource SmoothDangerToggle}" IsThreeState="False"
                                  IsChecked="{x:Bind ViewModel.ActiveMuted, Mode=TwoWay}"
                                  ToolTipService.ToolTip="{x:Bind ViewModel.ActiveMuteTooltip, Mode=OneWay}"
                                  AutomationProperties.Name="{x:Bind MuteName(ViewModel.Name), Mode=OneWay}">
                        <FontIcon Glyph="{x:Bind MuteGlyph(ViewModel.ActiveMuted), Mode=OneWay}" FontSize="12" />
                    </ToggleButton>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>