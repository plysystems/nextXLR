<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NextXLR.ChannelStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NextXLR"
    xmlns:controls="using:NextXLR.Controls">

    <!-- Responsive channel strip: sleek unboxed design with subtle separation and ergonomic fader layout -->
    <Border Background="{StaticResource SurfaceL1Brush}" CornerRadius="14" Padding="8,14,8,12" MinWidth="84"
            BorderBrush="{StaticResource SurfaceStrokeSubtleBrush}" BorderThickness="1">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="34" />
                <RowDefinition Height="*" MinHeight="180" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Icon Button + Edit + Hardware Fader Letter Badge (Single-mode) -->
            <Grid Height="42">
                <Button x:Name="CustomizeButton" x:Uid="MixerCustomize" Width="40" Height="40" Padding="0"
                        CornerRadius="20" HorizontalAlignment="Center" BorderThickness="1"
                        BorderBrush="{StaticResource SurfaceStrokeBrush}"
                        Background="{x:Bind ChannelIconBackground(ViewModel.Accent), Mode=OneWay}"
                        IsHitTestVisible="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ChannelTooltip(ViewModel.CanEdit, ViewModel.Name), Mode=OneWay}">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFFFFF" Opacity="0.9" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FFFFFF" Opacity="0.7" />
                    </Button.Resources>
                    <FontIcon Glyph="{x:Bind ViewModel.Glyph, Mode=OneWay}" FontSize="18"
                              Foreground="{x:Bind ChannelIconForeground(ViewModel.Accent), Mode=OneWay}" />
                    <Button.Flyout>
                        <Flyout x:Name="CustomizeFlyout" Placement="Right" Opening="CustomizeFlyout_Opening">
                            <StackPanel Width="320" Spacing="14">
                                <TextBlock x:Uid="MixerCustomizeTitle" Style="{StaticResource CardTitle}" />
                                <TextBox x:Name="LabelBox" x:Uid="MixerLabelBox" MaxLength="24"
                                         KeyDown="LabelBox_KeyDown" />
                                <StackPanel Spacing="8">
                                    <TextBlock x:Uid="MixerIconHeader" Style="{StaticResource Caption}" />
                                    <GridView x:Name="IconGrid" ItemsSource="{x:Bind Icons}" SelectionMode="Single"
                                              IsItemClickEnabled="True" ItemClick="IconGrid_ItemClick"
                                              MaxHeight="260">
                                        <GridView.ItemTemplate>
                                            <DataTemplate x:DataType="local:IconCatalogEntry">
                                                <Border Width="44" Height="40">
                                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" />
                                                </Border>
                                            </DataTemplate>
                                        </GridView.ItemTemplate>
                                    </GridView>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                    <Button x:Uid="MixerResetIcon" Click="ResetIcon_Click" />
                                    <Button x:Uid="MixerSave" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- Edit name & icon button (pencil) - only visible for editable channels -->
                <Button x:Uid="MixerEditButton" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="4"
                        Background="Transparent" BorderThickness="0" Click="Edit_Click"
                        Visibility="{x:Bind ViewModel.CanEdit, Mode=OneWay}">
                    <FontIcon Glyph="&#xE70F;" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                </Button>

                <!-- Hardware fader letter badge (Single-Mix mode only; in Dual-Mix mode it's placed on the active mix column) -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="6" Padding="6,1"
                        Background="{StaticResource SurfaceL3Brush}" BorderBrush="{StaticResource SurfaceStrokeBrush}"
                        BorderThickness="1"
                        Visibility="{x:Bind ShowSingleBadge(ViewModel.HasFader, ViewModel.ShowDualMix), Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.FaderLetter, Mode=OneWay}" FontSize="10" FontWeight="Bold"
                               Foreground="{x:Bind ViewModel.Accent, Mode=OneWay}" />
                </Border>
            </Grid>

            <!-- Row 1: Channel Name: 2 lines wrapped so "Headphones" and "Broadcast" never truncate! -->
            <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" MaxLines="2" />

            <!-- Row 2: Dual-Mix Fader Assembly OR Single Fader Assembly -->
            <!-- Dual-Mix Mode: Stream-Mix & Kopfhörer-Mix side-by-side with sleek central separation -->
            <Grid Grid.Row="2" Grid.RowSpan="3" Visibility="{x:Bind ShowIfDual(ViewModel.ShowDualMix, ViewModel.IsFixed), Mode=OneWay}"
                  ColumnSpacing="8" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Stream-Mix -->
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <controls:Fader x:Name="StreamFader" Width="44" Height="180"
                                    Minimum="{x:Bind ViewModel.MinVolumePercent, Mode=OneWay}"
                                    Maximum="{x:Bind ViewModel.MaxVolumePercent, Mode=OneWay}"
                                    Value="{x:Bind ViewModel.StreamVolumePercent, Mode=OneWay}"
                                    Accent="{x:Bind ViewModel.Accent, Mode=OneWay}"
                                    MeterLevel="{x:Bind ViewModel.Meter, Mode=OneWay}"
                                    PeakHold="{x:Bind ViewModel.PeakHold, Mode=OneWay}"
                                    IsMetered="{x:Bind ViewModel.Metered, Mode=OneWay}" />
                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.StreamVolumeLabel, Mode=OneWay}"
                                   FontSize="13" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}" HorizontalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center">
                            <Border Background="{StaticResource SurfaceL3Brush}" CornerRadius="4" Padding="4,1">
                                <TextBlock Text="STREAM" FontSize="8" FontWeight="Bold" Foreground="{StaticResource BrandBrush}" />
                            </Border>
                            <Border Visibility="{x:Bind ViewModel.ShowFaderOnStream, Mode=OneWay}"
                                    Background="{StaticResource SurfaceL3Brush}" CornerRadius="4" Padding="4,1"
                                    BorderBrush="{StaticResource BrandBrush}" BorderThickness="1">
                                <TextBlock Text="{x:Bind ViewModel.FaderLetter, Mode=OneWay}" FontSize="8" FontWeight="Bold"
                                           Foreground="{StaticResource BrandBrush}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <ToggleButton Height="28" Width="36" Padding="0" HorizontalAlignment="Center"
                                  Style="{StaticResource SmoothDangerToggle}" IsThreeState="False"
                                  IsChecked="{x:Bind ViewModel.Muted, Mode=TwoWay}"
                                  ToolTipService.ToolTip="Stream stummschalten">
                        <FontIcon Glyph="{x:Bind MuteGlyph(ViewModel.Muted), Mode=OneWay}" FontSize="11" />
                    </ToggleButton>
                </StackPanel>

                <!-- Subtle vertical divider between Stream and Kopfhörer tracks -->
                <Border Grid.Column="1" Width="1" Background="{StaticResource SurfaceStrokeSubtleBrush}"
                        VerticalAlignment="Stretch" Margin="0,4" />

                <!-- Right Column: Kopfhörer-Mix (Submix) -->
                <StackPanel Grid.Column="2" Spacing="6" HorizontalAlignment="Center">
                    <controls:Fader x:Name="PhonesFader" Width="44" Height="180"
                                    Minimum="{x:Bind ViewModel.MinVolumePercent, Mode=OneWay}"
                                    Maximum="{x:Bind ViewModel.MaxVolumePercent, Mode=OneWay}"
                                    Value="{x:Bind ViewModel.SubmixVolumePercent, Mode=OneWay}"
                                    Accent="{StaticResource HeadphoneBrush}"
                                    MeterLevel="{x:Bind ViewModel.Meter, Mode=OneWay}"
                                    PeakHold="{x:Bind ViewModel.PeakHold, Mode=OneWay}"
                                    IsMetered="{x:Bind ViewModel.Metered, Mode=OneWay}" />
                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.SubmixVolumeLabel, Mode=OneWay}"
                                   FontSize="13" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}" HorizontalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center">
                            <Border Background="{StaticResource SurfaceL3Brush}" CornerRadius="4" Padding="4,1">
                                <TextBlock Text="KOPFHÖRER" FontSize="8" FontWeight="Bold" Foreground="{StaticResource HeadphoneBrush}" />
                            </Border>
                            <Border Visibility="{x:Bind ViewModel.ShowFaderOnPhones, Mode=OneWay}"
                                    Background="{StaticResource SurfaceL3Brush}" CornerRadius="4" Padding="4,1"
                                    BorderBrush="{StaticResource HeadphoneBrush}" BorderThickness="1">
                                <TextBlock Text="{x:Bind ViewModel.FaderLetter, Mode=OneWay}" FontSize="8" FontWeight="Bold"
                                           Foreground="{StaticResource HeadphoneBrush}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <ToggleButton Height="28" Width="36" Padding="0" HorizontalAlignment="Center"
                                  Style="{StaticResource SmoothDangerToggle}" IsThreeState="False"
                                  IsChecked="{x:Bind ViewModel.SubmixMuted, Mode=TwoWay}"
                                  ToolTipService.ToolTip="Kopfhörer stummschalten">
                        <FontIcon Glyph="{x:Bind MuteGlyph(ViewModel.SubmixMuted), Mode=OneWay}" FontSize="11" />
                    </ToggleButton>
                </StackPanel>
            </Grid>

            <!-- Single-Mix Mode OR Fixed Meter Channels -->
            <controls:Fader x:Name="Fader" Grid.Row="2" HorizontalAlignment="Center" Width="60"
                            Visibility="{x:Bind ShowIfSingle(ViewModel.ShowDualMix, ViewModel.IsFixed), Mode=OneWay}"
                            Minimum="{x:Bind ViewModel.MinVolumePercent, Mode=OneWay}"
                            Maximum="{x:Bind ViewModel.MaxVolumePercent, Mode=OneWay}"
                            Value="{x:Bind ViewModel.VolumePercent, Mode=OneWay}"
                            MeterLevel="{x:Bind ViewModel.Meter, Mode=OneWay}"
                            PeakHold="{x:Bind ViewModel.PeakHold, Mode=OneWay}"
                            IsMetered="{x:Bind ViewModel.Metered, Mode=OneWay}"
                            Accent="{x:Bind ViewModel.Accent, Mode=OneWay}" />

            <!-- Row 3: Level readout & dB sub-label (Single-Mix mode) -->
            <StackPanel Grid.Row="3" Spacing="2" Visibility="{x:Bind ShowIfSingle(ViewModel.ShowDualMix, ViewModel.IsFixed), Mode=OneWay}">
                <Grid HorizontalAlignment="Center">
                    <StackPanel x:Name="LevelDisplayPanel" Orientation="Horizontal" HorizontalAlignment="Center"
                                Background="Transparent" CornerRadius="4" Padding="4,1"
                                ToolTipService.ToolTip="{x:Bind EditTooltip(ViewModel.IsFixed), Mode=OneWay}"
                                Tapped="LevelDisplay_Tapped" PointerPressed="LevelDisplay_PointerPressed">
                        <TextBlock Text="{x:Bind LevelText(ViewModel.IsFixed, ViewModel.VolumeLabel, ViewModel.PeakLabel), Mode=OneWay}"
                                   FontSize="20" FontWeight="SemiBold"
                                   FontFamily="{StaticResource DisplayFont}" HorizontalAlignment="Center"
                                   IsHitTestVisible="False" />
                    </StackPanel>
                    <TextBox x:Name="LevelInputBox" Width="60" TextAlignment="Center" FontSize="15" Height="30"
                             Visibility="Collapsed" KeyDown="LevelInputBox_KeyDown" LostFocus="LevelInputBox_LostFocus" />
                </Grid>
                <TextBlock HorizontalAlignment="Center" Style="{StaticResource Caption}" FontSize="11"
                           Text="{x:Bind SubLabel(ViewModel.Muted, ViewModel.RestoreLabel, ViewModel.Metered, ViewModel.PeakLabel, ViewModel.IsFixed), Mode=OneWay}" />
            </StackPanel>

            <!-- Row 4: Smart Mute toggle button (Single-Mix mode) -->
            <ToggleButton Grid.Row="4" Height="32" Width="40" Padding="0" HorizontalAlignment="Center"
                          Style="{StaticResource SmoothDangerToggle}" IsThreeState="False"
                          Visibility="{x:Bind ShowIfSingle(ViewModel.ShowDualMix, ViewModel.IsFixed), Mode=OneWay}"
                          IsChecked="{x:Bind ViewModel.ActiveMuted, Mode=TwoWay}"
                          ToolTipService.ToolTip="{x:Bind ViewModel.ActiveMuteTooltip, Mode=OneWay}"
                          AutomationProperties.Name="{x:Bind MuteName(ViewModel.Name), Mode=OneWay}">
                <FontIcon Glyph="{x:Bind MuteGlyph(ViewModel.ActiveMuted), Mode=OneWay}" FontSize="13" />
            </ToggleButton>
        </Grid>
    </Border>
</UserControl>