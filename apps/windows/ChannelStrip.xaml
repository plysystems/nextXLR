<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NextXLR.ChannelStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NextXLR"
    xmlns:services="using:NextXLR.Services"
    xmlns:controls="using:NextXLR.Controls">

    <!-- Responsive channel strip: Frosted Glass Studio Console Bay -->
    <Border Width="{x:Bind ViewModel.StripWidth, Mode=OneWay}"
            Background="{ThemeResource GlassCardBackgroundBrush}"
            CornerRadius="16" Padding="8,10" MinWidth="86"
            VerticalAlignment="Stretch"
            BorderBrush="{ThemeResource GlassCardBorderBrush}"
            BorderThickness="1"
            Opacity="{x:Bind ViewModel.HiddenStatusOpacity, Mode=OneWay}">
        <Border.ContextFlyout>
            <MenuFlyout>
                <!-- Unity Reset (0-100 / 0 dB) -->
                <MenuFlyoutItem Text="Auf 100 zurücksetzen (Unity)" Click="ResetToUnity_Click">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE73E;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>

                <!-- Dual-Mix actions (ONLY visible in Dual-Mix mode!) -->
                <MenuFlyoutSeparator Visibility="{x:Bind DualMixItemVisibility(ViewModel.ShowDualMix), Mode=OneWay}" />
                <MenuFlyoutItem Text="Kopfhörer auf Stream spiegeln" Click="CopyPhonesToStream_Click"
                                Visibility="{x:Bind DualMixItemVisibility(ViewModel.ShowDualMix), Mode=OneWay}">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8D4;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Stream auf Kopfhörer spiegeln" Click="CopyStreamToPhones_Click"
                                Visibility="{x:Bind DualMixItemVisibility(ViewModel.ShowDualMix), Mode=OneWay}">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8D4;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <ToggleMenuFlyoutItem Text="Koppeln (Link)" IsChecked="{x:Bind ViewModel.IsLinked, Mode=TwoWay}"
                                      Visibility="{x:Bind DualMixItemVisibility(ViewModel.ShowDualMix), Mode=OneWay}">
                    <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE71B;" /></ToggleMenuFlyoutItem.Icon>
                </ToggleMenuFlyoutItem>

                <MenuFlyoutSeparator />
                <!-- Solo (PFL Vorhören) - Only visible on Inputs -->
                <ToggleMenuFlyoutItem Text="Solo (PFL Vorhören)" IsChecked="{x:Bind ViewModel.IsSolo, Mode=TwoWay}"
                                      Visibility="{x:Bind ShowSoloButton(ViewModel.IsOutput), Mode=OneWay}">
                    <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xE767;" /></ToggleMenuFlyoutItem.Icon>
                </ToggleMenuFlyoutItem>

                <!-- Mute -->
                <MenuFlyoutItem Text="{x:Bind MuteMenuText(ViewModel.ActiveMuted), Mode=OneWay}" Click="ToggleMute_Click">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="{x:Bind MuteGlyph(ViewModel.ActiveMuted), Mode=OneWay}" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>

                <!-- Rename / Edit - Only if editable -->
                <MenuFlyoutSeparator Visibility="{x:Bind ViewModel.CanEditVisibility, Mode=OneWay}" />
                <MenuFlyoutItem Text="Kanal anpassen (Name &amp; Icon)..." Click="Edit_Click"
                                Visibility="{x:Bind ViewModel.CanEditVisibility, Mode=OneWay}">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>

                <!-- Hide / Unhide Channel -->
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="{x:Bind HideMenuText(ViewModel.IsUserHidden), Mode=OneWay}" Click="ToggleHideChannel_Click">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="{x:Bind HideMenuGlyph(ViewModel.IsUserHidden), Mode=OneWay}" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Border.ContextFlyout>
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="34" />
                <RowDefinition Height="*" MinHeight="180" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Top Header: Hardware Fader Badge (Left) + Channel Icon (Center) + Solo & Edit Buttons (Right) -->
            <Grid Height="34">
                <!-- Hardware fader letter badge (Left) -->
                <Border CornerRadius="6" Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Background="{ThemeResource SurfaceL3Brush}" BorderBrush="{StaticResource BrandBrush}"
                        BorderThickness="1"
                        Visibility="{x:Bind ShowSingleBadge(ViewModel.HasFader, ViewModel.ShowDualMix), Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.FaderLetter, Mode=OneWay}" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource BrandBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Center Channel Icon Circle with Glass Edge -->
                <Border Width="34" Height="34" CornerRadius="17" HorizontalAlignment="Center" VerticalAlignment="Center"
                        BorderThickness="1" BorderBrush="{ThemeResource GlassCardBorderBrush}"
                        Background="{x:Bind ChannelIconBackground(ViewModel.Accent), Mode=OneWay}">
                    <FontIcon Glyph="{x:Bind ViewModel.Glyph, Mode=OneWay}" FontSize="16"
                              Foreground="{x:Bind ChannelIconForeground(ViewModel.Accent), Mode=OneWay}" />
                </Border>

                <!-- Hidden Indicator Badge (Only shown in 'Alle' tab if marked hidden) -->
                <Border Visibility="{x:Bind ViewModel.HiddenBadgeVisibility, Mode=OneWay}"
                        Background="{ThemeResource SurfaceL3Brush}" CornerRadius="4" Padding="4,1"
                        BorderBrush="{ThemeResource GlassCardBorderBrush}" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-8">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <FontIcon Glyph="&#xE890;" FontSize="8.5" Foreground="{ThemeResource TextMutedBrush}" />
                        <TextBlock Text="Ausgeblendet" FontSize="8" FontWeight="SemiBold" Foreground="{ThemeResource TextMutedBrush}" />
                    </StackPanel>
                </Border>

                <!-- Top Right: Solo (PFL) and Edit Button -->
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Solo (PFL) Button -->
                    <ToggleButton IsChecked="{x:Bind ViewModel.IsSolo, Mode=TwoWay}"
                                  Width="22" Height="22" Padding="0" CornerRadius="5"
                                  BorderThickness="1"
                                  Background="{ThemeResource SurfaceL3Brush}"
                                  BorderBrush="{x:Bind ViewModel.SoloBorderBrush, Mode=OneWay}"
                                  services:CursorHelper.UseHandCursor="True"
                                  Visibility="{x:Bind ShowSoloButton(ViewModel.IsOutput), Mode=OneWay}"
                                  ToolTipService.ToolTip="Solo (PFL) auf Kopfhörern abhören">
                        <TextBlock Text="S" FontSize="9" FontWeight="Bold" Foreground="{x:Bind ViewModel.SoloForeground, Mode=OneWay}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </ToggleButton>

                    <!-- Edit / Rename Button -->
                    <Button x:Name="EditMenuButton" x:Uid="MixerEditButton"
                            Width="22" Height="22" Padding="0" CornerRadius="5"
                            Background="Transparent" BorderThickness="0"
                            services:CursorHelper.UseHandCursor="True"
                            Click="Edit_Click"
                            Visibility="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind ChannelTooltip(ViewModel.CanEdit, ViewModel.Name), Mode=OneWay}">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#22FFFFFF" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#33FFFFFF" />
                        </Button.Resources>
                        <StackPanel Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Ellipse Width="2.5" Height="2.5" Fill="{ThemeResource TextMutedBrush}" />
                            <Ellipse Width="2.5" Height="2.5" Fill="{ThemeResource TextMutedBrush}" />
                            <Ellipse Width="2.5" Height="2.5" Fill="{ThemeResource TextMutedBrush}" />
                        </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="CustomizeFlyout" Placement="Right" Opening="CustomizeFlyout_Opening">
                            <StackPanel Width="320" Spacing="14">
                                <TextBlock x:Uid="MixerCustomizeTitle" Style="{StaticResource CardTitle}" />
                                <TextBox x:Name="LabelBox" x:Uid="MixerLabelBox" MaxLength="24"
                                         KeyDown="LabelBox_KeyDown" />
                                <StackPanel Spacing="8">
                                    <TextBlock x:Uid="MixerIconHeader" Style="{StaticResource Caption}" />
                                    <GridView x:Name="IconGrid" ItemsSource="{x:Bind Icons}" SelectionMode="Single"
                                              IsItemClickEnabled="True" ItemClick="IconGrid_ItemClick"
                                              MaxHeight="260">
                                        <GridView.ItemTemplate>
                                            <DataTemplate x:DataType="local:IconCatalogEntry">
                                                <Border Width="44" Height="40">
                                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" />
                                                </Border>
                                            </DataTemplate>
                                        </GridView.ItemTemplate>
                                    </GridView>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                    <Button x:Uid="MixerResetIcon" Click="ResetIcon_Click" />
                                    <Button x:Uid="MixerSave" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

            <!-- Row 1: Channel Name: 2 lines wrapped so names never truncate -->
            <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" MaxLines="2" />

            <!-- Row 2: Dual-Mix Fader Assembly OR Single Fader Assembly -->
            <!-- Dual-Mix Mode: Kopfhörer-Mix [Default/Links] & Stream-Mix [Rechts] side-by-side stretching full card height -->
            <Grid Grid.Row="2" Grid.RowSpan="3"
                  Visibility="{x:Bind ShowIfDual(ViewModel.ShowDualMix, ViewModel.IsFixed, ViewModel.IsOutput), Mode=OneWay}"
                  ColumnSpacing="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Kopfhörer-Mix (Submix) -->
                <Border CornerRadius="10" Padding="3,6"
                        VerticalAlignment="Stretch"
                        Background="{ThemeResource GlassInnerBayBackground}"
                        BorderBrush="{x:Bind ViewModel.PhonesTrackBorder, Mode=OneWay}"
                        Opacity="{x:Bind ViewModel.PhonesTrackOpacity, Mode=OneWay}"
                        BorderThickness="1">
                    <Grid RowSpacing="6" VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="140" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Tall precision Kopfhörer Fader with meter -->
                        <controls:Fader x:Name="PhonesFader" Width="48"
                                        HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                        Minimum="{x:Bind ViewModel.MinVolumePercent, Mode=OneWay}"
                                        Maximum="{x:Bind ViewModel.MaxVolumePercent, Mode=OneWay}"
                                        Value="{x:Bind ViewModel.SubmixVolumePercent, Mode=OneWay}"
                                        Accent="{StaticResource HeadphoneBrush}"
                                        MeterLevel="{x:Bind ViewModel.Meter, Mode=OneWay}"
                                        PeakHold="{x:Bind ViewModel.PeakHold, Mode=OneWay}"
                                        IsMetered="{x:Bind ViewModel.Metered, Mode=OneWay}" />

                        <!-- Volume 0-100 readout (Click to edit) -->
                        <Grid Grid.Row="1" HorizontalAlignment="Center">
                            <Border Background="{ThemeResource SurfaceL3Brush}" CornerRadius="6" Padding="6,2"
                                    HorizontalAlignment="Center" BorderBrush="{ThemeResource GlassCardBorderBrush}" BorderThickness="1">
                                <StackPanel x:Name="PhonesLevelDisplayPanel" Orientation="Horizontal" HorizontalAlignment="Center"
                                            Background="Transparent" Tapped="PhonesLevelDisplay_Tapped"
                                            services:CursorHelper.UseHandCursor="True">
                                    <TextBlock Text="{x:Bind ViewModel.SubmixVolumeLabel, Mode=OneWay}"
                                               FontSize="12" FontWeight="Bold" FontFamily="{StaticResource MonoFont}"
                                               Foreground="{StaticResource HeadphoneBrush}" HorizontalAlignment="Center"
                                               ToolTipService.ToolTip="{x:Bind ViewModel.SubmixVolumeDbLabel, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                            <TextBox x:Name="PhonesLevelInputBox" Width="46" TextAlignment="Center" FontSize="12" Height="26" Padding="1"
                                     FontFamily="{StaticResource MonoFont}" Visibility="Collapsed"
                                     KeyDown="PhonesLevelInputBox_KeyDown" LostFocus="PhonesLevelInputBox_LostFocus" />
                        </Grid>

                        <!-- Kopfhörer Pill -->
                        <Border Grid.Row="2" Background="{ThemeResource SurfaceL3Brush}" CornerRadius="4" Padding="5,2" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <FontIcon Glyph="&#xE7F6;" FontSize="9" Foreground="{StaticResource HeadphoneBrush}" />
                                <TextBlock Text="PHONES" FontSize="9" FontWeight="Bold" Foreground="{StaticResource HeadphoneBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Kopfhörer Mute Toggle -->
                        <ToggleButton Grid.Row="3" Height="30" Width="38" Padding="0" CornerRadius="7" HorizontalAlignment="Center"
                                      Style="{StaticResource SmoothDangerToggle}" IsThreeState="False"
                                      services:CursorHelper.UseHandCursor="True"
                                      IsChecked="{x:Bind ViewModel.SubmixMuted, Mode=TwoWay}"
                                      ToolTipService.ToolTip="Kopfhörer stummschalten">
                            <FontIcon Glyph="{x:Bind MuteGlyph(ViewModel.SubmixMuted), Mode=OneWay}" FontSize="12" />
                        </ToggleButton>
                    </Grid>
                </Border>

                <!-- Center Column: Vertical divider line & Link (🔗) Toggle Button -->
                <Grid Grid.Column="1" Width="26" VerticalAlignment="Stretch" HorizontalAlignment="Center">
                    <Border Width="1" Background="{ThemeResource GlassCardBorderBrush}"
                            VerticalAlignment="Stretch" HorizontalAlignment="Center" Margin="0,4" />
                    <ToggleButton IsChecked="{x:Bind ViewModel.IsLinked, Mode=TwoWay}"
                                  Width="24" Height="24" Padding="0" CornerRadius="12"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Background="{ThemeResource SurfaceL3Brush}"
                                  BorderBrush="{x:Bind ViewModel.LinkBorderBrush, Mode=OneWay}"
                                  BorderThickness="1" services:CursorHelper.UseHandCursor="True"
                                  ToolTipService.ToolTip="Kopfhörer &amp; Stream-Lautstärke koppeln">
                        <FontIcon Glyph="&#xE71B;" FontSize="10" Foreground="{x:Bind ViewModel.LinkForeground, Mode=OneWay}" />
                    </ToggleButton>
                </Grid>

                <!-- Right Column: Stream-Mix -->
                <Border Grid.Column="2" CornerRadius="10" Padding="3,6"
                        VerticalAlignment="Stretch"
                        Background="{ThemeResource GlassInnerBayBackground}"
                        BorderBrush="{x:Bind ViewModel.StreamTrackBorder, Mode=OneWay}"
                        Opacity="{x:Bind ViewModel.StreamTrackOpacity, Mode=OneWay}"
                        BorderThickness="1">
                    <Grid RowSpacing="6" VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="140" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Tall precision Stream Fader with meter -->
                        <controls:Fader x:Name="StreamFader" Width="48"
                                        HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                        Minimum="{x:Bind ViewModel.MinVolumePercent, Mode=OneWay}"
                                        Maximum="{x:Bind ViewModel.MaxVolumePercent, Mode=OneWay}"
                                        Value="{x:Bind ViewModel.StreamVolumePercent, Mode=OneWay}"
                                        Accent="{x:Bind ViewModel.Accent, Mode=OneWay}"
                                        MeterLevel="{x:Bind ViewModel.Meter, Mode=OneWay}"
                                        PeakHold="{x:Bind ViewModel.PeakHold, Mode=OneWay}"
                                        IsMetered="{x:Bind ViewModel.Metered, Mode=OneWay}" />

                        <!-- Volume 0-100 readout (Click to edit) -->
                        <Grid Grid.Row="1" HorizontalAlignment="Center">
                            <Border Background="{ThemeResource SurfaceL3Brush}" CornerRadius="6" Padding="6,2"
                                    HorizontalAlignment="Center" BorderBrush="{ThemeResource GlassCardBorderBrush}" BorderThickness="1">
                                <StackPanel x:Name="StreamLevelDisplayPanel" Orientation="Horizontal" HorizontalAlignment="Center"
                                            Background="Transparent" Tapped="StreamLevelDisplay_Tapped"
                                            services:CursorHelper.UseHandCursor="True">
                                    <TextBlock Text="{x:Bind ViewModel.StreamVolumeLabel, Mode=OneWay}"
                                               FontSize="12" FontWeight="Bold" FontFamily="{StaticResource MonoFont}"
                                               Foreground="{StaticResource BrandBrush}" HorizontalAlignment="Center"
                                               ToolTipService.ToolTip="{x:Bind ViewModel.StreamVolumeDbLabel, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                            <TextBox x:Name="StreamLevelInputBox" Width="46" TextAlignment="Center" FontSize="12" Height="26" Padding="1"
                                     FontFamily="{StaticResource MonoFont}" Visibility="Collapsed"
                                     KeyDown="StreamLevelInputBox_KeyDown" LostFocus="StreamLevelInputBox_LostFocus" />
                        </Grid>

                        <!-- Stream Pill -->
                        <Border Grid.Row="2" Background="{ThemeResource SurfaceL3Brush}" CornerRadius="4" Padding="5,2" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <FontIcon Glyph="&#xE774;" FontSize="9" Foreground="{StaticResource BrandBrush}" />
                                <TextBlock Text="STREAM" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrandBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Stream Mute Toggle -->
                        <ToggleButton Grid.Row="3" Height="30" Width="38" Padding="0" CornerRadius="7" HorizontalAlignment="Center"
                                      Style="{StaticResource SmoothDangerToggle}" IsThreeState="False"
                                      services:CursorHelper.UseHandCursor="True"
                                      IsChecked="{x:Bind ViewModel.Muted, Mode=TwoWay}"
                                      ToolTipService.ToolTip="Stream stummschalten">
                            <FontIcon Glyph="{x:Bind MuteGlyph(ViewModel.Muted), Mode=OneWay}" FontSize="12" />
                        </ToggleButton>
                    </Grid>
                </Border>
            </Grid>

            <!-- Single-Mix Mode (Kopfhörer or Stream) & Output Channels & Meter Channels:
                 Seamless, recessed glass studio console track bay -->
            <Border Grid.Row="2" Grid.RowSpan="3"
                    Visibility="{x:Bind ShowIfSingle(ViewModel.ShowDualMix, ViewModel.IsFixed, ViewModel.IsOutput), Mode=OneWay}"
                    CornerRadius="12" Padding="4,6" MaxWidth="124"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="{ThemeResource GlassInnerBayBackground}"
                    BorderBrush="{x:Bind ViewModel.SingleTrackBorder, Mode=OneWay}"
                    Opacity="{x:Bind ViewModel.SingleTrackOpacity, Mode=OneWay}"
                    BorderThickness="1">
                <Grid RowSpacing="6" VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="140" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Precision Fader with meter -->
                    <controls:Fader x:Name="Fader" Width="54"
                                    HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                    Minimum="{x:Bind ViewModel.MinVolumePercent, Mode=OneWay}"
                                    Maximum="{x:Bind ViewModel.MaxVolumePercent, Mode=OneWay}"
                                    Value="{x:Bind ViewModel.VolumePercent, Mode=OneWay}"
                                    MeterLevel="{x:Bind ViewModel.Meter, Mode=OneWay}"
                                    PeakHold="{x:Bind ViewModel.PeakHold, Mode=OneWay}"
                                    IsMetered="{x:Bind ViewModel.Metered, Mode=OneWay}"
                                    Accent="{x:Bind SingleFaderAccent(ViewModel.IsSubmixActive, ViewModel.Accent), Mode=OneWay}" />

                    <!-- Row 1: Volume 0-100 readout (Click to edit) -->
                    <Grid Grid.Row="1" HorizontalAlignment="Center">
                        <Border Background="{ThemeResource SurfaceL3Brush}" CornerRadius="6" Padding="8,2"
                                BorderBrush="{ThemeResource GlassCardBorderBrush}" BorderThickness="1">
                            <StackPanel x:Name="LevelDisplayPanel" Orientation="Horizontal" HorizontalAlignment="Center"
                                        Background="Transparent"
                                        ToolTipService.ToolTip="{x:Bind EditTooltip(ViewModel.IsFixed), Mode=OneWay}"
                                        Tapped="LevelDisplay_Tapped" PointerPressed="LevelDisplay_PointerPressed"
                                        services:CursorHelper.UseHandCursor="True">
                                <TextBlock Text="{x:Bind LevelText(ViewModel.IsFixed, ViewModel.VolumeLabel, ViewModel.PeakLabel), Mode=OneWay}"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource BrandBrush}"
                                           FontFamily="{StaticResource MonoFont}" HorizontalAlignment="Center"
                                           IsHitTestVisible="False" />
                            </StackPanel>
                        </Border>
                        <TextBox x:Name="LevelInputBox" Width="52" TextAlignment="Center" FontSize="13" Height="28" Padding="2"
                                 FontFamily="{StaticResource MonoFont}"
                                 Visibility="Collapsed" KeyDown="LevelInputBox_KeyDown" LostFocus="LevelInputBox_LostFocus" />
                    </Grid>

                    <!-- Row 2: Sub-label (dB or Mute restore or Meter-Only) -->
                    <TextBlock Grid.Row="2" HorizontalAlignment="Center" Style="{StaticResource Caption}" FontSize="10"
                               Foreground="{ThemeResource TextMutedBrush}"
                               Text="{x:Bind SubLabel(ViewModel.ActiveMuted, ViewModel.RestoreLabel, ViewModel.Metered, ViewModel.PeakLabel, ViewModel.IsFixed, ViewModel.VolumeDbLabel), Mode=OneWay}" />

                    <!-- Row 3: Smart Mute toggle button -->
                    <ToggleButton Grid.Row="3" Height="32" Width="40" Padding="0" CornerRadius="8" HorizontalAlignment="Center"
                                  Style="{StaticResource SmoothDangerToggle}" IsThreeState="False"
                                  services:CursorHelper.UseHandCursor="True"
                                  IsChecked="{x:Bind ViewModel.ActiveMuted, Mode=TwoWay}"
                                  ToolTipService.ToolTip="{x:Bind ViewModel.ActiveMuteTooltip, Mode=OneWay}"
                                  AutomationProperties.Name="{x:Bind MuteName(ViewModel.Name), Mode=OneWay}">
                        <FontIcon Glyph="{x:Bind MuteGlyph(ViewModel.ActiveMuted), Mode=OneWay}" FontSize="12" />
                    </ToggleButton>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
