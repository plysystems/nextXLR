<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NextXLR.Views.MixerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NextXLR"
    xmlns:vm="using:NextXLR.ViewModels"
    Background="{StaticResource SurfaceL1Brush}">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="20" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: Title and Dual-Mix (Submix) Selector -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock x:Uid="MixerTitle" Style="{StaticResource PageTitle}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <!-- Dual-View Sub-Selector: Choose which mix hardware faders control in Dual mode -->
                <Border Visibility="{x:Bind ViewModel.IsDualMode, Mode=OneWay}"
                        Background="{StaticResource SurfaceL2Brush}" CornerRadius="10"
                        Padding="3" BorderBrush="{StaticResource SurfaceStrokeBrush}" BorderThickness="1"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="5" Margin="8,0,4,0" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8B7;" FontSize="11" Foreground="{StaticResource BrandBrush}" />
                            <TextBlock Text="GoXLR-Fader steuern:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button x:Name="BtnDualPhones" Click="DualTargetPhones_Click"
                                Padding="12,5" CornerRadius="7" BorderThickness="0"
                                Background="{x:Bind DualPhonesBackground(ViewModel.DualFaderTarget), Mode=OneWay}"
                                ToolTipService.ToolTip="Physische GoXLR-Fader steuern Kopfhörer-Lautstärke">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7F6;" FontSize="11" Foreground="{x:Bind DualPhonesForeground(ViewModel.DualFaderTarget), Mode=OneWay}" />
                                <TextBlock Text="Kopfhörer" FontWeight="SemiBold" FontSize="11"
                                           Foreground="{x:Bind DualPhonesForeground(ViewModel.DualFaderTarget), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnDualStream" Click="DualTargetStream_Click"
                                Padding="12,5" CornerRadius="7" BorderThickness="0"
                                Background="{x:Bind DualStreamBackground(ViewModel.DualFaderTarget), Mode=OneWay}"
                                ToolTipService.ToolTip="Physische GoXLR-Fader steuern Stream-Lautstärke">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE774;" FontSize="11" Foreground="{x:Bind DualStreamForeground(ViewModel.DualFaderTarget), Mode=OneWay}" />
                                <TextBlock Text="Stream" FontWeight="SemiBold" FontSize="11"
                                           Foreground="{x:Bind DualStreamForeground(ViewModel.DualFaderTarget), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Mixer Mode Switcher: Kopfhörer [Default], Stream, Dual -->
                <Border Background="{StaticResource SurfaceL2Brush}" CornerRadius="10"
                        Padding="3" BorderBrush="{StaticResource SurfaceStrokeBrush}" BorderThickness="1"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <Button x:Name="BtnHeadphonesMix" Click="HeadphonesMix_Click"
                                Padding="14,5" CornerRadius="7" BorderThickness="0"
                                Background="{x:Bind HeadphonesMixBackground(ViewModel.ActiveMixIndex), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7F6;" FontSize="12" Foreground="{x:Bind HeadphonesMixForeground(ViewModel.ActiveMixIndex), Mode=OneWay}" />
                                <TextBlock Text="Kopfhörer" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{x:Bind HeadphonesMixForeground(ViewModel.ActiveMixIndex), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnStreamMix" Click="StreamMix_Click"
                                Padding="14,5" CornerRadius="7" BorderThickness="0"
                                Background="{x:Bind StreamMixBackground(ViewModel.ActiveMixIndex), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE774;" FontSize="12" Foreground="{x:Bind StreamMixForeground(ViewModel.ActiveMixIndex), Mode=OneWay}" />
                                <TextBlock Text="Stream" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{x:Bind StreamMixForeground(ViewModel.ActiveMixIndex), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnBothMixes" Click="BothMixes_Click"
                                Padding="14,5" CornerRadius="7" BorderThickness="0"
                                Background="{x:Bind BothMixesBackground(ViewModel.ActiveMixIndex), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8D4;" FontSize="12" Foreground="{x:Bind BothMixesForeground(ViewModel.ActiveMixIndex), Mode=OneWay}" />
                                <TextBlock Text="Dual" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{x:Bind BothMixesForeground(ViewModel.ActiveMixIndex), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Hardware faders A–D: sleek unboxed console ribbon -->
        <Border Grid.Row="1" Background="Transparent" Padding="4,2,4,12"
                BorderBrush="{StaticResource SurfaceStrokeSubtleBrush}" BorderThickness="0,0,0,1">
            <StackPanel Spacing="12">
                <!-- Mixer Pages Switcher Bar (Only visible on full GoXLR) -->
                <Grid Visibility="{x:Bind ViewModel.MixerPagesVisibility, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,16,0">
                        <FontIcon Glyph="&#xE8B7;" FontSize="15" Foreground="{StaticResource BrandBrush}" />
                        <TextBlock Text="Mixer-Pages (Fader-Bänke):" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Page 1 & Page 2 Pill Toggle -->
                    <Border Grid.Column="1" HorizontalAlignment="Left"
                            Background="{StaticResource SurfaceL2Brush}" CornerRadius="10"
                            Padding="3" BorderBrush="{StaticResource SurfaceStrokeSubtleBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button x:Name="BtnMixerPage1" Click="MixerPage1_Click"
                                    Padding="14,6" CornerRadius="8" BorderThickness="0"
                                    Background="{x:Bind Page1Background(ViewModel.ActiveMixerPage), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7F6;" FontSize="13" Foreground="{x:Bind Page1Foreground(ViewModel.ActiveMixerPage), Mode=OneWay}" />
                                    <TextBlock Text="Seite 1" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{x:Bind Page1Foreground(ViewModel.ActiveMixerPage), Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnMixerPage2" Click="MixerPage2_Click"
                                    Padding="14,6" CornerRadius="8" BorderThickness="0"
                                    Background="{x:Bind Page2Background(ViewModel.ActiveMixerPage), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7FC;" FontSize="13" Foreground="{x:Bind Page2Foreground(ViewModel.ActiveMixerPage), Mode=OneWay}" />
                                    <TextBlock Text="Seite 2" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{x:Bind Page2Foreground(ViewModel.ActiveMixerPage), Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="FaderAssignTitle" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ItemsRepeater Grid.Column="1" HorizontalAlignment="Left" ItemsSource="{x:Bind ViewModel.FaderSlots}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="180" MinItemHeight="38" MinColumnSpacing="12"
                                               MinRowSpacing="8" MaximumRowsOrColumns="4" ItemsStretch="None" ItemsJustification="Start" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:FaderSlotViewModel">
                                <Grid ColumnSpacing="8" Width="180">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource BrandBrush}">
                                        <TextBlock Text="{x:Bind Letter}" FontWeight="Bold" Foreground="#0E1015"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{x:Bind Options}"
                                              SelectedItem="{x:Bind Selected, Mode=TwoWay}"
                                              AutomationProperties.Name="{x:Bind Letter}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ChannelViewModel">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="14" Foreground="{x:Bind Accent}" />
                                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Grid>
            </StackPanel>
        </Border>

        <!--
          Three sections: Inputs (fader A–D channels first) | Master Controls (Cough + Bleep) | Outputs.
          Always side-by-side on one cohesive studio mixing console desk.
        -->
        <ScrollViewer x:Name="StripScroller" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto" SizeChanged="StripScroller_SizeChanged">
            <Grid x:Name="Sections">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="InCol" Width="Auto" />
                    <ColumnDefinition x:Name="DivCol1" Width="Auto" />
                    <ColumnDefinition x:Name="MidCol" Width="Auto" />
                    <ColumnDefinition x:Name="DivCol2" Width="Auto" />
                    <ColumnDefinition x:Name="OutCol" Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="InputsSection" Spacing="10" HorizontalAlignment="Stretch">
                    <TextBlock x:Uid="MixerInputs" Style="{StaticResource Overline}" Height="18"
                               Foreground="{StaticResource BrandBrush}" FontWeight="Bold" Margin="4,0,0,0" />
                    <ItemsRepeater x:Name="InputsRepeater" ItemsSource="{x:Bind ViewModel.InputStrips}"
                                   HorizontalAlignment="Stretch"
                                   ElementPrepared="InputsRepeater_ElementPrepared">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout x:Name="InLayout" MinItemWidth="84" MinItemHeight="440"
                                               MinColumnSpacing="8" MinRowSpacing="0" MaximumRowsOrColumns="8"
                                               ItemsStretch="Fill" ItemsJustification="Start" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChannelViewModel">
                                <local:ChannelStrip ViewModel="{x:Bind}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!-- Divider between Inputs and Master Controls -->
                <Rectangle x:Name="DivCol1Rect" Grid.Column="1" Width="1" VerticalAlignment="Stretch"
                           Fill="{StaticResource SurfaceStrokeSubtleBrush}" Margin="12,28,12,8" />

                <!-- Global mic mute (cough button) and censor: master controls section (Headline hidden) -->
                <Grid x:Name="BleepSection" Grid.Column="2" RowSpacing="10" Margin="4,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="18" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- Empty 18px spacer keeps controls aligned with channel strips without showing headline -->
                    <Border Height="18" />
                    <Border x:Name="BleepCard" Grid.Row="1" Background="{StaticResource SurfaceL2Brush}" CornerRadius="12"
                            BorderBrush="{StaticResource SurfaceStrokeSubtleBrush}" BorderThickness="1"
                            Padding="12,16">
                        <StackPanel x:Name="BleepButtons" Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ToggleButton x:Uid="MicMuteButton" Width="72" Height="72" CornerRadius="36"
                                          Style="{StaticResource SmoothDangerToggle}"
                                          IsChecked="{x:Bind ViewModel.MicMuted, Mode=TwoWay}">
                                <FontIcon Glyph="{x:Bind MicGlyph(ViewModel.MicMuted), Mode=OneWay}" FontSize="26" />
                            </ToggleButton>
                            <ToggleButton x:Name="BleepButton" x:Uid="BleepButton" Width="72" Height="72" CornerRadius="16"
                                          Style="{StaticResource SmoothDangerToggle}" IsThreeState="False"
                                          IsChecked="{x:Bind ViewModel.BleepActive, Mode=OneWay}">
                                <TextBlock Text="!@#$?*" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"
                                           FontFamily="{StaticResource DisplayFont}" />
                            </ToggleButton>

                            <!-- Bleep volume slider (0-100%) -->
                            <StackPanel Spacing="3" HorizontalAlignment="Center" Margin="0,4,0,0">
                                <TextBlock Text="Bleep" Style="{StaticResource Caption}" HorizontalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}" />
                                <Slider x:Name="BleepSlider" Minimum="0" Maximum="100" StepFrequency="1"
                                        Width="72" HorizontalAlignment="Center"
                                        Value="{x:Bind ViewModel.BleepVolume, Mode=TwoWay}"
                                        AutomationProperties.Name="Bleep Lautstärke" />
                                <TextBlock Text="{x:Bind ViewModel.BleepVolumeText, Mode=OneWay}"
                                           FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           FontFamily="{StaticResource DisplayFont}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Divider between Master Controls and Outputs -->
                <Rectangle x:Name="DivCol2Rect" Grid.Column="3" Width="1" VerticalAlignment="Stretch"
                           Fill="{StaticResource SurfaceStrokeSubtleBrush}" Margin="12,28,12,8" />

                <StackPanel x:Name="OutputsSection" Grid.Column="4" Spacing="10" HorizontalAlignment="Stretch">
                    <TextBlock x:Uid="MixerOutputs" Style="{StaticResource Overline}" Height="18"
                               Foreground="{StaticResource HeadphoneBrush}" FontWeight="Bold" Margin="4,0,0,0" />
                    <ItemsRepeater x:Name="OutputsRepeater" ItemsSource="{x:Bind ViewModel.OutputStrips}"
                                   HorizontalAlignment="Stretch"
                                   ElementPrepared="OutputsRepeater_ElementPrepared">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout x:Name="OutLayout" MinItemWidth="84" MinItemHeight="440"
                                               MinColumnSpacing="8" MinRowSpacing="0" MaximumRowsOrColumns="5"
                                               ItemsStretch="Fill" ItemsJustification="Start" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChannelViewModel">
                                <local:ChannelStrip ViewModel="{x:Bind}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
