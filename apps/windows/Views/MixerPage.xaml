<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NextXLR.Views.MixerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NextXLR"
    xmlns:vm="using:NextXLR.ViewModels"
    xmlns:services="using:NextXLR.Services"
    Background="Transparent">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="20" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Dedicated HUD Cockpit Bar (Only visible in HUD mode) -->
        <Border Grid.Row="0" Visibility="{x:Bind HudModeVisibility(ViewModel.IsHudMode), Mode=OneWay}"
                Background="{ThemeResource GlassCardBackgroundBrush}" CornerRadius="12"
                Padding="12,6" BorderBrush="{ThemeResource GlassCardBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: HUD Indicator -->
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource BrandBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="NEXT : XLR • HUD" FontWeight="Bold" FontSize="13"
                               FontFamily="{StaticResource DisplayFont}" Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center" />
                    <Border Background="{ThemeResource SurfaceL3Brush}" CornerRadius="6" Padding="6,2">
                        <TextBlock Text="Always-on-Top" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextMutedBrush}" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>

                <!-- Center: Quick Controls (Mix Switcher + Husten + Filter) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Compact Mix Switcher -->
                    <Border Background="{ThemeResource SurfaceL3Brush}" CornerRadius="8" Padding="2" BorderThickness="1" BorderBrush="{ThemeResource GlassCardBorderBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Click="HeadphonesMix_Click" Padding="10,4" CornerRadius="6" BorderThickness="0"
                                    services:CursorHelper.UseHandCursor="True"
                                    Background="{x:Bind HeadphonesMixBackground(ViewModel.ActiveMixIndex), Mode=OneWay}"
                                    ToolTipService.ToolTip="Kopfhörer-Mix">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE7F6;" FontSize="11" Foreground="{x:Bind HeadphonesMixForeground(ViewModel.ActiveMixIndex), Mode=OneWay}" />
                                    <TextBlock Text="Kopfhörer" FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind HeadphonesMixForeground(ViewModel.ActiveMixIndex), Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                            <Button Click="StreamMix_Click" Padding="10,4" CornerRadius="6" BorderThickness="0"
                                    services:CursorHelper.UseHandCursor="True"
                                    Background="{x:Bind StreamMixBackground(ViewModel.ActiveMixIndex), Mode=OneWay}"
                                    ToolTipService.ToolTip="Stream-Mix">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE774;" FontSize="11" Foreground="{x:Bind StreamMixForeground(ViewModel.ActiveMixIndex), Mode=OneWay}" />
                                    <TextBlock Text="Stream" FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind StreamMixForeground(ViewModel.ActiveMixIndex), Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                            <Button Click="BothMixes_Click" Padding="10,4" CornerRadius="6" BorderThickness="0"
                                    services:CursorHelper.UseHandCursor="True"
                                    Background="{x:Bind BothMixesBackground(ViewModel.ActiveMixIndex), Mode=OneWay}"
                                    ToolTipService.ToolTip="Dual-Mix">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE8D4;" FontSize="11" Foreground="{x:Bind BothMixesForeground(ViewModel.ActiveMixIndex), Mode=OneWay}" />
                                    <TextBlock Text="Dual" FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind BothMixesForeground(ViewModel.ActiveMixIndex), Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Quick Mic Mute Toggle -->
                    <ToggleButton Width="36" Height="30" Padding="0" CornerRadius="8"
                                  Style="{StaticResource SmoothDangerToggle}"
                                  services:CursorHelper.UseHandCursor="True"
                                  IsChecked="{x:Bind ViewModel.MicMuted, Mode=TwoWay}"
                                  ToolTipService.ToolTip="Mikrofon stummschalten (Husten-Taste)">
                        <FontIcon Glyph="{x:Bind MicGlyph(ViewModel.MicMuted), Mode=OneWay}" FontSize="13" />
                    </ToggleButton>

                    <!-- Filter Switcher in HUD -->
                    <Border Background="{ThemeResource SurfaceL3Brush}" CornerRadius="8" Padding="2" BorderThickness="1" BorderBrush="{ThemeResource GlassCardBorderBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Click="FilterAll_Click" Padding="8,4" CornerRadius="6" BorderThickness="0"
                                    services:CursorHelper.UseHandCursor="True"
                                    Background="{x:Bind FilterAllBackground(ViewModel.OnlyActiveChannels), Mode=OneWay}">
                                <TextBlock Text="Alle" FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind FilterAllForeground(ViewModel.OnlyActiveChannels), Mode=OneWay}" />
                            </Button>
                            <Button Click="FilterActive_Click" Padding="8,4" CornerRadius="6" BorderThickness="0"
                                    services:CursorHelper.UseHandCursor="True"
                                    Background="{x:Bind FilterActiveBackground(ViewModel.OnlyActiveChannels), Mode=OneWay}">
                                <TextBlock Text="Nur aktive" FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind FilterActiveForeground(ViewModel.OnlyActiveChannels), Mode=OneWay}" />
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: Exit HUD Button -->
                <Button Grid.Column="2" Click="ToggleHud_Click"
                        Padding="12,5" CornerRadius="8" BorderThickness="1"
                        Background="{ThemeResource SurfaceL3Brush}"
                        BorderBrush="{StaticResource BrandBrush}"
                        services:CursorHelper.UseHandCursor="True"
                        ToolTipService.ToolTip="HUD-Modus beenden und zur Normalansicht zurückkehren">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{StaticResource BrandBrush}" />
                        <TextBlock Text="HUD beenden" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrandBrush}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Header: Title and Dual-Mix (Submix) Selector (Normal Mode) -->
        <Grid Grid.Row="0" Visibility="{x:Bind HudModeInvertedVisibility(ViewModel.IsHudMode), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock x:Uid="MixerTitle" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
                <TextBlock Text="4 physische Fader, Submix-Routing für Kopfhörer &amp; Stream sowie Echtzeit-Pegelanzeigen."
                           Style="{StaticResource Caption}" Foreground="{ThemeResource TextMutedBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <!-- Dual-View Sub-Selector: Choose which mix hardware faders control in Dual mode -->
                <Border Visibility="{x:Bind ViewModel.IsDualMode, Mode=OneWay}"
                        Background="{ThemeResource GlassCardBackgroundBrush}" CornerRadius="10"
                        Padding="3" BorderBrush="{ThemeResource GlassCardBorderBrush}" BorderThickness="1"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="5" Margin="8,0,4,0" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8B7;" FontSize="11" Foreground="{StaticResource BrandBrush}" />
                            <TextBlock Text="GoXLR-Fader steuern:" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button x:Name="BtnDualPhones" Click="DualTargetPhones_Click"
                                Padding="12,5" CornerRadius="7" BorderThickness="0"
                                services:CursorHelper.UseHandCursor="True"
                                Background="{x:Bind DualPhonesBackground(ViewModel.DualFaderTarget), Mode=OneWay}"
                                ToolTipService.ToolTip="Physische GoXLR-Fader steuern Kopfhörer-Lautstärke">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7F6;" FontSize="11" Foreground="{x:Bind DualPhonesForeground(ViewModel.DualFaderTarget), Mode=OneWay}" />
                                <TextBlock Text="Kopfhörer" FontWeight="SemiBold" FontSize="11"
                                           Foreground="{x:Bind DualPhonesForeground(ViewModel.DualFaderTarget), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnDualStream" Click="DualTargetStream_Click"
                                Padding="12,5" CornerRadius="7" BorderThickness="0"
                                services:CursorHelper.UseHandCursor="True"
                                Background="{x:Bind DualStreamBackground(ViewModel.DualFaderTarget), Mode=OneWay}"
                                ToolTipService.ToolTip="Physische GoXLR-Fader steuern Stream-Lautstärke">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE774;" FontSize="11" Foreground="{x:Bind DualStreamForeground(ViewModel.DualFaderTarget), Mode=OneWay}" />
                                <TextBlock Text="Stream" FontWeight="SemiBold" FontSize="11"
                                           Foreground="{x:Bind DualStreamForeground(ViewModel.DualFaderTarget), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Mixer Mode Switcher: Kopfhörer [Default], Stream, Dual -->
                <Border Background="{ThemeResource GlassCardBackgroundBrush}" CornerRadius="10"
                        Padding="3" BorderBrush="{ThemeResource GlassCardBorderBrush}" BorderThickness="1"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <Button x:Name="BtnHeadphonesMix" Click="HeadphonesMix_Click"
                                Padding="14,5" CornerRadius="7" BorderThickness="0"
                                services:CursorHelper.UseHandCursor="True"
                                Background="{x:Bind HeadphonesMixBackground(ViewModel.ActiveMixIndex), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7F6;" FontSize="12" Foreground="{x:Bind HeadphonesMixForeground(ViewModel.ActiveMixIndex), Mode=OneWay}" />
                                <TextBlock Text="Kopfhörer" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{x:Bind HeadphonesMixForeground(ViewModel.ActiveMixIndex), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnStreamMix" Click="StreamMix_Click"
                                Padding="14,5" CornerRadius="7" BorderThickness="0"
                                services:CursorHelper.UseHandCursor="True"
                                Background="{x:Bind StreamMixBackground(ViewModel.ActiveMixIndex), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE774;" FontSize="12" Foreground="{x:Bind StreamMixForeground(ViewModel.ActiveMixIndex), Mode=OneWay}" />
                                <TextBlock Text="Stream" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{x:Bind StreamMixForeground(ViewModel.ActiveMixIndex), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnBothMixes" Click="BothMixes_Click"
                                Padding="14,5" CornerRadius="7" BorderThickness="0"
                                services:CursorHelper.UseHandCursor="True"
                                Background="{x:Bind BothMixesBackground(ViewModel.ActiveMixIndex), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8D4;" FontSize="12" Foreground="{x:Bind BothMixesForeground(ViewModel.ActiveMixIndex), Mode=OneWay}" />
                                <TextBlock Text="Dual" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{x:Bind BothMixesForeground(ViewModel.ActiveMixIndex), Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Channel Filter: Alle vs Nur aktive Kanäle -->
                <Border Background="{ThemeResource GlassCardBackgroundBrush}" CornerRadius="10"
                        Padding="3" BorderBrush="{ThemeResource GlassCardBorderBrush}" BorderThickness="1"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button x:Name="BtnFilterAll" Click="FilterAll_Click"
                                Padding="10,5" CornerRadius="7" BorderThickness="0"
                                services:CursorHelper.UseHandCursor="True"
                                Background="{x:Bind FilterAllBackground(ViewModel.OnlyActiveChannels), Mode=OneWay}"
                                ToolTipService.ToolTip="Alle konfigurierten Kanäle anzeigen">
                            <TextBlock Text="Alle" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{x:Bind FilterAllForeground(ViewModel.OnlyActiveChannels), Mode=OneWay}" />
                        </Button>
                        <Button x:Name="BtnFilterActive" Click="FilterActive_Click"
                                Padding="10,5" CornerRadius="7" BorderThickness="0"
                                services:CursorHelper.UseHandCursor="True"
                                Background="{x:Bind FilterActiveBackground(ViewModel.OnlyActiveChannels), Mode=OneWay}"
                                ToolTipService.ToolTip="Ungenutzte Kanäle ohne Signal oder Zuweisung ausblenden">
                            <TextBlock Text="Nur aktive" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{x:Bind FilterActiveForeground(ViewModel.OnlyActiveChannels), Mode=OneWay}" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Alle einblenden Button (Nur sichtbar wenn Kanäle ausgeblendet sind) -->
                <Button x:Name="BtnUnhideAll" Click="UnhideAll_Click"
                        Padding="10,5" CornerRadius="10" BorderThickness="1"
                        services:CursorHelper.UseHandCursor="True"
                        Background="{ThemeResource SurfaceL3Brush}"
                        BorderBrush="{StaticResource BrandBrush}"
                        Visibility="{x:Bind UnhideButtonVisibility(ViewModel.HasHiddenChannels), Mode=OneWay}"
                        ToolTipService.ToolTip="Alle ausgeblendeten Kanäle wieder anzeigen">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xE7B3;" FontSize="11" Foreground="{StaticResource BrandBrush}" />
                        <TextBlock Text="Alle einblenden" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrandBrush}" />
                    </StackPanel>
                </Button>

                <!-- Mini-HUD Button (Kompaktansicht für Zocken & Streamen) -->
                <Button x:Name="BtnToggleHud" Click="ToggleHud_Click"
                        Padding="11,5" CornerRadius="10" BorderThickness="1"
                        services:CursorHelper.UseHandCursor="True"
                        Background="{ThemeResource GlassCardBackgroundBrush}"
                        BorderBrush="{ThemeResource GlassCardBorderBrush}"
                        ToolTipService.ToolTip="Mini-HUD: Kompaktes Floating-Cockpit über anderen Fenstern">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE737;" FontSize="12" Foreground="{StaticResource BrandBrush}" />
                        <TextBlock Text="HUD" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource BrandBrush}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Hardware faders A–D: sleek unboxed console ribbon (Normal Mode) -->
        <Border Grid.Row="1" Background="Transparent" Padding="4,0,4,8"
                BorderBrush="{ThemeResource GlassCardBorderBrush}" BorderThickness="0,0,0,1"
                Visibility="{x:Bind HudModeInvertedVisibility(ViewModel.IsHudMode), Mode=OneWay}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Hardware Fader Assignment Ribbon (A - D) -->
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock x:Uid="FaderAssignTitle" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.FaderSlots}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:FaderSlotViewModel">
                                <Grid ColumnSpacing="6" Width="160">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="26" Height="26" CornerRadius="6" Background="{ThemeResource SurfaceL3Brush}"
                                            BorderBrush="{StaticResource BrandBrush}" BorderThickness="1">
                                        <TextBlock Text="{x:Bind Letter}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource BrandBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{x:Bind Options}"
                                              SelectedItem="{x:Bind Selected, Mode=TwoWay}"
                                              AutomationProperties.Name="{x:Bind Letter}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ChannelViewModel">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="12" Foreground="{x:Bind Accent}" />
                                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="12" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!-- Right: Studio Utilities (Mixer Pages + Mic Mute / Bleep + Zensur Slider) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Mixer Pages Switcher Bar (Only visible on full GoXLR) -->
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                Visibility="{x:Bind ViewModel.MixerPagesVisibility, Mode=OneWay}">
                        <FontIcon Glyph="&#xE8B7;" FontSize="12" Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Mixer-Pages:" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                        <!-- Page 1 &amp; Page 2 Pill Toggle -->
                        <Border Background="{ThemeResource GlassCardBackgroundBrush}" CornerRadius="8"
                                Padding="2" BorderBrush="{ThemeResource GlassCardBorderBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button x:Name="BtnMixerPage1" Click="MixerPage1_Click"
                                        Padding="10,4" CornerRadius="6" BorderThickness="0"
                                        services:CursorHelper.UseHandCursor="True"
                                        Background="{x:Bind Page1Background(ViewModel.ActiveMixerPage), Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE7F6;" FontSize="10" Foreground="{x:Bind Page1Foreground(ViewModel.ActiveMixerPage), Mode=OneWay}" />
                                        <TextBlock Text="Seite 1" FontWeight="SemiBold" FontSize="11"
                                                   Foreground="{x:Bind Page1Foreground(ViewModel.ActiveMixerPage), Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnMixerPage2" Click="MixerPage2_Click"
                                        Padding="10,4" CornerRadius="6" BorderThickness="0"
                                        services:CursorHelper.UseHandCursor="True"
                                        Background="{x:Bind Page2Background(ViewModel.ActiveMixerPage), Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE7FC;" FontSize="10" Foreground="{x:Bind Page2Foreground(ViewModel.ActiveMixerPage), Mode=OneWay}" />
                                        <TextBlock Text="Seite 2" FontWeight="SemiBold" FontSize="11"
                                                   Foreground="{x:Bind Page2Foreground(ViewModel.ActiveMixerPage), Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Master Live Controls: Segmented Buttongroup [ Mic_ICON | !@#$?* ] -->
                    <Border Background="{ThemeResource GlassCardBackgroundBrush}" CornerRadius="10"
                            Padding="2" BorderBrush="{ThemeResource GlassCardBorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="0">
                            <!-- Mic Mute (Husten) Button -->
                            <ToggleButton x:Uid="MicMuteButton" Width="42" Height="32" Padding="0" CornerRadius="8,0,0,8"
                                          BorderThickness="0" Style="{StaticResource SmoothDangerToggle}"
                                          services:CursorHelper.UseHandCursor="True"
                                          IsChecked="{x:Bind ViewModel.MicMuted, Mode=TwoWay}"
                                          ToolTipService.ToolTip="Mikrofon stummschalten (Husten-Taste)">
                                <FontIcon Glyph="{x:Bind MicGlyph(ViewModel.MicMuted), Mode=OneWay}" FontSize="14" />
                            </ToggleButton>

                            <!-- Subtle 1px Divider -->
                            <Border Width="1" Height="20" Background="{ThemeResource GlassCardBorderBrush}" VerticalAlignment="Center" />

                            <!-- Bleep Button -->
                            <ToggleButton x:Name="BleepButton" x:Uid="BleepButton" Width="54" Height="32" Padding="0" CornerRadius="0,8,8,0"
                                          BorderThickness="0" Style="{StaticResource SmoothDangerToggle}" IsThreeState="False"
                                          services:CursorHelper.UseHandCursor="True"
                                          IsChecked="{x:Bind ViewModel.BleepActive, Mode=OneWay}"
                                          ToolTipService.ToolTip="Zensurton (Halten)">
                                <TextBlock Text="!@#$?*" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </ToggleButton>
                        </StackPanel>
                    </Border>

                    <!-- Zensur-Karte (Pegel) -->
                    <Border Background="{ThemeResource GlassCardBackgroundBrush}" CornerRadius="10"
                            Height="36" Padding="10,0" BorderBrush="{ThemeResource GlassCardBorderBrush}" BorderThickness="1"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Zensur:" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextMutedBrush}" VerticalAlignment="Center" />
                            <Slider x:Name="BleepSlider" Minimum="0" Maximum="100" StepFrequency="1"
                                    Width="90" Height="32" VerticalAlignment="Center"
                                    Value="{x:Bind ViewModel.BleepVolume, Mode=TwoWay}"
                                    AutomationProperties.Name="Zensur Lautstärke" />
                            <TextBlock Text="{x:Bind ViewModel.BleepVolumeText, Mode=OneWay}"
                                       FontSize="11" FontWeight="Bold" Width="44" VerticalAlignment="Center"
                                       Foreground="{StaticResource BrandBrush}" FontFamily="{StaticResource MonoFont}"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.BleepVolumePercentText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>


        <!--
          Three sections: Inputs (fader A–D channels first) | Master Controls (Cough + Bleep) | Outputs.
          Always side-by-side on one cohesive studio mixing console desk.
        -->
        <ScrollViewer x:Name="StripScroller" Grid.Row="2" VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollBarVisibility="Auto" SizeChanged="StripScroller_SizeChanged">
            <Grid x:Name="Sections">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="InCol" Width="Auto" />
                    <ColumnDefinition x:Name="DivCol1" Width="Auto" />
                    <ColumnDefinition x:Name="OutCol" Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Inputs Section (Strict single horizontal row, 8 Faders nebeneinander) -->
                <Grid x:Name="InputsSection" RowSpacing="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="18" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Uid="MixerInputs" Style="{StaticResource Overline}" Height="18"
                               Foreground="{StaticResource BrandBrush}" FontWeight="Bold" Margin="4,0,0,0" />
                    <ItemsRepeater x:Name="InputsRepeater" Grid.Row="1" ItemsSource="{x:Bind ViewModel.InputStrips}"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                   ElementPrepared="InputsRepeater_ElementPrepared">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChannelViewModel">
                                <local:ChannelStrip ViewModel="{x:Bind}" VerticalAlignment="Stretch" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Grid>

                <!-- Divider between Inputs and Outputs -->
                <Rectangle x:Name="DivCol1Rect" Grid.Column="1" Width="1" VerticalAlignment="Stretch"
                           Fill="{ThemeResource GlassCardBorderBrush}" Margin="12,28,12,8" />

                <!-- Outputs Section (Strict single horizontal row, 5 Faders nebeneinander) -->
                <Grid x:Name="OutputsSection" Grid.Column="2" RowSpacing="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="18" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Uid="MixerOutputs" Style="{StaticResource Overline}" Height="18"
                               Foreground="{StaticResource HeadphoneBrush}" FontWeight="Bold" Margin="4,0,0,0" />
                    <ItemsRepeater x:Name="OutputsRepeater" Grid.Row="1" ItemsSource="{x:Bind ViewModel.OutputStrips}"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                   ElementPrepared="OutputsRepeater_ElementPrepared">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChannelViewModel">
                                <local:ChannelStrip ViewModel="{x:Bind}" VerticalAlignment="Stretch" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
