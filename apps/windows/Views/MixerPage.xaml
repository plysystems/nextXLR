<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NextXLR.Views.MixerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NextXLR"
    xmlns:vm="using:NextXLR.ViewModels"
    Background="Transparent">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="24" MaxWidth="1500" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: Title and Dual-Mix (Submix) Selector -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock x:Uid="MixerTitle" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{x:Bind ViewModel.MixModeDescription, Mode=OneWay}"
                           Style="{StaticResource Caption}" Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>

            <!-- Dual-Mix Selector -->
            <Border Grid.Column="1" Background="{StaticResource SurfaceL2Brush}" CornerRadius="12"
                    Padding="4" BorderBrush="{StaticResource SurfaceStrokeSubtleBrush}" BorderThickness="1"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button x:Name="BtnStreamMix" Click="StreamMix_Click"
                            Padding="14,8" CornerRadius="8" BorderThickness="0"
                            Background="{x:Bind StreamMixBackground(ViewModel.IsSubmixActive), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE774;" FontSize="14" Foreground="{x:Bind StreamMixForeground(ViewModel.IsSubmixActive), Mode=OneWay}" />
                            <TextBlock Text="🌐 Stream-Mix" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{x:Bind StreamMixForeground(ViewModel.IsSubmixActive), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnHeadphonesMix" Click="HeadphonesMix_Click"
                            Padding="14,8" CornerRadius="8" BorderThickness="0"
                            Background="{x:Bind HeadphonesMixBackground(ViewModel.IsSubmixActive), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7F6;" FontSize="14" Foreground="{x:Bind HeadphonesMixForeground(ViewModel.IsSubmixActive), Mode=OneWay}" />
                            <TextBlock Text="🎧 Kopfhörer-Mix" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{x:Bind HeadphonesMixForeground(ViewModel.IsSubmixActive), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Hardware faders A–D: which channel each physical fader controls -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Uid="FaderAssignTitle" FontWeight="SemiBold" VerticalAlignment="Center" />
                <ItemsRepeater Grid.Column="1" ItemsSource="{x:Bind ViewModel.FaderSlots}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="150" MinItemHeight="40" MinColumnSpacing="10"
                                           MinRowSpacing="8" MaximumRowsOrColumns="4" ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:FaderSlotViewModel">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource BrandBrush}">
                                    <TextBlock Text="{x:Bind Letter}" FontWeight="Bold" Foreground="#0E1015"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{x:Bind Options}"
                                          SelectedItem="{x:Bind Selected, Mode=TwoWay}"
                                          AutomationProperties.Name="{x:Bind Letter}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ChannelViewModel">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="14" Foreground="{x:Bind Accent}" />
                                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Grid>
        </Border>

        <!--
          Three sections: Inputs (fader A–D channels first) | mic mute + censor | Outputs.
          Wide windows: one row, strips share the width equally and fill the height.
          Narrow windows: the sections stack and wrap, and the page scrolls (MixerPage.Layout).
        -->
        <ScrollViewer x:Name="StripScroller" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" SizeChanged="StripScroller_SizeChanged">
            <Grid x:Name="Sections">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="InCol" Width="*" />
                    <ColumnDefinition x:Name="MidCol" Width="Auto" />
                    <ColumnDefinition x:Name="OutCol" Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="InputsSection" Spacing="10">
                    <TextBlock x:Uid="MixerInputs" Style="{StaticResource Overline}" Height="18" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.InputStrips}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout x:Name="InLayout" MinItemWidth="84" MinItemHeight="440"
                                               MinColumnSpacing="8" MinRowSpacing="8"
                                               ItemsStretch="Fill" ItemsJustification="Start" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChannelViewModel">
                                <local:ChannelStrip ViewModel="{x:Bind}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!-- Global mic mute (cough button) and censor: icon / symbols only -->
                <Grid x:Name="BleepSection" Grid.Column="1" RowSpacing="10" Margin="14,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="18" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border x:Name="BleepCard" Grid.Row="1" Style="{StaticResource Card}" Padding="12,16">
                        <StackPanel x:Name="BleepButtons" Spacing="14" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ToggleButton x:Uid="MicMuteButton" Width="80" Height="80" CornerRadius="40"
                                          Style="{StaticResource SmoothDangerToggle}"
                                          IsChecked="{x:Bind ViewModel.MicMuted, Mode=TwoWay}">
                                <FontIcon Glyph="{x:Bind MicGlyph(ViewModel.MicMuted), Mode=OneWay}" FontSize="28" />
                            </ToggleButton>
                            <ToggleButton x:Name="BleepButton" x:Uid="BleepButton" Width="80" Height="80" CornerRadius="16"
                                          Style="{StaticResource SmoothDangerToggle}" IsThreeState="False"
                                          IsChecked="{x:Bind ViewModel.BleepActive, Mode=OneWay}">
                                <TextBlock Text="!@#$?*" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center"
                                           FontFamily="{StaticResource DisplayFont}" />
                            </ToggleButton>

                            <!-- Bleep volume slider (0-100%) -->
                            <StackPanel Spacing="3" HorizontalAlignment="Center" Margin="0,4,0,0">
                                <TextBlock Text="Bleep" Style="{StaticResource Caption}" HorizontalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}" />
                                <Slider x:Name="BleepSlider" Minimum="0" Maximum="100" StepFrequency="1"
                                        Width="80" HorizontalAlignment="Center"
                                        Value="{x:Bind ViewModel.BleepVolume, Mode=TwoWay}"
                                        AutomationProperties.Name="Bleep Lautstärke" />
                                <TextBlock Text="{x:Bind ViewModel.BleepVolumeText, Mode=OneWay}"
                                           FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           FontFamily="{StaticResource DisplayFont}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel x:Name="OutputsSection" Grid.Column="2" Spacing="10">
                    <TextBlock x:Uid="MixerOutputs" Style="{StaticResource Overline}" Height="18" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.OutputStrips}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout x:Name="OutLayout" MinItemWidth="84" MinItemHeight="440"
                                               MinColumnSpacing="8" MinRowSpacing="8"
                                               ItemsStretch="Fill" ItemsJustification="Start" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChannelViewModel">
                                <local:ChannelStrip ViewModel="{x:Bind}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
