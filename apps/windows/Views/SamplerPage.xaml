<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NextXLR.Views.SamplerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NextXLR"
    xmlns:vm="using:NextXLR.ViewModels"
    xmlns:controls="using:NextXLR.Controls"
    Background="{ThemeResource SurfaceL1Brush}">

    <ScrollViewer Style="{StaticResource PageScroller}">
        <Grid x:Name="Root" ColumnSpacing="20" RowSpacing="20" MaxWidth="1500" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="BrowserCol" Width="400" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Wide">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1280" /></VisualState.StateTriggers>
                    </VisualState>
                    <VisualState x:Name="Narrow">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="BrowserCol.Width" Value="0" />
                            <Setter Target="Root.ColumnSpacing" Value="0" />
                            <Setter Target="BrowserCard.(Grid.Column)" Value="0" />
                            <Setter Target="BrowserCard.(Grid.Row)" Value="2" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <TextBlock x:Uid="SamplerTitle" Grid.ColumnSpan="2" Style="{StaticResource PageTitle}" />

            <!-- ===== Left: pages + pads (hardware layout) and the selected pad's settings ===== -->
            <StackPanel Grid.Row="1" Spacing="20">
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="18">
                        <!-- Pages A / B / C -->
                        <StackPanel Spacing="10">
                            <TextBlock x:Uid="SamplerPagesHeader" Style="{StaticResource Overline}" />
                            <ItemsRepeater ItemsSource="{x:Bind Sampler.Pages}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinItemWidth="120" MinItemHeight="48" MinColumnSpacing="10"
                                                       MaximumRowsOrColumns="3" ItemsStretch="Fill" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PageViewModel">
                                        <ToggleButton Style="{StaticResource TileToggle}" IsChecked="{x:Bind IsActive, Mode=TwoWay}"
                                                      Content="{x:Bind Label}" FontSize="15" FontWeight="SemiBold" />
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>

                        <!--
                          Pads 1–4 in a 2×2 grid; Clear sits exactly in the centre, over the inner
                          corners of all four pads (hardware-accurate). Its ring has the card colour,
                          so it looks set into the pads.
                        -->
                        <Grid x:Name="PadGrid" Height="380" MaxWidth="760" HorizontalAlignment="Stretch"
                              ColumnSpacing="14" RowSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <local:PadTile ViewModel="{x:Bind Sampler.Pads[0]}" />
                            <local:PadTile Grid.Column="1" Mirror="True" ViewModel="{x:Bind Sampler.Pads[1]}" />
                            <local:PadTile Grid.Row="1" ViewModel="{x:Bind Sampler.Pads[2]}" />
                            <local:PadTile Grid.Row="1" Grid.Column="1" Mirror="True" ViewModel="{x:Bind Sampler.Pads[3]}" />

                            <Border Grid.RowSpan="2" Grid.ColumnSpan="2" Width="112" Height="112" CornerRadius="56"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="{ThemeResource SurfaceL2Brush}" Padding="10">
                                <ToggleButton x:Uid="SamplerClearToggle" Width="92" Height="92" CornerRadius="46"
                                              Style="{StaticResource SmoothDangerToggle}"
                                              IsChecked="{x:Bind Sampler.ClearArmed, Mode=TwoWay}">
                                    <StackPanel Spacing="2">
                                        <FontIcon Glyph="&#xE74D;" FontSize="20" />
                                        <TextBlock x:Uid="SamplerClearLabel" FontSize="12" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </ToggleButton>
                            </Border>
                        </Grid>
                        <TextBlock Text="{x:Bind Sampler.Status, Mode=OneWay}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>

                <!-- Selected pad: playback mode + trim (supports drag & drop from browser or explorer) -->
                <Border x:Name="PadEditorCard" Style="{StaticResource Card}" Visibility="{x:Bind Shown(Sampler.SelectedPad), Mode=OneWay}"
                        AllowDrop="True" DragOver="PadEditor_DragOver" Drop="PadEditor_Drop">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Bind Sampler.SelectedPad.Title, Mode=OneWay}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{x:Bind Sampler.SelectedPad.SampleName, Mode=OneWay}" Style="{StaticResource Caption}" />
                            </StackPanel>
                            <Button x:Uid="SamplerCloseSettings" Grid.Column="1" Padding="8" Background="Transparent"
                                    BorderThickness="0" Click="CloseSettings_Click">
                                <FontIcon Glyph="&#xE711;" FontSize="14" />
                            </Button>
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Uid="SamplerModeBox" HorizontalAlignment="Stretch"
                                      SelectedIndex="{x:Bind Sampler.SelectedPad.ModeIndex, Mode=TwoWay}">
                                <ComboBoxItem x:Uid="SamplerModePlayStopItem" />
                                <ComboBoxItem x:Uid="SamplerModePlayRestartItem" />
                                <ComboBoxItem x:Uid="SamplerModeHoldItem" />
                            </ComboBox>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                                <Button Click="LoadFile_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8E5;" FontSize="14" /><TextBlock x:Uid="SamplerLoadFile" /></StackPanel>
                                </Button>
                                <Button Click="RemoveSample_Click" x:Uid="SamplerRemoveSample">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Trim: drag the white handles (or ←/→ after clicking; Home/End pick a handle) -->
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="SamplerTrimHeader" Style="{StaticResource Overline}" />
                            <Border CornerRadius="12" Background="{ThemeResource SurfaceL2Brush}" Padding="10">
                                <controls:WaveformView Height="132" IsEditable="True"
                                                       Peaks="{x:Bind Sampler.SelectedPad.Peaks, Mode=OneWay}"
                                                       Start="{x:Bind Sampler.SelectedPad.TrimStart, Mode=TwoWay}"
                                                       End="{x:Bind Sampler.SelectedPad.TrimEnd, Mode=TwoWay}"
                                                       Cursor="{x:Bind Sampler.SelectedPad.Cursor, Mode=OneWay}" />
                            </Border>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Uid="SamplerTrimStart" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{x:Bind Sampler.SelectedPad.StartText, Mode=OneWay}" FontFamily="Consolas" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Uid="SamplerTrimEnd" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{x:Bind Sampler.SelectedPad.EndText, Mode=OneWay}" FontFamily="Consolas" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Uid="SamplerTrimLength" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{x:Bind Sampler.SelectedPad.LengthText, Mode=OneWay}" FontFamily="Consolas" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Click="ResetTrim_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE777;" FontSize="14" /><TextBlock x:Uid="SamplerResetTrim" /></StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource AccentButtonStyle}" Click="PreviewPad_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE768;" FontSize="14" /><TextBlock x:Uid="SamplerPreviewPad" /></StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <!-- Feature 06: Soundboard & Waveform Editor Tools -->
                        <Border Background="{ThemeResource SurfaceL2Brush}" CornerRadius="12" Padding="14,12">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Sound-Optimierung &amp; Bearbeitung" Style="{StaticResource Overline}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Click="NormalizePad_Click" IsEnabled="{x:Bind NotProcessing(Sampler.SelectedPad.IsProcessing), Mode=OneWay}"
                                                    ToolTipService.ToolTip="Hebt die Lautstärke verzerrungsfrei auf -1.0 dBFS an">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE9E9;" FontSize="14" Foreground="{StaticResource BrandBrush}" />
                                                    <TextBlock Text="Normalisieren (-1 dBFS)" />
                                                </StackPanel>
                                            </Button>
                                            <Button Click="AutoTrimPad_Click" ToolTipService.ToolTip="Erkennt und schneidet Stille am Anfang und Ende automatisch ab">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE74E;" FontSize="14" />
                                                    <TextBlock Text="Auto-Trim (Stille)" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Sampler.SelectedPad.ProcessStatus, Mode=OneWay}" Style="{StaticResource Caption}" Foreground="{StaticResource BrandBrush}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <Grid>
                                            <TextBlock Text="Pad-Lautstärke (Gain)" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Text="{x:Bind Sampler.SelectedPad.GainLabel, Mode=OneWay}" HorizontalAlignment="Right"
                                                       FontFamily="Consolas" FontSize="12" Foreground="{StaticResource BrandBrush}" />
                                        </Grid>
                                        <Slider Minimum="-12" Maximum="12" StepFrequency="0.5" Value="{x:Bind Sampler.SelectedPad.GainDb, Mode=TwoWay}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Border Background="{ThemeResource SurfaceL3Brush}" CornerRadius="8" Padding="10,6">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE8B5;" Foreground="{StaticResource BrandBrush}" FontSize="13" />
                                        <TextBlock Text="Drag &amp; Drop: Ziehe Audiodateien (.wav, .mp3, .flac) direkt hierher oder auf die Pads 1–4." Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===== Right: Sampler browser (library) ===== -->
            <Border x:Name="BrowserCard" Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top"
                    AllowDrop="True" DragOver="Library_DragOver" Drop="Library_Drop">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="SamplerBrowserHeader" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="Import_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8B5;" FontSize="14" /><TextBlock x:Uid="SamplerImport" /></StackPanel>
                        </Button>
                    </Grid>
                    <AutoSuggestBox x:Uid="SamplerSearch" Grid.Row="1" QueryIcon="Find"
                                    Text="{x:Bind Sampler.Search, Mode=TwoWay}" />
                    <ProgressBar Grid.Row="2" IsIndeterminate="True" Visibility="{x:Bind Flag(Sampler.IsImporting), Mode=OneWay}" />
                    <StackPanel Grid.Row="3" Spacing="6">
                        <TextBlock x:Uid="SamplerLibraryEmpty" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Visibility="{x:Bind Flag(Sampler.LibraryEmpty), Mode=OneWay}" />
                        <ListView x:Name="LibraryList" ItemsSource="{x:Bind Sampler.FilteredLibrary, Mode=OneWay}"
                                  SelectionMode="None" CanDragItems="True" DragItemsStarting="Library_DragItemsStarting"
                                  MaxHeight="720" Padding="0" Margin="-12,0">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:SampleItemViewModel">
                                    <Grid ColumnSpacing="10" Padding="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Width="36" Height="36" Padding="0" CornerRadius="18" Tag="{x:Bind}"
                                                Click="Preview_Click" x:Uid="SamplerPreview" VerticalAlignment="Center">
                                            <FontIcon Glyph="{x:Bind PreviewGlyph, Mode=OneWay}" FontSize="13" />
                                        </Button>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <controls:WaveformView Height="22" Peaks="{x:Bind Peaks}" IsHitTestVisible="False" Opacity="0.8" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource Caption}" />
                                                <TextBlock Text="{x:Bind Usage, Mode=OneWay}" Style="{StaticResource Caption}"
                                                           Foreground="{StaticResource BrandBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <Button Tag="{x:Bind}" Click="AssignMenu_Click" x:Uid="SamplerAssign" Padding="8">
                                                <FontIcon Glyph="&#xE710;" FontSize="13" />
                                            </Button>
                                            <Button Tag="{x:Bind}" Click="DeleteSample_Click" x:Uid="SamplerDelete" Padding="8">
                                                <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
