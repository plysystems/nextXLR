<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NextXLR.Views.SamplerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NextXLR"
    xmlns:vm="using:NextXLR.ViewModels"
    xmlns:services="using:NextXLR.Services"
    xmlns:controls="using:NextXLR.Controls"
    Background="Transparent">

    <ScrollViewer Style="{StaticResource PageScroller}">
        <Grid x:Name="Root" ColumnSpacing="20" RowSpacing="20" MaxWidth="1620" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="680" />
                <ColumnDefinition x:Name="BrowserCol" Width="460" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Wide">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1280" /></VisualState.StateTriggers>
                    </VisualState>
                    <VisualState x:Name="Narrow">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="BrowserCol.Width" Value="0" />
                            <Setter Target="Root.ColumnSpacing" Value="0" />
                            <Setter Target="BrowserCard.(Grid.Column)" Value="0" />
                            <Setter Target="BrowserCard.(Grid.Row)" Value="2" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <!-- Studio Cockpit Header -->
            <Grid Grid.ColumnSpan="2" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3" VerticalAlignment="Center">
                    <TextBlock x:Uid="SamplerTitle" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
                    <TextBlock Text="Latenzfreie Hardware-Pads mit 3 Bänken (A/B/C), KI-Sound-Optimierung, Waveform-Editor und integrierter Soundboard-Bibliothek."
                               Style="{StaticResource Caption}" Foreground="{ThemeResource TextMutedBrush}" />
                </StackPanel>

                <!-- Quick Legend / Status Indicator -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Background="{ThemeResource SurfaceL2Brush}" BorderBrush="{ThemeResource SurfaceStrokeSubtleBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8D6;" FontSize="13" Foreground="{StaticResource BrandBrush}" />
                            <TextBlock Text="{x:Bind Sampler.Status, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextMutedBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ===== Left: pages + pads (hardware layout) and the selected pad's settings ===== -->
            <StackPanel Grid.Row="1" Spacing="20">
                <Border Background="{ThemeResource GlassCardBackgroundBrush}" CornerRadius="16"
                        BorderBrush="{ThemeResource GlassCardBorderBrush}" BorderThickness="1" Padding="20,18">
                    <StackPanel Spacing="18">
                        <!-- Pages A / B / C Bar -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,12,0">
                                <FontIcon Glyph="&#xE8B9;" FontSize="14" Foreground="{StaticResource BrandBrush}" />
                                <TextBlock Text="SAMPLE-BANK:" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextMutedBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <ItemsRepeater Grid.Column="1" ItemsSource="{x:Bind Sampler.Pages}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinItemWidth="120" MinItemHeight="42" MinColumnSpacing="10"
                                                       MaximumRowsOrColumns="3" ItemsStretch="Fill" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PageViewModel">
                                        <ToggleButton Style="{StaticResource TileToggle}" IsChecked="{x:Bind IsActive, Mode=TwoWay}"
                                                      Content="{x:Bind Label}" FontSize="14" FontWeight="SemiBold"
                                                      services:CursorHelper.UseHandCursor="True" />
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </Grid>

                        <!--
                          Pads 1–4 in a 2×2 grid; Clear sits exactly in the centre, over the inner
                          corners of all four pads (hardware-accurate).
                        -->
                        <Grid x:Name="PadGrid" Height="400" MaxWidth="800" HorizontalAlignment="Stretch"
                              ColumnSpacing="14" RowSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <local:PadTile ViewModel="{x:Bind Sampler.Pads[0]}" />
                            <local:PadTile Grid.Column="1" Mirror="True" ViewModel="{x:Bind Sampler.Pads[1]}" />
                            <local:PadTile Grid.Row="1" ViewModel="{x:Bind Sampler.Pads[2]}" />
                            <local:PadTile Grid.Row="1" Grid.Column="1" Mirror="True" ViewModel="{x:Bind Sampler.Pads[3]}" />

                            <Border Grid.RowSpan="2" Grid.ColumnSpan="2" Width="116" Height="116" CornerRadius="58"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="{ThemeResource SurfaceL2Brush}" Padding="10"
                                    BorderBrush="{ThemeResource SurfaceStrokeBrush}" BorderThickness="1.5">
                                <ToggleButton x:Uid="SamplerClearToggle" Width="96" Height="96" CornerRadius="48"
                                              Style="{StaticResource SmoothDangerToggle}"
                                              IsChecked="{x:Bind Sampler.ClearArmed, Mode=TwoWay}"
                                              services:CursorHelper.UseHandCursor="True">
                                    <StackPanel Spacing="3">
                                        <FontIcon Glyph="&#xE74D;" FontSize="20" />
                                        <TextBlock x:Uid="SamplerClearLabel" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </ToggleButton>
                            </Border>
                        </Grid>
                        
                        <!-- Studio Footer Status Bar -->
                        <Border Background="{ThemeResource SurfaceL3Brush}" CornerRadius="10" Padding="14,8"
                                BorderBrush="{ThemeResource SurfaceStrokeSubtleBrush}" BorderThickness="1">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource BrandBrush}" />
                                    <TextBlock Text="{x:Bind Sampler.Status, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextMutedBrush}" />
                                </StackPanel>
                                <TextBlock Text="Klicke auf ein Pad zum Abspielen oder auf ⚙️ zur Waveform-Bearbeitung"
                                           HorizontalAlignment="Right" FontSize="11" Foreground="{ThemeResource TextMutedBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Selected pad: playback mode + trim (supports drag & drop from browser or explorer) -->
                <Border x:Name="PadEditorCard" Background="{ThemeResource GlassCardBackgroundBrush}" CornerRadius="16"
                        BorderBrush="{ThemeResource GlassCardBorderBrush}" BorderThickness="1" Padding="22,20"
                        Visibility="{x:Bind Shown(Sampler.SelectedPad), Mode=OneWay}"
                        AllowDrop="True" DragOver="PadEditor_DragOver" Drop="PadEditor_Drop">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE70F;" FontSize="16" Foreground="{StaticResource BrandBrush}" />
                                    <TextBlock Text="{x:Bind Sampler.SelectedPad.Title, Mode=OneWay}" Style="{StaticResource SectionTitle}" />
                                    <Border Background="{ThemeResource SurfaceL3Brush}" BorderBrush="{StaticResource BrandBrush}"
                                            BorderThickness="1" CornerRadius="6" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="PAD-EDITOR" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrandBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{x:Bind Sampler.SelectedPad.SampleName, Mode=OneWay}" Style="{StaticResource Caption}" />
                            </StackPanel>
                            <Button x:Uid="SamplerCloseSettings" Grid.Column="1" Padding="8" Background="Transparent"
                                    BorderThickness="0" Click="CloseSettings_Click" services:CursorHelper.UseHandCursor="True">
                                <FontIcon Glyph="&#xE711;" FontSize="14" />
                            </Button>
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Uid="SamplerModeBox" HorizontalAlignment="Stretch"
                                      SelectedIndex="{x:Bind Sampler.SelectedPad.ModeIndex, Mode=TwoWay}"
                                      services:CursorHelper.UseHandCursor="True">
                                <ComboBoxItem x:Uid="SamplerModePlayStopItem" />
                                <ComboBoxItem x:Uid="SamplerModePlayRestartItem" />
                                <ComboBoxItem x:Uid="SamplerModeHoldItem" />
                            </ComboBox>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                                <Button Click="LoadFile_Click" Style="{StaticResource SmoothButton}" services:CursorHelper.UseHandCursor="True">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8E5;" FontSize="14" /><TextBlock x:Uid="SamplerLoadFile" /></StackPanel>
                                </Button>
                                <Button Click="RemoveSample_Click" x:Uid="SamplerRemoveSample" Style="{StaticResource SmoothButton}" services:CursorHelper.UseHandCursor="True">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="#FF453A" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Trim: drag the white handles (or ←/→ after clicking; Home/End pick a handle) -->
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="SamplerTrimHeader" Style="{StaticResource Overline}" />
                            <Border CornerRadius="12" Background="{ThemeResource SurfaceL2Brush}" Padding="10"
                                    BorderBrush="{ThemeResource SurfaceStrokeBrush}" BorderThickness="1">
                                <controls:WaveformView Height="136" IsEditable="True"
                                                       Peaks="{x:Bind Sampler.SelectedPad.Peaks, Mode=OneWay}"
                                                       Start="{x:Bind Sampler.SelectedPad.TrimStart, Mode=TwoWay}"
                                                       End="{x:Bind Sampler.SelectedPad.TrimEnd, Mode=TwoWay}"
                                                       Cursor="{x:Bind Sampler.SelectedPad.Cursor, Mode=OneWay}" />
                            </Border>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Uid="SamplerTrimStart" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{x:Bind Sampler.SelectedPad.StartText, Mode=OneWay}" FontFamily="Consolas" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Uid="SamplerTrimEnd" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{x:Bind Sampler.SelectedPad.EndText, Mode=OneWay}" FontFamily="Consolas" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Uid="SamplerTrimLength" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{x:Bind Sampler.SelectedPad.LengthText, Mode=OneWay}" FontFamily="Consolas" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Click="ResetTrim_Click" Style="{StaticResource SmoothButton}" services:CursorHelper.UseHandCursor="True">
                                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE777;" FontSize="14" /><TextBlock x:Uid="SamplerResetTrim" /></StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource AccentButtonStyle}" Click="PreviewPad_Click" services:CursorHelper.UseHandCursor="True">
                                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE768;" FontSize="14" /><TextBlock x:Uid="SamplerPreviewPad" /></StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <!-- Soundboard & Waveform Editor Tools -->
                        <Border Background="{ThemeResource SurfaceL2Brush}" CornerRadius="12" Padding="16,14"
                                BorderBrush="{ThemeResource SurfaceStrokeSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="230" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Sound-Optimierung &amp; DSP-Bearbeitung" Style="{StaticResource Overline}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Click="NormalizePad_Click" IsEnabled="{x:Bind NotProcessing(Sampler.SelectedPad.IsProcessing), Mode=OneWay}"
                                                    Style="{StaticResource SmoothButton}" services:CursorHelper.UseHandCursor="True"
                                                    ToolTipService.ToolTip="Hebt die Lautstärke verzerrungsfrei auf -1.0 dBFS an">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE9E9;" FontSize="14" Foreground="{StaticResource BrandBrush}" />
                                                    <TextBlock Text="Normalisieren (-1 dBFS)" />
                                                </StackPanel>
                                            </Button>
                                            <Button Click="AutoTrimPad_Click" ToolTipService.ToolTip="Erkennt und schneidet Stille am Anfang und Ende automatisch ab"
                                                    Style="{StaticResource SmoothButton}" services:CursorHelper.UseHandCursor="True">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE74E;" FontSize="14" />
                                                    <TextBlock Text="Auto-Trim (Stille)" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Sampler.SelectedPad.ProcessStatus, Mode=OneWay}" Style="{StaticResource Caption}" Foreground="{StaticResource BrandBrush}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <Grid>
                                            <TextBlock Text="Pad-Lautstärke (Gain)" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Text="{x:Bind Sampler.SelectedPad.GainLabel, Mode=OneWay}" HorizontalAlignment="Right"
                                                       FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrandBrush}" />
                                        </Grid>
                                        <Slider Minimum="-12" Maximum="12" StepFrequency="0.5" Value="{x:Bind Sampler.SelectedPad.GainDb, Mode=TwoWay}"
                                                services:CursorHelper.UseHandCursor="True" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Border Background="{ThemeResource SurfaceL3Brush}" CornerRadius="8" Padding="12,8">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE8B5;" Foreground="{StaticResource BrandBrush}" FontSize="13" />
                                        <TextBlock Text="Drag &amp; Drop: Ziehe Audiodateien (.wav, .mp3, .flac) direkt hierher oder auf die Pads 1–4." Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===== Right: Sampler browser (library) ===== -->
            <Border x:Name="BrowserCard" Grid.Row="1" Grid.Column="1" Background="{ThemeResource GlassCardBackgroundBrush}" CornerRadius="16"
                    BorderBrush="{ThemeResource GlassCardBorderBrush}" BorderThickness="1" Padding="22,20" VerticalAlignment="Top"
                    AllowDrop="True" DragOver="Library_DragOver" Drop="Library_Drop">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock x:Uid="SamplerBrowserHeader" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                            <TextBlock Text="Sound-Bibliothek &amp; Presets" Style="{StaticResource Caption}" Foreground="{ThemeResource TextMutedBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="Import_Click" services:CursorHelper.UseHandCursor="True">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8B5;" FontSize="14" /><TextBlock x:Uid="SamplerImport" /></StackPanel>
                        </Button>
                    </Grid>
                    <AutoSuggestBox x:Uid="SamplerSearch" Grid.Row="1" QueryIcon="Find"
                                    Text="{x:Bind Sampler.Search, Mode=TwoWay}"
                                    services:CursorHelper.UseHandCursor="True" />
                    <ProgressBar Grid.Row="2" IsIndeterminate="True" Visibility="{x:Bind Flag(Sampler.IsImporting), Mode=OneWay}" />
                    <StackPanel Grid.Row="3" Spacing="6">
                        <TextBlock x:Uid="SamplerLibraryEmpty" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Visibility="{x:Bind Flag(Sampler.LibraryEmpty), Mode=OneWay}" />
                        <ListView x:Name="LibraryList" ItemsSource="{x:Bind Sampler.FilteredLibrary, Mode=OneWay}"
                                  SelectionMode="None" CanDragItems="True" DragItemsStarting="Library_DragItemsStarting"
                                  MaxHeight="720" Padding="0" Margin="-12,0">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:SampleItemViewModel">
                                    <Border Background="{ThemeResource SurfaceL1Brush}" BorderBrush="{ThemeResource SurfaceStrokeSubtleBrush}"
                                            BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,8">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button Width="38" Height="38" Padding="0" CornerRadius="19" Tag="{x:Bind}"
                                                    Click="Preview_Click" x:Uid="SamplerPreview" VerticalAlignment="Center"
                                                    Style="{StaticResource SmoothButton}" services:CursorHelper.UseHandCursor="True">
                                                <FontIcon Glyph="{x:Bind PreviewGlyph, Mode=OneWay}" FontSize="13" Foreground="{StaticResource BrandBrush}" />
                                            </Button>
                                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" FontSize="13" />
                                                <controls:WaveformView Height="22" Peaks="{x:Bind Peaks}" IsHitTestVisible="False" Opacity="0.8" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind Detail}" Style="{StaticResource Caption}" />
                                                    <TextBlock Text="{x:Bind Usage, Mode=OneWay}" Style="{StaticResource Caption}"
                                                               Foreground="{StaticResource BrandBrush}" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Button Tag="{x:Bind}" Click="AssignMenu_Click" x:Uid="SamplerAssign" Padding="8,8"
                                                        Style="{StaticResource SmoothButton}" services:CursorHelper.UseHandCursor="True"
                                                        ToolTipService.ToolTip="Auf Pad zuweisen">
                                                    <FontIcon Glyph="&#xE710;" FontSize="13" />
                                                </Button>
                                                <Button Tag="{x:Bind}" Click="DeleteSample_Click" x:Uid="SamplerDelete" Padding="8,8"
                                                        Style="{StaticResource SmoothButton}" services:CursorHelper.UseHandCursor="True"
                                                        ToolTipService.ToolTip="Aus Bibliothek löschen">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="#FF453A" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
