<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NextXLR.Views.MicPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NextXLR.ViewModels"
    xmlns:services="using:NextXLR.Services"
    xmlns:controls="using:NextXLR.Controls"
    Background="{StaticResource SurfaceL1Brush}">

    <Page.Resources>
        <Style TargetType="Expander">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{StaticResource SurfaceL2Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceStrokeSubtleBrush}" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>
    </Page.Resources>

    <ScrollViewer Style="{StaticResource PageScroller}">
        <StackPanel Spacing="16" MaxWidth="1080" HorizontalAlignment="Center">
            <TextBlock x:Uid="MicTitle" Style="{StaticResource PageTitle}" Margin="0,0,0,8" />

            <!-- Mic profiles: gate, compressor, EQ, de-esser -->
            <Border Style="{StaticResource Card}" Padding="18,16">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE720;" FontSize="16" Foreground="{StaticResource BrandBrush}" />
                            <TextBlock x:Uid="MicProfileHeader" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <ComboBox x:Name="MicProfileBox" x:Uid="MicProfileBox" Grid.Column="1" HorizontalAlignment="Stretch" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                            <Button x:Uid="MicProfileLoad" Style="{StaticResource AccentButtonStyle}" Click="MicLoad_Click" />
                            <Button x:Uid="MicProfileDefault" Click="MicDefault_Click">
                                <FontIcon x:Name="MicDefaultIcon" Glyph="&#xE734;" FontSize="14" />
                            </Button>
                            <Button x:Uid="MicProfileExport" Click="MicExport_Click">
                                <FontIcon Glyph="&#xEDE1;" FontSize="14" />
                            </Button>
                            <Button x:Uid="MicProfileImport" Click="MicImport_Click">
                                <FontIcon Glyph="&#xE8B5;" FontSize="14" />
                            </Button>
                            <Button x:Uid="MicProfileDelete" Click="MicDelete_Click">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="MicProfileName" x:Uid="MicProfileName" MaxLength="40" PlaceholderText="Profilname eingeben..." />
                        <Button x:Uid="MicProfileSave" Grid.Column="1" Click="MicSave_Click" />
                    </Grid>
                    <InfoBar x:Name="MicProfileResult" IsClosable="True" />
                </StackPanel>
            </Border>

            <!-- Quick Presets -->
            <Border Style="{StaticResource Card}" Padding="16,14">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE735;" FontSize="15" Foreground="{StaticResource BrandBrush}" />
                        <TextBlock Text="Mikrofon Schnell-Presets (Ein-Klick-Optimierung)" FontWeight="SemiBold" />
                    </StackPanel>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button HorizontalAlignment="Stretch" Style="{StaticResource SmoothButton}" Tag="sm7b" Click="MicPreset_Click" Padding="8,8">
                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                <TextBlock Text="Shure SM7B" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" />
                                <TextBlock Text="Dynamisch • 56 dB" Style="{StaticResource Caption}" FontSize="10" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" HorizontalAlignment="Stretch" Style="{StaticResource SmoothButton}" Tag="podmic" Click="MicPreset_Click" Padding="8,8">
                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                <TextBlock Text="Rode PodMic" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" />
                                <TextBlock Text="Dynamisch • 48 dB" Style="{StaticResource Caption}" FontSize="10" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" HorizontalAlignment="Stretch" Style="{StaticResource SmoothButton}" Tag="condenser" Click="MicPreset_Click" Padding="8,8">
                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                <TextBlock Text="Kondensator" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" />
                                <TextBlock Text="+48V • 36 dB" Style="{StaticResource Caption}" FontSize="10" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="3" HorizontalAlignment="Stretch" Style="{StaticResource SmoothButton}" Tag="broadcast" Click="MicPreset_Click" Padding="8,8">
                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                <TextBlock Text="Broadcast Voice" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" />
                                <TextBlock Text="Warm &amp; Präsent" Style="{StaticResource Caption}" FontSize="10" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="4" HorizontalAlignment="Stretch" Style="{StaticResource SmoothButton}" Tag="neutral" Click="MicPreset_Click" Padding="8,8">
                            <StackPanel Spacing="2" HorizontalAlignment="Center">
                                <TextBlock Text="Neutral / Flat" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" />
                                <TextBlock Text="Linear Response" Style="{StaticResource Caption}" FontSize="10" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Mic setup (always visible) -->
            <Border Style="{StaticResource Card}" Padding="20">
                <Grid ColumnSpacing="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="MicSetupHeader" Style="{StaticResource SectionTitle}" />
                        <RadioButtons x:Uid="MicTypeRadio" SelectedIndex="{x:Bind Mic.MicType, Mode=TwoWay}">
                            <RadioButton x:Uid="MicTypeDynamic" />
                            <RadioButton x:Uid="MicTypeCondenser" />
                            <RadioButton x:Uid="MicTypeJack" />
                        </RadioButtons>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="16">
                        <Slider x:Uid="MicGain" Minimum="0" Maximum="72" Value="{x:Bind Mic.Gain, Mode=TwoWay}" />
                        <StackPanel Spacing="6">
                            <Grid>
                                <TextBlock x:Uid="MicInputLevel" Style="{StaticResource Caption}" />
                                <TextBlock HorizontalAlignment="Right" Style="{StaticResource Caption}"
                                           Text="{x:Bind ViewModel.MicChannel.PeakLabel, Mode=OneWay}" />
                            </Grid>
                            <ProgressBar Height="8" CornerRadius="4" Maximum="1" Value="{x:Bind ViewModel.MicChannel.Meter, Mode=OneWay}"
                                         Foreground="{StaticResource MeterBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Uid="MicNoiseSuppression" IsOn="{x:Bind Mic.NoiseSuppression, Mode=TwoWay}" />
                        <TextBlock x:Uid="MicLocalNote" Style="{StaticResource Caption}" />
                    </StackPanel>
                    <ToggleButton Grid.Column="2" Height="42" Padding="14,0" VerticalAlignment="Top"
                                  Style="{StaticResource SmoothDangerToggle}"
                                  IsChecked="{x:Bind ViewModel.MicMuted, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{x:Bind MicMuteGlyph(ViewModel.MicMuted), Mode=OneWay}" FontSize="16" />
                            <TextBlock Text="{x:Bind MicMuteStatus(ViewModel.MicMuted), Mode=OneWay}" FontWeight="SemiBold" />
                        </StackPanel>
                    </ToggleButton>
                </Grid>
            </Border>

            <!-- Noise gate -->
            <Expander IsExpanded="True">
                <Expander.Header>
                    <Grid Padding="0,10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE9D9;" Foreground="{StaticResource BrandBrush}" />
                        <TextBlock x:Uid="MicGateHeader" Grid.Column="1" Style="{StaticResource CardTitle}" />
                        <ToggleSwitch Grid.Column="2" IsOn="{x:Bind Mic.GateEnabled, Mode=TwoWay}"
                                      OnContent="" OffContent="" MinWidth="0" />
                    </Grid>
                </Expander.Header>
                <Grid ColumnSpacing="32" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Slider x:Uid="MicGateThreshold" Minimum="-59" Maximum="0" StepFrequency="1" Value="{x:Bind Mic.GateThreshold, Mode=TwoWay}" />
                    <Slider x:Uid="MicGateAttenuation" Grid.Column="1" Minimum="0" Maximum="100" StepFrequency="1" Value="{x:Bind Mic.GateAttenuation, Mode=TwoWay}" />
                    <Grid Grid.Row="1">
                        <Slider x:Uid="MicGateAttack" Minimum="0" Maximum="45" StepFrequency="1" IsThumbToolTipEnabled="False"
                                Value="{x:Bind Mic.GateAttack, Mode=TwoWay}" />
                        <TextBlock Text="{x:Bind Mic.GateAttackLabel, Mode=OneWay}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Grid.Row="1" Grid.Column="1">
                        <Slider x:Uid="MicGateRelease" Minimum="0" Maximum="45" StepFrequency="1" IsThumbToolTipEnabled="False"
                                Value="{x:Bind Mic.GateRelease, Mode=TwoWay}" />
                        <TextBlock Text="{x:Bind Mic.GateReleaseLabel, Mode=OneWay}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                    </Grid>
                </Grid>
            </Expander>

            <!-- Equalizer (10 bands, full GoXLR) -->
            <Expander>
                <Expander.Header>
                    <Grid Padding="0,10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE9E9;" Foreground="{StaticResource BrandBrush}" />
                        <TextBlock x:Uid="MicEqHeader" Grid.Column="1" Style="{StaticResource CardTitle}" />
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="14" HorizontalAlignment="Center">
                    <TextBlock x:Uid="MicEqMiniNote" Style="{StaticResource Caption}"
                               Visibility="{x:Bind Visible(ViewModel.Hardware.IsMini), Mode=OneWay}" />

                    <!-- Feature 03: Real-Time Spectrum Analyzer (RTA) -->
                    <StackPanel Spacing="6" HorizontalAlignment="Center" Width="784">
                        <Grid>
                            <TextBlock Text="Echtzeit-Spektrumanalysator (RTA Live-FFT)" Style="{StaticResource Overline}" />
                            <TextBlock Text="10 Terz-Bänder · Peak-Hold" HorizontalAlignment="Right" Style="{StaticResource Caption}" Foreground="{StaticResource BrandBrush}" />
                        </Grid>
                        <controls:RtaSpectrumVisualizer Height="85" Channel="{x:Bind ViewModel.MicChannel, Mode=OneWay}" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{x:Bind Mic.EqBands}" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:EqBandViewModel">
                                <StackPanel Width="64" Spacing="8">
                                    <TextBlock Text="{x:Bind GainLabel, Mode=OneWay}" Style="{StaticResource Caption}"
                                               HorizontalAlignment="Center" />
                                    <Slider Orientation="Vertical" Height="180" Minimum="-9" Maximum="9" StepFrequency="1"
                                            HorizontalAlignment="Center" Value="{x:Bind Gain, Mode=TwoWay}" />
                                    <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Expander>

            <!-- Compressor -->
            <Expander IsExpanded="True">
                <Expander.Header>
                    <Grid Padding="0,10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE9CA;" Foreground="{StaticResource BrandBrush}" />
                        <TextBlock x:Uid="MicCompHeader" Grid.Column="1" Style="{StaticResource CardTitle}" />
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="16">
                    <!-- Feature 10: Live Visual Compression & Gain Reduction Graph -->
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Echtzeit Dynamik- &amp; Gain-Reduction-Verlauf (Eingang vs. Reduktion)" Style="{StaticResource Overline}" />
                            <TextBlock Grid.Column="1" Text="Live-Analyse (30 FPS)" Style="{StaticResource Caption}" Foreground="{StaticResource MutedTextBrush}" />
                        </Grid>
                        <controls:CompressionHistoryGraph
                            Height="140"
                            Channel="{x:Bind ViewModel.MicChannel, Mode=OneWay}"
                            Threshold="{x:Bind Mic.CompThreshold, Mode=OneWay}"
                            Ratio="{x:Bind Mic.CompRatioNumeric, Mode=OneWay}"
                            Makeup="{x:Bind Mic.CompMakeup, Mode=OneWay}" />
                    </StackPanel>

                    <Grid ColumnSpacing="32" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Slider x:Uid="MicCompThreshold" Minimum="-40" Maximum="0" StepFrequency="1" Value="{x:Bind Mic.CompThreshold, Mode=TwoWay}" />
                        <ComboBox x:Uid="MicCompRatio" Grid.Column="1" ItemsSource="{x:Bind Mic.Ratios}" HorizontalAlignment="Stretch"
                                  SelectedIndex="{x:Bind Mic.CompRatio, Mode=TwoWay}" />
                        <Slider x:Uid="MicCompMakeup" Grid.Column="2" Minimum="-6" Maximum="24" StepFrequency="1" Value="{x:Bind Mic.CompMakeup, Mode=TwoWay}" />
                        <Grid Grid.Row="1">
                            <Slider x:Uid="MicCompAttack" Minimum="0" Maximum="19" StepFrequency="1" IsThumbToolTipEnabled="False"
                                    Value="{x:Bind Mic.CompAttack, Mode=TwoWay}" />
                            <TextBlock Text="{x:Bind Mic.CompAttackLabel, Mode=OneWay}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="1">
                            <Slider x:Uid="MicCompRelease" Minimum="0" Maximum="19" StepFrequency="1" IsThumbToolTipEnabled="False"
                                    Value="{x:Bind Mic.CompRelease, Mode=TwoWay}" />
                            <TextBlock Text="{x:Bind Mic.CompReleaseLabel, Mode=OneWay}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                        </Grid>
                    </Grid>
                </StackPanel>
            </Expander>

            <!-- De-esser -->
            <Expander>
                <Expander.Header>
                    <Grid Padding="0,10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8D6;" Foreground="{StaticResource BrandBrush}" />
                        <TextBlock x:Uid="MicDeEsserHeader" Grid.Column="1" Style="{StaticResource CardTitle}" />
                    </Grid>
                </Expander.Header>
                <Slider x:Uid="MicDeEsser" Minimum="0" Maximum="100" StepFrequency="1" Value="{x:Bind Mic.DeEsser, Mode=TwoWay}"
                        HorizontalAlignment="Stretch" />
            </Expander>

            <!-- KI-Rauschunterdrückung -->
            <Expander IsExpanded="True">
                <Expander.Header>
                    <Grid Padding="0,10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE9F5;" Foreground="{StaticResource BrandBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="KI-Rauschunterdrückung (AI Noise Reduction)" Style="{StaticResource CardTitle}" />
                                <Border Background="{x:Bind RnnoiseBadgeBackground(Mic.RnnoiseEnabled), Mode=OneWay}"
                                        BorderBrush="{x:Bind RnnoiseBadgeBorder(Mic.RnnoiseEnabled), Mode=OneWay}"
                                        BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Mic.RnnoiseStatusBadge, Mode=OneWay}" FontSize="10" FontWeight="Bold"
                                               Foreground="{x:Bind RnnoiseBadgeForeground(Mic.RnnoiseEnabled), Mode=OneWay}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Entfernt mechanische Tastaturgeräusche, Mausklicks und Lüfterlärm in Echtzeit" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" IsOn="{x:Bind Mic.RnnoiseEnabled, Mode=TwoWay}" IsEnabled="True"
                                      OnContent="Aktiv" OffContent="Bypass" MinWidth="0" VerticalAlignment="Center" />
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="16" Padding="4">
                    <InfoBar Severity="{x:Bind RnnoiseInfoSeverity(Mic.RnnoiseEnabled), Mode=OneWay}" IsOpen="True" IsClosable="False"
                             Title="{x:Bind Mic.RnnoiseStatusBadge, Mode=OneWay}"
                             Message="{x:Bind Mic.RnnoiseStatusMessage, Mode=OneWay}" />
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="280" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                <TextBlock Text="KI-Entrauschungs-Intensität" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Mic.RnnoiseIntensityLabel, Mode=OneWay}" Style="{StaticResource Caption}"
                                           Foreground="{StaticResource BrandBrush}" Margin="12,0,0,0" FontWeight="Bold" />
                            </StackPanel>
                            <Slider Minimum="0" Maximum="100" StepFrequency="1" Value="{x:Bind Mic.RnnoiseIntensity, Mode=TwoWay}" />
                            <TextBlock Text="Höhere Werte filtern aggressiver, niedrigere Werte erhalten leises Flüstern unverändert." Style="{StaticResource Caption}" Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Neuronales KI-Modell" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="DeepFilterNet 3" Style="{StaticResource SmoothButton}" Tag="DeepFilterNet3" Click="RnnoiseModel_Click" />
                                <Button Content="RNNoise" Style="{StaticResource SmoothButton}" Tag="RNNoise" Click="RnnoiseModel_Click" />
                                <Button Content="VoiceClear" Style="{StaticResource SmoothButton}" Tag="VoiceClear" Click="RnnoiseModel_Click" />
                            </StackPanel>
                            <TextBlock Text="Latenz: &lt; 10 ms · SIMD AVX2 beschleunigt" Style="{StaticResource Caption}" Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Expander>

            <!-- Voice-Morphing -->
            <Expander IsExpanded="False">
                <Expander.Header>
                    <Grid Padding="0,10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xED35;" Foreground="{StaticResource BrandBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Voice-Morphing" Style="{StaticResource CardTitle}" />
                                <Border Background="{StaticResource SurfaceL3Brush}" BorderBrush="{StaticResource BrandBrush}" BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock Text="Upcoming" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrandBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Echtzeit-Formant- und Tonhöhenverschiebung mit Charakter-Filtern" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" IsOn="False" IsEnabled="False"
                                      OnContent="Aktiv" OffContent="Bypass" MinWidth="0" VerticalAlignment="Center" />
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="16" Padding="4" IsHitTestVisible="False" Opacity="0.6">
                    <InfoBar Severity="Informational" IsOpen="True" IsClosable="False"
                             Message="Upcoming: Voice-Morphing (Personas &amp; Stimmenmodulation) wird in einem kommenden Update freigeschaltet." />
                    <!-- Quick Personas -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Schnellauswahl Stimme &amp; Charakter-Persona:" Style="{StaticResource Caption}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button HorizontalAlignment="Stretch" Style="{StaticResource SmoothButton}" Tag="radio" Click="PersonaPreset_Click" Padding="6,8">
                                <StackPanel Spacing="2" HorizontalAlignment="Center">
                                    <TextBlock Text="📻 Funkgerät" FontWeight="Bold" FontSize="11" />
                                    <TextBlock Text="Walkie-Talkie" Style="{StaticResource Caption}" FontSize="9" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" HorizontalAlignment="Stretch" Style="{StaticResource SmoothButton}" Tag="helldivers" Click="PersonaPreset_Click" Padding="6,8">
                                <StackPanel Spacing="2" HorizontalAlignment="Center">
                                    <TextBlock Text="🚀 Helldivers" FontWeight="Bold" FontSize="11" />
                                    <TextBlock Text="Helm-Comms" Style="{StaticResource Caption}" FontSize="9" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" HorizontalAlignment="Stretch" Style="{StaticResource SmoothButton}" Tag="robot" Click="PersonaPreset_Click" Padding="6,8">
                                <StackPanel Spacing="2" HorizontalAlignment="Center">
                                    <TextBlock Text="🤖 Cyber Robot" FontWeight="Bold" FontSize="11" />
                                    <TextBlock Text="Vocoder Synth" Style="{StaticResource Caption}" FontSize="9" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3" HorizontalAlignment="Stretch" Style="{StaticResource SmoothButton}" Tag="alien" Click="PersonaPreset_Click" Padding="6,8">
                                <StackPanel Spacing="2" HorizontalAlignment="Center">
                                    <TextBlock Text="👾 Deep Alien" FontWeight="Bold" FontSize="11" />
                                    <TextBlock Text="Monster Pitch" Style="{StaticResource Caption}" FontSize="9" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="4" HorizontalAlignment="Stretch" Style="{StaticResource SmoothButton}" Tag="announcer" Click="PersonaPreset_Click" Padding="6,8">
                                <StackPanel Spacing="2" HorizontalAlignment="Center">
                                    <TextBlock Text="🎙️ Announcer" FontWeight="Bold" FontSize="11" />
                                    <TextBlock Text="Deep Radio Voice" Style="{StaticResource Caption}" FontSize="9" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Pitch, Formant, Drive Sliders -->
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Pitch Shift (-12 bis +12 Halbtöne)" FontWeight="SemiBold" />
                            <Slider Minimum="-12" Maximum="12" StepFrequency="1" Value="{x:Bind Mic.VoiceMorphPitch, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Formant Shift (-12 bis +12)" FontWeight="SemiBold" />
                            <Slider Minimum="-12" Maximum="12" StepFrequency="1" Value="{x:Bind Mic.VoiceMorphFormant, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="6">
                            <TextBlock Text="Drive / Verzerrung (0 - 100%)" FontWeight="SemiBold" />
                            <Slider Minimum="0" Maximum="100" StepFrequency="1" Value="{x:Bind Mic.VoiceMorphDrive, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Expander>

            <!-- Feature 11: Gehörschutz & Broadcast True-Peak Master (EBU R128) -->
            <Expander IsExpanded="True">
                <Expander.Header>
                    <Grid Padding="0,10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7EF;" Foreground="{StaticResource BrandBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Gehörschutz &amp; Broadcast True-Peak Limiter" Style="{StaticResource CardTitle}" />
                                <Border Background="{StaticResource SurfaceL3Brush}" CornerRadius="10" Padding="8,2">
                                    <TextBlock Text="EBU R128 Standard" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrandBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Kopfhörer-Schutz vor extremen Lautstärkespitzen + normkonformer Broadcast-Master" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" IsOn="{x:Bind SafetyLimiter.EarGuardEnabled, Mode=TwoWay}"
                                      OnContent="Schutz Aktiv" OffContent="Bypass" MinWidth="0" VerticalAlignment="Center" />
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="16" Padding="4">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Ear Guard (Kopfhörer-Schutz) -->
                        <Border Background="{StaticResource SurfaceL2Brush}" CornerRadius="10" Padding="14">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7F6;" Foreground="{StaticResource HeadphoneBrush}" FontSize="15" />
                                    <TextBlock Text="Gehörschutz (Kopfhörer Ear-Guard)" FontWeight="SemiBold" FontSize="13" />
                                </StackPanel>
                                <TextBlock Text="Begrenzt die Kopfhörer-Ausgabelautstärke hart, damit laute Discord-Trolle oder Spielbugs dein Gehör nicht schädigen."
                                           Style="{StaticResource Caption}" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                                <Grid>
                                    <TextBlock Text="Maximaler Kopfhörerpegel (Ceiling)" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{x:Bind SafetyLimiter.EarGuardCeilingLabel, Mode=OneWay}" HorizontalAlignment="Right"
                                               FontFamily="Consolas" Foreground="{StaticResource HeadphoneBrush}" FontWeight="SemiBold" />
                                </Grid>
                                <Slider Minimum="-12" Maximum="0" StepFrequency="0.5" Value="{x:Bind SafetyLimiter.EarGuardCeilingDb, Mode=TwoWay}" />
                                <TextBlock Text="{x:Bind SafetyLimiter.EarGuardStatus, Mode=OneWay}" Style="{StaticResource Caption}" Foreground="{StaticResource HeadphoneBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Right: Broadcast True-Peak Master (Stream) -->
                        <Border Grid.Column="1" Background="{StaticResource SurfaceL2Brush}" CornerRadius="10" Padding="14">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE774;" Foreground="{StaticResource BrandBrush}" FontSize="15" />
                                    <TextBlock Text="Broadcast True-Peak Limiter (Stream)" FontWeight="SemiBold" FontSize="13" />
                                </StackPanel>
                                <TextBlock Text="Sorgt für normgerechte Twitch- und YouTube-Aussteuerung (-14 LUFS / -1.0 dBTP) ohne Übersteuern."
                                           Style="{StaticResource Caption}" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                                <Grid>
                                    <TextBlock Text="True-Peak Decke (Ceiling)" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{x:Bind SafetyLimiter.TruePeakCeilingLabel, Mode=OneWay}" HorizontalAlignment="Right"
                                               FontFamily="Consolas" Foreground="{StaticResource BrandBrush}" FontWeight="SemiBold" />
                                </Grid>
                                <Slider Minimum="-3.0" Maximum="0.0" StepFrequency="0.1" Value="{x:Bind SafetyLimiter.TruePeakCeilingDb, Mode=TwoWay}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{StaticResource SurfaceL3Brush}" CornerRadius="6" Padding="8,4">
                                        <StackPanel>
                                            <TextBlock Text="Loudness (LUFS)" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock Text="{x:Bind SafetyLimiter.LufsDisplay, Mode=OneWay}" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource BrandBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="{StaticResource SurfaceL3Brush}" CornerRadius="6" Padding="8,4">
                                        <StackPanel>
                                            <TextBlock Text="True-Peak" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock Text="{x:Bind SafetyLimiter.TruePeakDisplay, Mode=OneWay}" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Expander>

            <!-- VST3-Plugins -->
            <Expander IsExpanded="True">
                <Expander.Header>
                    <Grid Padding="0,10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE99A;" Foreground="{StaticResource BrandBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="VST3-Plugins" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="6 integrierte High-End Studio-DSPs (EQ, Opto, De-Esser, Tube-Sat, Expander, Limiter) &amp; VST3/CLAP-Unterstützung" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Master-Rack:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextMutedBrush}" />
                            <ToggleSwitch IsOn="{x:Bind Vst.IsMasterEnabled, Mode=OneWay}"
                                          Toggled="VstMasterToggle_Toggled"
                                          OnContent="Aktiv" OffContent="Bypass"
                                          MinWidth="0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="14" Padding="4">
                    <!-- Master Bypass InfoBar -->
                    <InfoBar IsOpen="{x:Bind Vst.IsMasterBypassed, Mode=OneWay}"
                             IsClosable="False"
                             Severity="Warning"
                             Title="Master-Rack im Bypass"
                             Message="Das gesamte VST3/DSP-Rack ist deaktiviert. Audiosignale werden unverändert durchgeschleift (Clean Pass-Through)."
                             Margin="0,0,0,2" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Style="{StaticResource AccentButtonStyle}" Click="ResetToIntegrated_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE99A;" FontSize="14" />
                                    <TextBlock Text="Standard Studio-Kette (6 DSPs)" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SmoothButton}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                    <TextBlock Text="Plugin hinzufügen" />
                                    <FontIcon Glyph="&#xE70D;" FontSize="10" />
                                </StackPanel>
                                <Button.Flyout>
                                    <MenuFlyout Placement="Bottom">
                                        <MenuFlyoutItem Text="[GATE] NEXT : Smart Expander" Click="AddSpecificPlugin_Click" Tag="GATE" />
                                        <MenuFlyoutItem Text="[DE-ESS] NEXT : Precision DeEsser" Click="AddSpecificPlugin_Click" Tag="DE-ESS" />
                                        <MenuFlyoutItem Text="[EQ] NEXT : Pro-EQ 6" Click="AddSpecificPlugin_Click" Tag="EQ" />
                                        <MenuFlyoutItem Text="[COMP] NEXT : Broadcast Opto" Click="AddSpecificPlugin_Click" Tag="COMP" />
                                        <MenuFlyoutItem Text="[WARMTH] NEXT : Tube &amp; Tape Sat" Click="AddSpecificPlugin_Click" Tag="WARMTH" />
                                        <MenuFlyoutItem Text="[LIMITER] NEXT : True-Peak Master" Click="AddSpecificPlugin_Click" Tag="LIMITER" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Plugin-Datei laden (.vst3 / .clap)..." Click="AddVst_Click" />
                                        <MenuFlyoutItem Text="System nach VST3 / CLAP scannen..." Click="ScanVst_Click" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>

                            <Button Style="{StaticResource SmoothButton}" Click="SyncAllDSPs_Click" ToolTipService.ToolTip="Alle DSP-Einstellungen erneut an GoXLR übertragen">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE777;" FontSize="14" />
                                    <TextBlock Text="DSPs synchronisieren" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Border Grid.Column="1" Background="{StaticResource SurfaceL2Brush}" BorderBrush="{StaticResource BrandBrush}" BorderThickness="1" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{StaticResource BrandBrush}" />
                                <TextBlock Text="Live im Hardware-DSP (0 ms Latenz)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrandBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Background="{StaticResource SurfaceL3Brush}" CornerRadius="10" Padding="14" Opacity="{x:Bind Vst.MasterOpacity, Mode=OneWay}">
                        <StackPanel Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Aktives Effekt-Rack (Mikrofon-DSP-Kanal):" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Klicke 'Editor öffnen' um EQ, Dynamik &amp; Presets einzustellen" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            </Grid>

                            <ItemsControl ItemsSource="{x:Bind Vst.RackPlugins, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="services:VstPluginItem">
                                        <Grid Background="{StaticResource SurfaceL1Brush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Background="{StaticResource SurfaceL2Brush}" BorderBrush="{x:Bind TagBrush, Mode=OneWay}" BorderThickness="1.5" CornerRadius="8" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind TagCode, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="{x:Bind TagBrush, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" />
                                                    <Border Background="{StaticResource SurfaceL2Brush}" BorderBrush="{x:Bind TagBrush, Mode=OneWay}" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Format, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="{x:Bind TagBrush, Mode=OneWay}" />
                                                    </Border>
                                                    <TextBlock Text="•" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind StatusBrush, Mode=OneWay}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <ComboBox ItemsSource="{x:Bind AvailablePresets, Mode=OneWay}"
                                                              SelectedItem="{x:Bind PresetName, Mode=OneWay}"
                                                              Tag="{x:Bind}"
                                                              SelectionChanged="PresetCombo_SelectionChanged"
                                                              MinWidth="220" Height="28" FontSize="11" />
                                                    <TextBlock Text="{x:Bind Path, Mode=OneWay}" Style="{StaticResource Caption}" MaxLines="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Button Style="{StaticResource SmoothButton}" Tag="{x:Bind}" Click="MoveVstUp_Click" ToolTipService.ToolTip="Im Signalweg nach oben" Padding="6,6">
                                                    <FontIcon Glyph="&#xE70E;" FontSize="11" />
                                                </Button>
                                                <Button Style="{StaticResource SmoothButton}" Tag="{x:Bind}" Click="MoveVstDown_Click" ToolTipService.ToolTip="Im Signalweg nach unten" Padding="6,6">
                                                    <FontIcon Glyph="&#xE70D;" FontSize="11" />
                                                </Button>
                                                <Button Style="{StaticResource AccentButtonStyle}" Tag="{x:Bind}" Click="OpenVstEditor_Click" Padding="12,6">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE70F;" FontSize="13" />
                                                        <TextBlock Text="Editor öffnen" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Button>
                                                <ToggleSwitch IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                                              Tag="{x:Bind}"
                                                              Toggled="PluginToggle_Toggled"
                                                              OnContent="Aktiv" OffContent="Bypass"
                                                              MinWidth="0" VerticalAlignment="Center" />
                                                <Button Style="{StaticResource SmoothButton}" Tag="{x:Bind}" Click="RemoveVst_Click" ToolTipService.ToolTip="Aus Rack entfernen" Padding="8,6">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="#FF453A" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
