<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NextXLR.Views.LightingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NextXLR.ViewModels"
    xmlns:controls="using:NextXLR.Controls"
    xmlns:services="using:NextXLR.Services"
    Background="Transparent">

    <Page.Resources>
        <!-- Colour flyout: ring picker + hex input + quick swatches. Shared by both swatch buttons. -->
        <Style x:Key="SwatchButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Padding" Value="6" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{StaticResource SurfaceL2Brush}" />
        </Style>
        <DataTemplate x:Key="PaletteItem" x:DataType="vm:PaletteSwatch">
            <Button Width="30" Height="30" Padding="0" Margin="0,0,6,6" CornerRadius="15" Background="{x:Bind Brush}"
                    BorderBrush="#40FFFFFF" BorderThickness="1" Command="{x:Bind Pick}"
                    ToolTipService.ToolTip="{x:Bind Hex}" AutomationProperties.Name="{x:Bind Hex}" />
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer Style="{StaticResource PageScroller}">
        <StackPanel Spacing="20" MaxWidth="1400" HorizontalAlignment="Center">
            <StackPanel Spacing="6">
                <TextBlock x:Uid="LightTitle" Style="{StaticResource PageTitle}" />
            </StackPanel>

            <!-- Live device: mirrors the LED colours, button states, faders and knobs of the GoXLR -->
            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel Spacing="16">
                    <!-- Auto-detected hardware badge (GoXLR vs GoXLR Mini) -->
                    <Border HorizontalAlignment="Center" Background="{StaticResource SurfaceL2Brush}"
                            BorderBrush="{StaticResource SurfaceStrokeSubtleBrush}" BorderThickness="1"
                            CornerRadius="20" Padding="16,6">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE7F6;" FontSize="14" Foreground="{StaticResource BrandBrush}" />
                            <TextBlock x:Name="ModelBadgeText" Text="GoXLR" FontWeight="SemiBold" FontSize="13" />
                        </StackPanel>
                    </Border>

                    <controls:DeviceView x:Name="DevicePreview" MaxHeight="390" HorizontalAlignment="Center"
                                         Snapshot="{x:Bind ViewModel.Device, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- Themes: one click recolours the whole device -->
            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel Spacing="16">
                    <!-- Header with Title and Actions -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE790;" FontSize="18" Foreground="{StaticResource BrandBrush}" />
                                <TextBlock Text="Beleuchtungs-Designs &amp; Vorlagen" Style="{StaticResource SectionTitle}" />
                            </StackPanel>
                            <TextBlock Text="Wähle ein vorgegebenes Gaming-Design oder speichere deine aktuellen Farben als eigenes Theme."
                                       Style="{StaticResource Caption}" />
                        </StackPanel>

                        <!-- Actions -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <!-- Save as theme with flyout -->
                            <Button Style="{StaticResource AccentButtonStyle}" Padding="12,6"
                                    ToolTipService.ToolTip="Aktuelle Beleuchtungseinstellungen als neues Theme speichern">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74E;" FontSize="14" />
                                    <TextBlock Text="Als Theme speichern" FontWeight="SemiBold" />
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout x:Name="SaveThemeFlyout">
                                        <StackPanel Spacing="12" Width="280">
                                            <TextBlock Text="Theme speichern" FontWeight="Bold" FontSize="14" />
                                            <TextBlock Text="Gib deinem Design einen Namen. Integrierte Standard-Designs können nicht überschrieben werden."
                                                       Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                            <TextBox x:Name="ThemeNameInput" PlaceholderText="Theme-Name (z. B. Neon Wave)"
                                                     KeyDown="ThemeNameInput_KeyDown" />
                                            <Button Style="{StaticResource AccentButtonStyle}" Content="Speichern &amp; Anwenden"
                                                    HorizontalAlignment="Stretch" Click="SaveThemeConfirm_Click" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <Button Style="{StaticResource SmoothButton}" Padding="10,6" Click="ImportTheme_Click"
                                    ToolTipService.ToolTip="Theme aus einer Datei (.json) importieren">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B5;" FontSize="14" />
                                    <TextBlock Text="Importieren" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Feedback message InfoBar -->
                    <InfoBar x:Name="ThemeResultInfo" IsOpen="False" IsClosable="True" Margin="0,0,0,4" />

                    <!-- Section 1: Eigene Themes (if any) -->
                    <StackPanel Spacing="10" Visibility="{x:Bind VisibleIfHasCustom(ViewModel.Lighting.CustomThemes.Count), Mode=OneWay}">
                        <TextBlock Text="Eigene Themes" Style="{StaticResource Overline}" FontSize="11" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Lighting.CustomThemes}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="240" MinItemHeight="56" MinColumnSpacing="10"
                                                   MinRowSpacing="10" ItemsStretch="Fill" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="services:CustomLightingTheme">
                                    <Border Background="{StaticResource SurfaceL2Brush}" BorderBrush="{StaticResource SurfaceStrokeSubtleBrush}"
                                            BorderThickness="1" CornerRadius="12" Padding="12,8">
                                        <Grid ColumnSpacing="10" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <!-- Theme Name and click to apply -->
                                            <Button Style="{StaticResource SmoothButton}" Background="Transparent" BorderThickness="0"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="0"
                                                    Click="CustomTheme_Click" Tag="{x:Bind}"
                                                    ToolTipService.ToolTip="Dieses Theme auf das GoXLR anwenden">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource BrandBrush}"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <FontIcon Glyph="&#xE790;" FontSize="12" Foreground="Black" />
                                                    </Border>
                                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="140" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Export button -->
                                            <Button Grid.Column="1" Style="{StaticResource SmoothButton}" Padding="8,6" CornerRadius="8"
                                                    Click="ExportCustomTheme_Click" Tag="{x:Bind}"
                                                    ToolTipService.ToolTip="Dieses Theme als Datei exportieren">
                                                <FontIcon Glyph="&#xEDE1;" FontSize="13" />
                                            </Button>

                                            <!-- Delete button -->
                                            <Button Grid.Column="2" Style="{StaticResource SmoothDangerButton}" Padding="8,6" CornerRadius="8"
                                                    Click="DeleteCustomTheme_Click" Tag="{x:Bind}"
                                                    ToolTipService.ToolTip="Theme löschen">
                                                <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <!-- Section 2: Integrierte Vorlagen -->
                    <StackPanel Spacing="10">
                        <TextBlock Text="Integrierte Vorlagen" Style="{StaticResource Overline}" FontSize="11" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Lighting.Themes}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="160" MinItemHeight="52" MinColumnSpacing="10"
                                                   MinRowSpacing="10" ItemsStretch="Fill" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:LightingTheme">
                                    <Button Style="{StaticResource SmoothButton}" HorizontalContentAlignment="Left" Padding="12,0"
                                            Click="Theme_Click" Tag="{x:Bind}">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Grid Width="26" Height="26">
                                                <Ellipse Fill="{x:Bind InactiveBrush}" />
                                                <Ellipse Width="16" Height="16" Fill="{x:Bind ActiveBrush}" />
                                            </Grid>
                                            <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Fader gradients: Colour 1 (bottom) to Colour 2 (top), live on the fader LEDs -->
            <Border Style="{StaticResource Card}" Visibility="{x:Bind ViewModel.Hardware.HasDevice, Mode=OneWay}">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE9E9;" FontSize="16" Foreground="{StaticResource BrandBrush}" />
                        <TextBlock x:Uid="LightFadersHeader" Style="{StaticResource SectionTitle}" />
                    </StackPanel>
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Lighting.Faders}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="260" MinItemHeight="262" MinColumnSpacing="12"
                                               MinRowSpacing="12" ItemsStretch="Fill" MaximumRowsOrColumns="4" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:LightingZoneViewModel">
                                <Grid Padding="16" CornerRadius="14" ColumnSpacing="16" Background="{StaticResource SurfaceL3Brush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Preview: the fader's LED strip with a cap, as the device will show it -->
                                    <Grid Width="34">
                                        <Border CornerRadius="17" Background="{x:Bind PreviewBrush, Mode=OneWay}"
                                                BorderBrush="#30FFFFFF" BorderThickness="1" />
                                        <Border Width="40" Height="16" CornerRadius="5" VerticalAlignment="Center"
                                                Background="#2E343F" BorderBrush="#5A6374" BorderThickness="1" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <Grid>
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <Button x:Uid="LightSwap" HorizontalAlignment="Right" Padding="6" Command="{x:Bind Swap}"
                                                    Background="Transparent" BorderThickness="0">
                                                <FontIcon Glyph="&#xE8AB;" FontSize="14" />
                                            </Button>
                                        </Grid>
                                        <Button Style="{StaticResource SwatchButton}" AutomationProperties.Name="{x:Bind ActiveLabel}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Width="22" Height="22" CornerRadius="6" Background="{x:Bind ActiveBrush, Mode=OneWay}"
                                                        BorderBrush="#30FFFFFF" BorderThickness="1" />
                                                <StackPanel>
                                                    <TextBlock Text="{x:Bind ActiveLabel}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Text="{x:Bind ActiveHex, Mode=OneWay}" FontSize="12" FontFamily="Consolas" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Button.Flyout>
                                                <Flyout Placement="Bottom">
                                                    <StackPanel Spacing="12" Width="300">
                                                        <ColorPicker Color="{x:Bind ActiveColor, Mode=TwoWay}" ColorSpectrumShape="Ring"
                                                                     IsAlphaEnabled="False" IsMoreButtonVisible="False"
                                                                     IsColorChannelTextInputVisible="False" IsHexInputVisible="True" />
                                                        <ItemsControl ItemsSource="{x:Bind ActivePalette}" ItemTemplate="{StaticResource PaletteItem}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="8" /></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                        <Button Style="{StaticResource SwatchButton}" AutomationProperties.Name="{x:Bind InactiveLabel}" IsEnabled="{x:Bind Gradient, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Width="22" Height="22" CornerRadius="6" Background="{x:Bind InactiveBrush, Mode=OneWay}"
                                                        BorderBrush="#30FFFFFF" BorderThickness="1" />
                                                <StackPanel>
                                                    <TextBlock Text="{x:Bind InactiveLabel}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Text="{x:Bind InactiveHex, Mode=OneWay}" FontSize="12" FontFamily="Consolas" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Button.Flyout>
                                                <Flyout Placement="Bottom">
                                                    <StackPanel Spacing="12" Width="300">
                                                        <ColorPicker Color="{x:Bind InactiveColor, Mode=TwoWay}" ColorSpectrumShape="Ring"
                                                                     IsAlphaEnabled="False" IsMoreButtonVisible="False"
                                                                     IsColorChannelTextInputVisible="False" IsHexInputVisible="True" />
                                                        <ItemsControl ItemsSource="{x:Bind InactivePalette}" ItemTemplate="{StaticResource PaletteItem}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="8" /></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                        <ToggleSwitch x:Uid="LightGradientToggle" IsOn="{x:Bind Gradient, Mode=TwoWay}" MinWidth="0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <!-- Zone groups: Faders, Buttons, Effects, Sampler, Global (only what this device has) -->
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Lighting.Groups}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="16" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:LightingGroupViewModel">
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Foreground="{StaticResource BrandBrush}" />
                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource SectionTitle}" />
                                </StackPanel>
                                <ItemsRepeater ItemsSource="{x:Bind Zones}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout MinItemWidth="300" MinItemHeight="96" MinColumnSpacing="12"
                                                           MinRowSpacing="12" ItemsStretch="Fill" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LightingZoneViewModel">
                                            <Grid Padding="14" CornerRadius="14" ColumnSpacing="14"
                                                  Background="{StaticResource SurfaceL3Brush}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <!-- Live preview of how the LED looks -->
                                                <Border Width="20" CornerRadius="10" Background="{x:Bind PreviewBrush, Mode=OneWay}"
                                                        BorderBrush="#30FFFFFF" BorderThickness="1" />
                                                <Grid Grid.Column="1" RowSpacing="8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <Grid Grid.Row="1" ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Button Style="{StaticResource SwatchButton}"
                                                                AutomationProperties.Name="{x:Bind ActiveLabel}">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <Border Width="22" Height="22" CornerRadius="6" Background="{x:Bind ActiveBrush, Mode=OneWay}"
                                                                        BorderBrush="#30FFFFFF" BorderThickness="1" />
                                                                <StackPanel>
                                                                    <TextBlock Text="{x:Bind ActiveLabel}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                                                    <TextBlock Text="{x:Bind ActiveHex, Mode=OneWay}" FontSize="12" FontFamily="Consolas" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <Button.Flyout>
                                                                <Flyout Placement="Bottom">
                                                                    <StackPanel Spacing="12" Width="300">
                                                                        <ColorPicker Color="{x:Bind ActiveColor, Mode=TwoWay}" ColorSpectrumShape="Ring"
                                                                                     IsAlphaEnabled="False" IsMoreButtonVisible="False"
                                                                                     IsColorChannelTextInputVisible="False" IsHexInputVisible="True" />
                                                                        <ItemsControl ItemsSource="{x:Bind ActivePalette}" ItemTemplate="{StaticResource PaletteItem}">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate><VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="8" /></ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                </Flyout>
                                                            </Button.Flyout>
                                                        </Button>
                                                        <Button Grid.Column="1" Style="{StaticResource SwatchButton}"
                                                                AutomationProperties.Name="{x:Bind InactiveLabel}">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <Border Width="22" Height="22" CornerRadius="6" Background="{x:Bind InactiveBrush, Mode=OneWay}"
                                                                        BorderBrush="#30FFFFFF" BorderThickness="1" />
                                                                <StackPanel>
                                                                    <TextBlock Text="{x:Bind InactiveLabel}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                                                    <TextBlock Text="{x:Bind InactiveHex, Mode=OneWay}" FontSize="12" FontFamily="Consolas" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <Button.Flyout>
                                                                <Flyout Placement="Bottom">
                                                                    <StackPanel Spacing="12" Width="300">
                                                                        <ColorPicker Color="{x:Bind InactiveColor, Mode=TwoWay}" ColorSpectrumShape="Ring"
                                                                                     IsAlphaEnabled="False" IsMoreButtonVisible="False"
                                                                                     IsColorChannelTextInputVisible="False" IsHexInputVisible="True" />
                                                                        <ItemsControl ItemsSource="{x:Bind InactivePalette}" ItemTemplate="{StaticResource PaletteItem}">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate><VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="8" /></ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                </Flyout>
                                                            </Button.Flyout>
                                                        </Button>
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

        </StackPanel>
    </ScrollViewer>
</Page>
