<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NextXLR.Views.VirtualChannelsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:NextXLR.Services"
    xmlns:vm="using:NextXLR.ViewModels"
    Background="{StaticResource SurfaceL1Brush}">

    <ScrollViewer Style="{StaticResource PageScroller}">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="24" MaxWidth="1100" HorizontalAlignment="Center">
            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Virtuelle Kanäle &amp; Windows-Audiospuren" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Übersicht aller GoXLR-Audiospuren in Windows, direktes App-Audio-Routing (Discord, Spotify, Games) und virtuelle Kabel-Integration."
                               Style="{StaticResource Caption}" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Style="{StaticResource AccentButtonStyle}" Click="ReSync_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE777;" FontSize="14" />
                            <TextBlock Text="Spuren aktualisieren" />
                        </StackPanel>
                    </Button>
                    <Button Click="OpenWindowsVolumeMixer_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7F6;" FontSize="14" />
                            <TextBlock Text="Windows Lautstärke-Mixer" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Card 1: Echte GoXLR Windows-Audiospuren -->
            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel Spacing="16">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE7F6;" Foreground="{StaticResource BrandBrush}" FontSize="18" />
                            <TextBlock Text="Offizielle GoXLR Windows-Audiospuren" Style="{StaticResource CardTitle}" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Click="OpenSoundControlPanel_Click" Padding="10,4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE713;" FontSize="12" />
                                <TextBlock Text="Sound-Systemsteuerung (mmsys.cpl)" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock Text="Der GoXLR-Treiber stellt in Windows fünf eigenständige Ausgabegeräte bereit. Diese Spuren werden von physischen GoXLR-Fadern und der internen Routing-Tabelle gesteuert:"
                               Style="{StaticResource Caption}" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />

                    <ItemsControl ItemsSource="{x:Bind Service.GoXlrTracks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="services:WindowsAudioTrackInfo">
                                <Border Background="{StaticResource SurfaceL2Brush}" CornerRadius="10" Padding="14,12" Margin="0,0,0,8"
                                        BorderBrush="{StaticResource SurfaceStrokeSubtleBrush}" BorderThickness="1">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource SurfaceL3Brush}"
                                                VerticalAlignment="Center">
                                            <FontIcon Glyph="{x:Bind Glyph}" Foreground="{StaticResource BrandBrush}" FontSize="16" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="{x:Bind ChannelKey}" FontSize="11" Foreground="{StaticResource BrandBrush}" FontWeight="Bold" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{x:Bind RoleDescription}" VerticalAlignment="Center"
                                                   Style="{StaticResource Caption}" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />

                                        <Border Grid.Column="3" Background="{StaticResource SurfaceL3Brush}" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Fill="{x:Bind StatusBrush}" />
                                                <TextBlock Text="{x:Bind StatusText}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{x:Bind StatusBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Card 2: Direktes App-Audio-Routing (Spotify, Discord, Games) -->
            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel Spacing="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8AB;" Foreground="{StaticResource BrandBrush}" FontSize="18" />
                                <TextBlock Text="Aktives Windows App-Audio-Routing (Lautstärkemixer)" Style="{StaticResource CardTitle}" />
                                <Border Background="{StaticResource SurfaceL3Brush}" BorderBrush="{StaticResource BrandBrush}" BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock Text="Aktiv" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrandBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Weise laufenden Anwendungen direkt eine GoXLR-Spur und das passende Mikrofon zu. Windows routet den Ton ohne Neustart der App auf das gewählte Audiogerät."
                                       Style="{StaticResource Caption}" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Style="{StaticResource AccentButtonStyle}" Padding="12,6" Click="AutoAssignApps_Click"
                                    ToolTipService.ToolTip="Ordnet bekannte Musik-, Chat- und Game-Apps automatisch den richtigen Kanälen zu">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B8;" FontSize="14" />
                                    <TextBlock Text="Auto-Zuweisung" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SmoothButton}" Padding="10,6" Click="ReSync_Click"
                                    ToolTipService.ToolTip="Aktive Anwendungen neu laden">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                            <Button Style="{StaticResource SmoothButton}" Padding="10,6" Click="OpenWindowsVolumeMixer_Click"
                                    ToolTipService.ToolTip="Windows Soundeinstellungen / Lautstärkemixer öffnen">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                                    <TextBlock Text="Windows-Mixer" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Animierter Lade-Indikator -->
                    <Border Background="{StaticResource SurfaceL2Brush}" CornerRadius="12" Padding="20"
                            Visibility="{x:Bind AppRouting.IsScanning, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center">
                            <ProgressRing IsActive="{x:Bind AppRouting.IsScanning, Mode=OneWay}"
                                          Width="24" Height="24" Foreground="{StaticResource BrandBrush}" />
                            <TextBlock Text="Scanne aktive Windows Audio-Sitzungen..." FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Wenn keine Apps Ton wiedergeben -->
                    <Border Visibility="{x:Bind AppRouting.HasNoApps, Mode=OneWay}"
                            Background="{StaticResource SurfaceL2Brush}" CornerRadius="12" Padding="28,24"
                            BorderBrush="{StaticResource SurfaceStrokeSubtleBrush}" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center" Spacing="8">
                            <FontIcon Glyph="&#xE995;" FontSize="28" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Keine aktiven Audio-Anwendungen gefunden" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Spiele Ton in einer App ab (z. B. Spotify, Discord oder im Browser), damit sie hier gesteuert und zugewiesen werden kann."
                                       Style="{StaticResource Caption}" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Apps Liste -->
                    <ItemsRepeater ItemsSource="{x:Bind AppRouting.AppSessions, Mode=OneWay}"
                                  Visibility="{x:Bind AppRouting.HasApps, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:AppSessionItemViewModel">
                                <Border Background="{StaticResource SurfaceL2Brush}" BorderBrush="{StaticResource SurfaceStrokeSubtleBrush}"
                                        BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,4">
                                    <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <!-- App info -->
                                            <ColumnDefinition Width="220" />
                                            <!-- Output channel selector -->
                                            <ColumnDefinition Width="200" />
                                            <!-- Input channel selector -->
                                            <ColumnDefinition Width="200" />
                                            <!-- Volume slider & peak meter -->
                                            <ColumnDefinition Width="*" MinWidth="140" />
                                            <!-- Mute button -->
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 1. App Icon and Name -->
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource SurfaceL3Brush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Glyph}" FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                           FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{StaticResource BrandBrush}" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="{x:Bind ProcessName}" FontWeight="SemiBold" FontSize="14"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="160" />
                                                <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource Caption}"
                                                           Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="160" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 2. Target GoXLR Endpoint Dropdown -->
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="Ausgabe-Kanal (GoXLR)" Style="{StaticResource Overline}" FontSize="10" />
                                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Bind OutputChoices}"
                                                      SelectedIndex="{x:Bind SelectedOutputIndex, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="services:AudioEndpointChoice">
                                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind Glyph}" FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                                       FontSize="14" VerticalAlignment="Center" />
                                                            <TextBlock Text="{x:Bind ShortName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- 3. Microphone Device (GoXLR Input) -->
                                        <StackPanel Grid.Column="2" Spacing="2">
                                            <TextBlock Text="Mikrofon-Eingang" Style="{StaticResource Overline}" FontSize="10" />
                                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Bind InputChoices}"
                                                      SelectedIndex="{x:Bind SelectedInputIndex, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="services:AudioEndpointChoice">
                                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind Glyph}" FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                                       FontSize="14" VerticalAlignment="Center" />
                                                            <TextBlock Text="{x:Bind ShortName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- 4. Volume Slider & Live Peak Meter -->
                                        <StackPanel Grid.Column="3" Spacing="2" VerticalAlignment="Center">
                                            <Grid>
                                                <TextBlock Text="App-Lautstärke" Style="{StaticResource Overline}" FontSize="10" />
                                                <TextBlock Text="{x:Bind VolumeText, Mode=OneWay}" HorizontalAlignment="Right"
                                                           Style="{StaticResource Caption}" FontWeight="SemiBold" />
                                            </Grid>
                                            <Slider Minimum="0" Maximum="100" StepFrequency="1"
                                                    Value="{x:Bind Volume, Mode=TwoWay}" Margin="0,-4,0,0" />
                                            <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind PeakPercent, Mode=OneWay}"
                                                         Height="3" CornerRadius="2" Margin="0,-2,0,0"
                                                         Foreground="{StaticResource BrandBrush}" Background="#15FFFFFF" />
                                        </StackPanel>

                                        <!-- 5. Mute Button -->
                                        <ToggleButton Grid.Column="4" Style="{StaticResource SmoothDangerToggle}"
                                                      IsChecked="{x:Bind IsMuted, Mode=TwoWay}"
                                                      Width="38" Height="38" Padding="0" CornerRadius="10"
                                                      ToolTipService.ToolTip="App stummschalten">
                                            <FontIcon Glyph="&#xE74F;" FontSize="14" />
                                        </ToggleButton>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <!-- Card 3: Zusätzliche Virtuelle Kabel (VB-CABLE / VoiceMeeter) -->
            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE7F4;" Foreground="{StaticResource BrandBrush}" FontSize="18" />
                        <TextBlock Text="Zusätzliche Virtuelle Audiokabel (Zusatz-Software)" Style="{StaticResource CardTitle}" />
                    </StackPanel>

                    <TextBlock Text="Für zusätzliche separate Tonspuren außerhalb der fünf Standard-GoXLR-Kanäle benötigt Windows einen virtuellen Audiotreiber (z. B. das kostenlose VB-CABLE von VB-Audio). Sobald installiert, erkennt NEXT : XLR das Kabel automatisch und leitet es in deinen Mix."
                               Style="{StaticResource Caption}" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />

                    <Border Background="{StaticResource SurfaceL2Brush}" CornerRadius="10" Padding="16"
                            BorderBrush="{StaticResource SurfaceStrokeSubtleBrush}" BorderThickness="1">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind Service.VirtualCableStatusText, Mode=OneTime}" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="VB-CABLE erstellt ein virtuelles Wiedergabegerät 'CABLE Input' und ein Aufnahmegerät 'CABLE Output' in Windows."
                                           Style="{StaticResource Caption}" Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Click="DownloadVbCable_Click" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE896;" FontSize="12" Foreground="{StaticResource BrandBrush}" />
                                    <TextBlock Text="VB-CABLE Website öffnen" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>