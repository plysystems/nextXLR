<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NextXLR.Views.VirtualChannelsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:NextXLR.Services"
    Background="{StaticResource SurfaceL1Brush}">

    <ScrollViewer Style="{StaticResource PageScroller}">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="24" MaxWidth="1100" HorizontalAlignment="Center">
            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Virtuelle Audiokanäle" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Erstelle und route unbegrenzt viele virtuelle Audiokabel unabhängig von physischen Anschlüssen."
                               Style="{StaticResource Caption}" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="ReSync_Click" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE777;" FontSize="14" />
                        <TextBlock Text="Kabel neu synchronisieren" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Card 1: Add New Virtual Channel -->
            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE710;" Foreground="{StaticResource BrandBrush}" FontSize="16" />
                        <TextBlock Text="Neues virtuelles Audiokabel erstellen" Style="{StaticResource CardTitle}" />
                    </StackPanel>
                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ChannelNameBox" Header="Kabel-Bezeichnung" PlaceholderText="z.B. Virtueller Browser" />
                        <ComboBox x:Name="TargetChannelCombo" Grid.Column="1" Header="GoXLR-Zielkanal" HorizontalAlignment="Stretch" SelectedIndex="0">
                            <ComboBoxItem Content="Music" />
                            <ComboBoxItem Content="Game" />
                            <ComboBoxItem Content="Chat" />
                            <ComboBoxItem Content="System" />
                            <ComboBoxItem Content="Sample" />
                            <ComboBoxItem Content="Line In" />
                        </ComboBox>
                        <ComboBox x:Name="BufferSizeCombo" Grid.Column="2" Header="Puffer / Latenz" HorizontalAlignment="Stretch" SelectedIndex="1">
                            <ComboBoxItem Content="64 (1.3 ms)" />
                            <ComboBoxItem Content="128 (2.7 ms)" />
                            <ComboBoxItem Content="256 (5.3 ms)" />
                            <ComboBoxItem Content="512 (10.7 ms)" />
                        </ComboBox>
                        <Button Grid.Column="3" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" Height="36" Click="AddChannel_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B5;" FontSize="14" />
                                <TextBlock Text="Erstellen" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 2: Active Virtual Channels List -->
            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel Spacing="16">
                    <Grid>
                        <TextBlock Text="Aktive virtuelle Endpunkte" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{x:Bind VirtualChannelsCountText, Mode=OneWay}" HorizontalAlignment="Right"
                                   Style="{StaticResource Caption}" Foreground="{StaticResource BrandBrush}" FontWeight="SemiBold" />
                    </Grid>

                    <ItemsControl ItemsSource="{x:Bind Service.Channels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="services:VirtualChannelItem">
                                <Border Background="{StaticResource SurfaceL2Brush}" CornerRadius="12" Padding="16,14" Margin="0,0,0,10"
                                        BorderBrush="{StaticResource SurfaceStrokeSubtleBrush}" BorderThickness="1">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" MinWidth="180" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Icon -->
                                        <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource SurfaceL3Brush}"
                                                BorderBrush="{StaticResource SurfaceStrokeBrush}" BorderThickness="1"
                                                VerticalAlignment="Center">
                                            <FontIcon Glyph="{x:Bind Glyph}" Foreground="{StaticResource BrandBrush}" FontSize="18" />
                                        </Border>

                                        <!-- Name & Badges -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Background="{StaticResource SurfaceL3Brush}" CornerRadius="6" Padding="6,2">
                                                    <TextBlock Text="{x:Bind FormatText, Mode=OneWay}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                                </Border>
                                                <Border Background="{StaticResource SurfaceL3Brush}" CornerRadius="6" Padding="6,2">
                                                    <TextBlock Text="{x:Bind LatencyText, Mode=OneWay}" FontSize="11" Foreground="{StaticResource BrandBrush}" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- GoXLR Target Channel ComboBox -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="GoXLR-Kanal" Style="{StaticResource Caption}" Foreground="{StaticResource TextMutedBrush}" />
                                            <ComboBox ItemsSource="{x:Bind TargetOptions}"
                                                      SelectedItem="{x:Bind TargetChannel, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch" />
                                        </StackPanel>

                                        <!-- Volume Slider -->
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                                            <Grid>
                                                <TextBlock Text="Lautstärke" Style="{StaticResource Caption}" />
                                                <TextBlock Text="{x:Bind VolumeLabel, Mode=OneWay}" HorizontalAlignment="Right"
                                                           Style="{StaticResource Caption}" FontFamily="Consolas" Foreground="{StaticResource BrandBrush}" />
                                            </Grid>
                                            <Slider Minimum="0" Maximum="150" StepFrequency="1" Value="{x:Bind VolumePercent, Mode=TwoWay}" />
                                        </StackPanel>

                                        <!-- Toggle Status -->
                                        <ToggleSwitch Grid.Column="4" IsOn="{x:Bind IsActive, Mode=TwoWay}"
                                                      OnContent="Aktiv" OffContent="Mute" MinWidth="0" VerticalAlignment="Center" Margin="10,0" />

                                        <!-- Delete -->
                                        <Button Grid.Column="5" Padding="8" Background="Transparent" BorderThickness="0"
                                                VerticalAlignment="Center" Tag="{x:Bind}" Click="DeleteChannel_Click"
                                                ToolTipService.ToolTip="Kabel entfernen">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{StaticResource DangerBrush}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Card 3: Engine Architecture & Diagnostics -->
            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="Treiber-Architektur &amp; Status" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Die virtuelle Kabel-Engine verarbeitet Audioströme im Ringpuffer ohne zusätzliche Systembelastung. Programme wie Spotify, Chrome oder Discord können diese Kabel direkt als Ein- oder Ausgangsgerät wählen."
                               Style="{StaticResource Caption}" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="20" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource SurfaceL2Brush}" CornerRadius="8" Padding="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Treiber-Status" Style="{StaticResource Caption}" />
                                <TextBlock Text="Aktiv (WDM / KS)" FontWeight="Bold" Foreground="{StaticResource BrandBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{StaticResource SurfaceL2Brush}" CornerRadius="8" Padding="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Sampling-Engine" Style="{StaticResource Caption}" />
                                <TextBlock Text="48.0 kHz 32-Bit Float" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{StaticResource SurfaceL2Brush}" CornerRadius="8" Padding="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Durchschnitts-Jitter" Style="{StaticResource Caption}" />
                                <TextBlock Text="&lt; 0.4 ms (Zero-Drop)" FontWeight="Bold" Foreground="{StaticResource BrandBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
