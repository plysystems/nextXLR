<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NextXLR.Views.EffectsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NextXLR.ViewModels"
    xmlns:controls="using:NextXLR.Controls"
    Background="{ThemeResource SurfaceL1Brush}">

    <ScrollViewer Style="{StaticResource PageScroller}">
        <StackPanel Spacing="24" MaxWidth="1320" HorizontalAlignment="Center">
            <StackPanel Spacing="6">
                <TextBlock x:Uid="FxTitle" Style="{StaticResource PageTitle}" />
            </StackPanel>


            <!-- FX master + presets: the top row of the GoXLR effects section -->
            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="FxMasterHeader" Style="{StaticResource Overline}" />
                        <ToggleButton x:Uid="FxMasterToggle" Height="96" Style="{StaticResource TileToggle}"
                                      IsChecked="{x:Bind Fx.FxEnabled, Mode=TwoWay}">
                            <StackPanel Spacing="6">
                                <FontIcon Glyph="&#xE945;" FontSize="22" />
                                <TextBlock Text="FX" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="10">
                        <TextBlock x:Uid="FxPresetsHeader" Style="{StaticResource Overline}" />
                        <ItemsRepeater ItemsSource="{x:Bind Fx.Presets}">
                            <ItemsRepeater.Layout>
                                <!-- Six presets share the row; wrap to 3×2 when narrow -->
                                <UniformGridLayout MinItemWidth="76" MinItemHeight="96" MinColumnSpacing="10"
                                                   MinRowSpacing="10" MaximumRowsOrColumns="6" ItemsStretch="Fill" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:PresetViewModel">
                                    <ToggleButton Style="{StaticResource TileToggle}"
                                                  IsChecked="{x:Bind IsActive, Mode=TwoWay}"
                                                  AutomationProperties.Name="{x:Bind Label}">
                                        <StackPanel Spacing="2">
                                            <!-- Inherits the toggle's foreground so it stays readable when checked. -->
                                            <TextBlock x:Uid="FxPresetLabel" FontSize="12" Opacity="0.7"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="{x:Bind Label}" FontSize="26" FontWeight="Bold"
                                                       FontFamily="{StaticResource DisplayFont}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Encoders as rotary knobs -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="18">
                    <StackPanel Spacing="2">
                        <TextBlock x:Uid="FxVoiceHeader" Style="{StaticResource SectionTitle}" />
                    </StackPanel>
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:Knob x:Uid="KnobReverb" Minimum="0" Maximum="100" Step="4.1666667" DefaultValue="25" Unit="%"
                                       Value="{x:Bind Fx.Reverb, Mode=TwoWay}" Accent="{StaticResource BrandBrush}" />
                        <controls:Knob x:Uid="KnobEcho" Grid.Column="1" Minimum="0" Maximum="100" Step="4.1666667" DefaultValue="12.5" Unit="%"
                                       Value="{x:Bind Fx.Echo, Mode=TwoWay}" Accent="{StaticResource BrandBrush}" />
                        <controls:Knob x:Uid="KnobPitch" Grid.Column="2" Minimum="-24" Maximum="24" DefaultValue="0" Bipolar="True"
                                       Value="{x:Bind Fx.Pitch, Mode=TwoWay}" Accent="{StaticResource WarningBrush}" />
                        <controls:Knob x:Uid="KnobGender" Grid.Column="3" Minimum="-24" Maximum="24" DefaultValue="0" Bipolar="True"
                                       Value="{x:Bind Fx.Gender, Mode=TwoWay}" Accent="{StaticResource WarningBrush}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Hardware FX toggles, each with its detail settings (collapsed when off) -->
            <StackPanel Spacing="12">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Megaphone -->
                    <Border Style="{StaticResource Card}" VerticalAlignment="Stretch">
                        <StackPanel Spacing="14">
                            <ToggleButton x:Uid="FxMegaphoneToggle" Height="88" Style="{StaticResource TileToggle}"
                                          HorizontalAlignment="Stretch" IsChecked="{x:Bind Fx.Megaphone, Mode=TwoWay}">
                                <StackPanel Spacing="8">
                                    <FontIcon Glyph="&#xE789;" FontSize="24" />
                                    <TextBlock x:Uid="FxMegaphoneLabel" HorizontalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <StackPanel Spacing="14" Visibility="{x:Bind BoolToVisibility(Fx.Megaphone), Mode=OneWay}">
                                <Slider x:Uid="FxMegAmount" Minimum="0" Maximum="100" StepFrequency="1"
                                        Value="{x:Bind Fx.MegaphoneAmount, Mode=TwoWay}" />
                                <Slider x:Uid="FxMegPostGain" Minimum="-20" Maximum="20" StepFrequency="1"
                                        Value="{x:Bind Fx.MegaphonePostGain, Mode=TwoWay}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Robot (vocoder + synth) -->
                    <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Stretch">
                        <StackPanel Spacing="14">
                            <ToggleButton x:Uid="FxRobotToggle" Height="88" Style="{StaticResource TileToggle}"
                                          HorizontalAlignment="Stretch" IsChecked="{x:Bind Fx.Robot, Mode=TwoWay}">
                                <StackPanel Spacing="8">
                                    <FontIcon Glyph="&#xE99A;" FontSize="24" />
                                    <TextBlock x:Uid="FxRobotLabel" HorizontalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <StackPanel Spacing="14" Visibility="{x:Bind BoolToVisibility(Fx.Robot), Mode=OneWay}">
                                <ComboBox x:Uid="FxRobotWave" HorizontalAlignment="Stretch" ItemsSource="{x:Bind Fx.RobotWaveforms}"
                                          SelectedIndex="{x:Bind Fx.RobotWaveform, Mode=TwoWay}" />
                                <Slider x:Uid="FxRobotPulse" Minimum="0" Maximum="100" StepFrequency="1"
                                        Value="{x:Bind Fx.RobotPulseWidth, Mode=TwoWay}" />
                                <Slider x:Uid="FxRobotThreshold" Minimum="-36" Maximum="0" StepFrequency="1"
                                        Value="{x:Bind Fx.RobotThreshold, Mode=TwoWay}" />
                                <Slider x:Uid="FxRobotDry" Minimum="-36" Maximum="0" StepFrequency="1"
                                        Value="{x:Bind Fx.RobotDryMix, Mode=TwoWay}" />
                                <TextBlock x:Uid="FxRobotBands" Style="{StaticResource Caption}" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Uid="FxRobotLow" Minimum="-12" Maximum="12" StepFrequency="1"
                                            Value="{x:Bind Fx.RobotLowGain, Mode=TwoWay}" />
                                    <Slider x:Uid="FxRobotMid" Grid.Column="1" Minimum="-12" Maximum="12" StepFrequency="1"
                                            Value="{x:Bind Fx.RobotMidGain, Mode=TwoWay}" />
                                    <Slider x:Uid="FxRobotHigh" Grid.Column="2" Minimum="-12" Maximum="12" StepFrequency="1"
                                            Value="{x:Bind Fx.RobotHighGain, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Hardtune -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Stretch">
                        <StackPanel Spacing="14">
                            <ToggleButton x:Uid="FxHardtuneToggle" Height="88" Style="{StaticResource TileToggle}"
                                          HorizontalAlignment="Stretch" IsChecked="{x:Bind Fx.Hardtune, Mode=TwoWay}">
                                <StackPanel Spacing="8">
                                    <FontIcon Glyph="&#xE8D6;" FontSize="24" />
                                    <TextBlock x:Uid="FxHardtuneLabel" HorizontalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <StackPanel Spacing="14" Visibility="{x:Bind BoolToVisibility(Fx.Hardtune), Mode=OneWay}">
                                <Slider x:Uid="FxTuneAmount" Minimum="0" Maximum="100" StepFrequency="1"
                                        Value="{x:Bind Fx.HardtuneAmount, Mode=TwoWay}" />
                                <Slider x:Uid="FxTuneRate" Minimum="0" Maximum="100" StepFrequency="1"
                                        Value="{x:Bind Fx.HardtuneRate, Mode=TwoWay}" />
                                <Slider x:Uid="FxTuneWindow" Minimum="0" Maximum="600" StepFrequency="1"
                                        Value="{x:Bind Fx.HardtuneWindow, Mode=TwoWay}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
