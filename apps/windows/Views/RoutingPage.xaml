<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NextXLR.Views.RoutingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NextXLR.ViewModels"
    xmlns:services="using:NextXLR.Services"
    Background="Transparent">

    <!--
      GoXLR routing table. Rows (inputs): Mic, Chat, Music, Game, Console, Line In, System, Samples.
      Columns (outputs): Headphones, Broadcast Stream Mix, Line Out, Chat Mic.
      The Sampler (recording input of the sampler) is a separate, highlighted column on the right.
    -->
    <ScrollViewer Style="{StaticResource PageScroller}">
        <StackPanel Spacing="24" MaxWidth="1240" HorizontalAlignment="Center">
            <StackPanel Spacing="6">
                <TextBlock x:Uid="RoutingTitle" Style="{StaticResource PageTitle}" />
            </StackPanel>


            <Border Style="{StaticResource Card}" Padding="20,18">
                <StackPanel Spacing="4">
                    <!-- Header -->
                    <Grid ColumnSpacing="16" Padding="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="132" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Bottom" Padding="0,0,0,12" Spacing="2">
                        </StackPanel>
                        <ItemsRepeater Grid.Column="1" ItemsSource="{x:Bind ViewModel.Buses}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="64" MinItemHeight="74" MinColumnSpacing="10"
                                                   MaximumRowsOrColumns="4" ItemsStretch="Fill" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:BusView">
                                    <StackPanel Spacing="6" Padding="0,0,0,12">
                                        <Border Width="36" Height="36" CornerRadius="12" Background="{StaticResource SurfaceL3Brush}">
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Foreground="{StaticResource BrandBrush}" />
                                        </Border>
                                        <TextBlock Text="{x:Bind Name}" FontSize="12" FontWeight="SemiBold"
                                                   TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <!-- Sampler: separate, highlighted -->
                        <Border Grid.Column="2" CornerRadius="12,12,0,0" Background="#1F2A2F" Padding="0,8,0,12"
                                BorderBrush="#2E4A45" BorderThickness="1,1,1,0">
                            <StackPanel Spacing="6">
                                <Border Width="36" Height="36" CornerRadius="12" Background="#26403B">
                                    <FontIcon Glyph="&#xE7C8;" FontSize="16" Foreground="{StaticResource WarningBrush}" />
                                </Border>
                                <TextBlock Text="{x:Bind ViewModel.SamplerBusName, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                           TextAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Rows -->
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.RouteRows}">
                        <ItemsRepeater.Layout><StackLayout Spacing="0" /></ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:RouteRowViewModel">
                                <Grid ColumnSpacing="16" Padding="12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="132" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Input name + standard outputs, with a row highlight on hover -->
                                    <Border Grid.ColumnSpan="2" Margin="-12,0,0,0" CornerRadius="12" Background="Transparent"
                                            PointerEntered="Row_PointerEntered" PointerExited="Row_PointerExited">
                                        <Border.BackgroundTransition><BrushTransition Duration="0:0:0.2" /></Border.BackgroundTransition>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <Border Width="30" Height="30" CornerRadius="15" Background="{x:Bind Accent}">
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" Foreground="#0E1015" />
                                        </Border>
                                        <TextBlock Text="{x:Bind ChannelName}" VerticalAlignment="Center" FontSize="14"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="118" />
                                    </StackPanel>
                                    <ItemsRepeater Grid.Column="1" ItemsSource="{x:Bind Cells}" Margin="0,5">
                                        <ItemsRepeater.Layout>
                                            <UniformGridLayout MinItemWidth="64" MinItemHeight="44" MinColumnSpacing="10"
                                                               MaximumRowsOrColumns="4" ItemsStretch="Fill" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RouteCellViewModel">
                                                <ToggleButton Style="{StaticResource SmoothToggle}" CornerRadius="10"
                                                              IsChecked="{x:Bind IsRouted, Mode=TwoWay}" IsEnabled="{x:Bind IsEnabled}"
                                                              ToolTipService.ToolTip="{x:Bind Tooltip}"
                                                              AutomationProperties.Name="{x:Bind Tooltip}">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="16" Visibility="{x:Bind IsRouted, Mode=OneWay}" />
                                                </ToggleButton>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                    <!-- Sampler column -->
                                    <Border Grid.Column="2" Background="#1F2A2F" BorderBrush="#2E4A45" BorderThickness="1,0,1,0"
                                            Padding="12,5">
                                        <ToggleButton Style="{StaticResource SmoothToggle}" CornerRadius="10" Height="44"
                                                      IsChecked="{x:Bind SamplerCell.IsRouted, Mode=TwoWay}"
                                                      IsEnabled="{x:Bind SamplerCell.IsEnabled}"
                                                      ToolTipService.ToolTip="{x:Bind SamplerCell.Tooltip}"
                                                      AutomationProperties.Name="{x:Bind SamplerCell.Tooltip}">
                                            <FontIcon Glyph="&#xE7C8;" FontSize="14" Visibility="{x:Bind SamplerCell.IsRouted, Mode=OneWay}" />
                                        </ToggleButton>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <!-- Close the Sampler column -->
                    <Grid ColumnSpacing="16" Padding="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="132" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="2" Height="10" CornerRadius="0,0,12,12" Background="#1F2A2F"
                                BorderBrush="#2E4A45" BorderThickness="1,0,1,1" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== Windows App-Routing & Lautstärkemixer ===== -->
            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel Spacing="16">
                    <!-- Header with title, description, and action buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7F6;" FontSize="18" Foreground="{StaticResource BrandBrush}" />
                                <TextBlock Text="Windows App-Routing &amp; Lautstärkemixer" Style="{StaticResource SectionTitle}" />
                            </StackPanel>
                            <TextBlock Text="Weise deinen Anwendungen (Spotify, Discord, Spiele, Browser) direkt ihren GoXLR-Kanal und das passende Mikrofon zu."
                                       Style="{StaticResource Caption}" />
                        </StackPanel>

                        <!-- Actions -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Style="{StaticResource AccentButtonStyle}" Padding="12,6" Click="AutoAssignApps_Click"
                                    ToolTipService.ToolTip="Ordnet bekannte Musik-, Chat- und Game-Apps automatisch den richtigen Kanälen zu">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B8;" FontSize="14" />
                                    <TextBlock Text="Auto-Zuweisung" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SmoothButton}" Padding="10,6" Click="RefreshAppRouting_Click"
                                    ToolTipService.ToolTip="Aktive Anwendungen neu laden">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                            <Button Style="{StaticResource SmoothButton}" Padding="10,6" Click="OpenWindowsMixer_Click"
                                    ToolTipService.ToolTip="Windows Soundeinstellungen / Lautstärkemixer öffnen">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                                    <TextBlock Text="Windows-Mixer" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Status InfoBar -->
                    <InfoBar Severity="Informational" IsOpen="True" IsClosable="False"
                             Message="{x:Bind ViewModel.AppRouting.StatusMessage, Mode=OneWay}" />

                    <!-- App sessions list -->
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.AppRouting.AppSessions}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:AppSessionItemViewModel">
                                <Border Background="{StaticResource SurfaceL2Brush}" BorderBrush="{StaticResource SurfaceStrokeSubtleBrush}"
                                        BorderThickness="1" CornerRadius="12" Padding="14,10">
                                    <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <!-- App info -->
                                            <ColumnDefinition Width="220" />
                                            <!-- Output channel selector -->
                                            <ColumnDefinition Width="220" />
                                            <!-- Input channel selector -->
                                            <ColumnDefinition Width="220" />
                                            <!-- Volume slider -->
                                            <ColumnDefinition Width="*" MinWidth="140" />
                                            <!-- Mute button -->
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 1. App Icon and Name -->
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource SurfaceL3Brush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Glyph}" FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                           FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{StaticResource BrandBrush}" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="{x:Bind ProcessName}" FontWeight="SemiBold" FontSize="14"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="160" />
                                                <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource Caption}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="160" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 2. Output Device (GoXLR Channel) -->
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="Ausgabe-Kanal (GoXLR)" Style="{StaticResource Overline}" FontSize="10" />
                                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Bind OutputChoices}"
                                                      SelectedIndex="{x:Bind SelectedOutputIndex, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="services:AudioEndpointChoice">
                                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind Glyph}" FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                                       FontSize="14" VerticalAlignment="Center" />
                                                            <TextBlock Text="{x:Bind ShortName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- 3. Microphone Device (GoXLR Input) -->
                                        <StackPanel Grid.Column="2" Spacing="2">
                                            <TextBlock Text="Mikrofon-Eingang" Style="{StaticResource Overline}" FontSize="10" />
                                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Bind InputChoices}"
                                                      SelectedIndex="{x:Bind SelectedInputIndex, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="services:AudioEndpointChoice">
                                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind Glyph}" FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                                       FontSize="14" VerticalAlignment="Center" />
                                                            <TextBlock Text="{x:Bind ShortName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- 4. Volume slider -->
                                        <StackPanel Grid.Column="3" Spacing="2" VerticalAlignment="Center">
                                            <Grid>
                                                <TextBlock Text="App-Lautstärke" Style="{StaticResource Overline}" FontSize="10" />
                                                <TextBlock Text="{x:Bind Volume, Mode=OneWay}" HorizontalAlignment="Right"
                                                           Style="{StaticResource Caption}" />
                                            </Grid>
                                            <Slider Minimum="0" Maximum="100" StepFrequency="1"
                                                    Value="{x:Bind Volume, Mode=TwoWay}" Margin="0,-4,0,0" />
                                        </StackPanel>

                                        <!-- 5. Mute toggle button -->
                                        <ToggleButton Grid.Column="4" Style="{StaticResource SmoothDangerToggle}"
                                                      IsChecked="{x:Bind IsMuted, Mode=TwoWay}"
                                                      Width="38" Height="38" Padding="0" CornerRadius="10"
                                                      ToolTipService.ToolTip="App stummschalten">
                                            <FontIcon Glyph="&#xE74F;" FontSize="14" />
                                        </ToggleButton>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
