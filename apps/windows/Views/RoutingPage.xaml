<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NextXLR.Views.RoutingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NextXLR.ViewModels"
    xmlns:services="using:NextXLR.Services"
    Background="Transparent">

    <!--
      GoXLR routing table. Rows (inputs): Mic, Chat, Music, Game, Console, Line In, System, Samples.
      Columns (outputs): Headphones, Broadcast Stream Mix, Line Out, Chat Mic.
      The Sampler (recording input of the sampler) is a separate, highlighted column on the right.
    -->
    <ScrollViewer Style="{StaticResource PageScroller}">
        <StackPanel Spacing="24" MaxWidth="1240" HorizontalAlignment="Center">
            <StackPanel Spacing="6">
                <TextBlock x:Uid="RoutingTitle" Style="{StaticResource PageTitle}" />
            </StackPanel>


            <Border Style="{StaticResource Card}" Padding="20,18">
                <StackPanel Spacing="4">
                    <!-- Header -->
                    <Grid ColumnSpacing="16" Padding="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="132" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Bottom" Padding="0,0,0,12" Spacing="2">
                        </StackPanel>
                        <ItemsRepeater Grid.Column="1" ItemsSource="{x:Bind ViewModel.Buses}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout Orientation="Horizontal" MinItemWidth="30" MinItemHeight="74" MinColumnSpacing="8"
                                                   MaximumRowsOrColumns="{x:Bind ViewModel.RoutingColumnCount, Mode=OneWay}" ItemsStretch="Fill" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:BusView">
                                    <StackPanel Spacing="6" Padding="0,0,0,12" HorizontalAlignment="Stretch">
                                        <Border Width="36" Height="36" CornerRadius="12" Background="{StaticResource SurfaceL3Brush}" HorizontalAlignment="Center">
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Foreground="{StaticResource BrandBrush}" />
                                        </Border>
                                        <TextBlock Text="{x:Bind Name}" FontSize="11" FontWeight="SemiBold"
                                                   TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <!-- Sampler: separate, highlighted -->
                        <Border Grid.Column="2" CornerRadius="12,12,0,0" Background="#1F2A2F" Padding="0,8,0,12"
                                BorderBrush="#2E4A45" BorderThickness="1,1,1,0">
                            <StackPanel Spacing="6">
                                <Border Width="36" Height="36" CornerRadius="12" Background="#26403B">
                                    <FontIcon Glyph="&#xE7C8;" FontSize="16" Foreground="{StaticResource WarningBrush}" />
                                </Border>
                                <TextBlock Text="{x:Bind ViewModel.SamplerBusName, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                           TextAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Rows -->
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.RouteRows}">
                        <ItemsRepeater.Layout><StackLayout Spacing="0" /></ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:RouteRowViewModel">
                                <Grid ColumnSpacing="16" Padding="12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="132" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Input name + standard outputs, with a row highlight on hover -->
                                    <Border Grid.ColumnSpan="2" Margin="-12,0,0,0" CornerRadius="12" Background="Transparent"
                                            PointerEntered="Row_PointerEntered" PointerExited="Row_PointerExited">
                                        <Border.BackgroundTransition><BrushTransition Duration="0:0:0.2" /></Border.BackgroundTransition>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <Border Width="30" Height="30" CornerRadius="15" Background="{x:Bind Accent}">
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" Foreground="#0E1015" />
                                        </Border>
                                        <TextBlock Text="{x:Bind ChannelName}" VerticalAlignment="Center" FontSize="14"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="118" />
                                    </StackPanel>
                                    <ItemsRepeater Grid.Column="1" ItemsSource="{x:Bind Cells}" Margin="0,5">
                                        <ItemsRepeater.Layout>
                                            <UniformGridLayout Orientation="Horizontal" MinItemWidth="30" MinItemHeight="44" MinColumnSpacing="8"
                                                               MaximumRowsOrColumns="{x:Bind ColumnCount}" ItemsStretch="Fill" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RouteCellViewModel">
                                                <ToggleButton Style="{StaticResource SmoothToggle}" CornerRadius="10" IsThreeState="False"
                                                              IsChecked="{x:Bind IsRouted, Mode=TwoWay}" IsEnabled="{x:Bind IsEnabled}"
                                                              ToolTipService.ToolTip="{x:Bind Tooltip}"
                                                              AutomationProperties.Name="{x:Bind Tooltip}">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="16" Visibility="{x:Bind IsRouted, Mode=OneWay}" />
                                                </ToggleButton>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                    <!-- Sampler column -->
                                    <Border Grid.Column="2" Background="#1F2A2F" BorderBrush="#2E4A45" BorderThickness="1,0,1,0"
                                            Padding="12,5">
                                        <ToggleButton Style="{StaticResource SmoothToggle}" CornerRadius="10" Height="44" IsThreeState="False"
                                                      IsChecked="{x:Bind SamplerCell.IsRouted, Mode=TwoWay}"
                                                      IsEnabled="{x:Bind SamplerCell.IsEnabled}"
                                                      ToolTipService.ToolTip="{x:Bind SamplerCell.Tooltip}"
                                                      AutomationProperties.Name="{x:Bind SamplerCell.Tooltip}">
                                            <FontIcon Glyph="&#xE7C8;" FontSize="14" Visibility="{x:Bind SamplerCell.IsRouted, Mode=OneWay}" />
                                        </ToggleButton>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <!-- Close the Sampler column -->
                    <Grid ColumnSpacing="16" Padding="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="132" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="2" Height="10" CornerRadius="0,0,12,12" Background="#1F2A2F"
                                BorderBrush="#2E4A45" BorderThickness="1,0,1,1" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== Feature 02: Auto-Ducking ===== -->
            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel Spacing="16">
                    <!-- Header with Title, Status Badge, and On/Off Toggle -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7F5;" FontSize="18" Foreground="{StaticResource BrandBrush}" />
                                <TextBlock Text="Auto-Ducking" Style="{StaticResource SectionTitle}" />
                                <Border Background="{StaticResource SurfaceL3Brush}" BorderBrush="{StaticResource BrandBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind AutoDucking.StatusText, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrandBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Senkt Hintergrundmusik oder Spiele automatisch ab, sobald du sprichst (Sidechain-Ducking)."
                                       Style="{StaticResource Caption}" />
                        </StackPanel>

                        <!-- Master Toggle -->
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind AutoDucking.IsEnabled, Mode=TwoWay}"
                                      OnContent="Aktiv" OffContent="Bypass" MinWidth="0" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Control Grid: Channels Selection &amp; Ducking Parameters -->
                    <Grid ColumnSpacing="20" RowSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Column 1: Trigger &amp; Target Channel ComboBoxes -->
                        <Border Background="{StaticResource SurfaceL2Brush}" CornerRadius="12" Padding="14,12"
                                BorderBrush="{StaticResource SurfaceStrokeSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Signal-Zuweisung" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrandBrush}" />
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Sprach-Quelle (Trigger):" Style="{StaticResource Caption}" />
                                    <ComboBox ItemsSource="{x:Bind AutoDucking.AvailableTriggerChannels}"
                                              SelectedItem="{x:Bind AutoDucking.TriggerChannel, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Zu dämpfender Kanal (Ziel):" Style="{StaticResource Caption}" />
                                    <ComboBox ItemsSource="{x:Bind AutoDucking.AvailableTargetChannels}"
                                              SelectedItem="{x:Bind AutoDucking.TargetChannel, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Column 2: Ducking Amount (Absenkung) -->
                        <Border Grid.Column="1" Background="{StaticResource SurfaceL2Brush}" CornerRadius="12" Padding="14,12"
                                BorderBrush="{StaticResource SurfaceStrokeSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <TextBlock Text="Dämpfung (Tiefe)" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="{x:Bind AutoDucking.DuckAmountLabel, Mode=OneWay}" HorizontalAlignment="Right"
                                               FontFamily="{StaticResource DisplayFont}" Foreground="{StaticResource BrandBrush}" FontWeight="Bold" />
                                </Grid>
                                <Slider Minimum="-30" Maximum="-6" StepFrequency="1"
                                        Value="{x:Bind AutoDucking.DuckAmountDb, Mode=TwoWay}" />
                                <TextBlock Text="Wie stark das Ziel gedämpft wird" Style="{StaticResource Caption}" Foreground="{StaticResource TextMutedBrush}" />
                                <!-- Live Gain Reduction Indicator -->
                                <StackPanel Spacing="2" Margin="0,4,0,0">
                                    <TextBlock Text="Aktuelle Reduktion:" Style="{StaticResource Overline}" FontSize="9" />
                                    <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind AutoDucking.DuckReductionPercent, Mode=OneWay}"
                                                 Height="4" CornerRadius="2" Foreground="{StaticResource WarningBrush}" Background="{StaticResource SurfaceL3Brush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Column 3: Threshold (Ansprechschwelle) -->
                        <Border Grid.Column="2" Background="{StaticResource SurfaceL2Brush}" CornerRadius="12" Padding="14,12"
                                BorderBrush="{StaticResource SurfaceStrokeSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <TextBlock Text="Schwelle (Trigger)" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="{x:Bind AutoDucking.ThresholdLabel, Mode=OneWay}" HorizontalAlignment="Right"
                                               FontFamily="{StaticResource DisplayFont}" Foreground="{StaticResource BrandBrush}" FontWeight="Bold" />
                                </Grid>
                                <Slider Minimum="-50" Maximum="-15" StepFrequency="1"
                                        Value="{x:Bind AutoDucking.ThresholdDb, Mode=TwoWay}" />
                                <TextBlock Text="Ab welchem Sprachpegel Ducking startet" Style="{StaticResource Caption}" Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Column 4: Hold &amp; Release Timers -->
                        <Border Grid.Column="3" Background="{StaticResource SurfaceL2Brush}" CornerRadius="12" Padding="14,12"
                                BorderBrush="{StaticResource SurfaceStrokeSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <TextBlock Text="Haltezeit (Hold)" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="{x:Bind AutoDucking.HoldLabel, Mode=OneWay}" HorizontalAlignment="Right"
                                               FontFamily="{StaticResource DisplayFont}" Foreground="{StaticResource BrandBrush}" FontWeight="Bold" />
                                </Grid>
                                <Slider Minimum="100" Maximum="2000" StepFrequency="50"
                                        Value="{x:Bind AutoDucking.HoldMs, Mode=TwoWay}" />
                                <Grid Margin="0,2,0,0">
                                    <TextBlock Text="Abklingzeit (Release)" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="{x:Bind AutoDucking.ReleaseLabel, Mode=OneWay}" HorizontalAlignment="Right"
                                               FontFamily="{StaticResource DisplayFont}" Foreground="{StaticResource BrandBrush}" FontWeight="Bold" />
                                </Grid>
                                <Slider Minimum="100" Maximum="1500" StepFrequency="50"
                                        Value="{x:Bind AutoDucking.ReleaseMs, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== Windows Lautstärkemixer ===== -->
            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel Spacing="16">
                    <!-- Header with title, description, and action buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7F6;" FontSize="18" Foreground="{StaticResource BrandBrush}" />
                                <TextBlock Text="Windows Lautstärkemixer" Style="{StaticResource SectionTitle}" />
                                <Border Background="{StaticResource SurfaceL3Brush}" BorderBrush="{StaticResource BrandBrush}" BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock Text="Aktiv" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrandBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Weise deinen Anwendungen (Spotify, Discord, Spiele, Browser) direkt ihren GoXLR-Kanal und das passende Mikrofon zu."
                                       Style="{StaticResource Caption}" />
                        </StackPanel>

                        <!-- Actions -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Style="{StaticResource AccentButtonStyle}" Padding="12,6" Click="AutoAssignApps_Click"
                                    ToolTipService.ToolTip="Ordnet bekannte Musik-, Chat- und Game-Apps automatisch den richtigen Kanälen zu">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B8;" FontSize="14" />
                                    <TextBlock Text="Auto-Zuweisung" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SmoothButton}" Padding="10,6" Click="RefreshAppRouting_Click"
                                    ToolTipService.ToolTip="Aktive Anwendungen neu laden">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                            <Button Style="{StaticResource SmoothButton}" Padding="10,6" Click="OpenWindowsMixer_Click"
                                    ToolTipService.ToolTip="Windows Soundeinstellungen / Lautstärkemixer öffnen">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                                    <TextBlock Text="Windows-Mixer" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Animierter Lade-Indikator für Windows Lautstärkemixer -->
                    <Border Background="{StaticResource SurfaceL2Brush}" CornerRadius="12" Padding="20"
                            Visibility="{x:Bind ViewModel.AppRouting.IsScanning, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center">
                            <ProgressRing IsActive="{x:Bind ViewModel.AppRouting.IsScanning, Mode=OneWay}"
                                          Width="24" Height="24" Foreground="{StaticResource BrandBrush}" />
                            <TextBlock Text="Scanne aktive Windows Audio-Sitzungen..." FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Empty State Wenn keine Apps aktiv sind -->
                    <Border Background="{StaticResource SurfaceL2Brush}" CornerRadius="12" Padding="28,24"
                            Visibility="{x:Bind ViewModel.AppRouting.HasNoApps, Mode=OneWay}">
                        <StackPanel HorizontalAlignment="Center" Spacing="8">
                            <FontIcon Glyph="&#xE995;" FontSize="28" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Keine aktiven Audio-Anwendungen gefunden" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Spiele Ton in einer App ab (z. B. Spotify, Discord oder im Browser), damit sie hier gesteuert und zugewiesen werden kann."
                                       Style="{StaticResource Caption}" HorizontalAlignment="Center" TextAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- App sessions list -->
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.AppRouting.AppSessions}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:AppSessionItemViewModel">
                                <Border Background="{StaticResource SurfaceL2Brush}" BorderBrush="{StaticResource SurfaceStrokeSubtleBrush}"
                                        BorderThickness="1" CornerRadius="12" Padding="14,10">
                                    <Grid ColumnSpacing="16" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <!-- App info -->
                                            <ColumnDefinition Width="220" />
                                            <!-- Output channel selector -->
                                            <ColumnDefinition Width="220" />
                                            <!-- Input channel selector -->
                                            <ColumnDefinition Width="220" />
                                            <!-- Volume slider & peak meter -->
                                            <ColumnDefinition Width="*" MinWidth="140" />
                                            <!-- Mute button -->
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 1. App Icon and Name -->
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource SurfaceL3Brush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Glyph}" FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                           FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{StaticResource BrandBrush}" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="{x:Bind ProcessName}" FontWeight="SemiBold" FontSize="14"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="160" />
                                                <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource Caption}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="160" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 2. Output Device (GoXLR Channel) -->
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="Ausgabe-Kanal (GoXLR)" Style="{StaticResource Overline}" FontSize="10" />
                                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Bind OutputChoices}"
                                                      SelectedIndex="{x:Bind SelectedOutputIndex, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="services:AudioEndpointChoice">
                                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind Glyph}" FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                                       FontSize="14" VerticalAlignment="Center" />
                                                            <TextBlock Text="{x:Bind ShortName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- 3. Microphone Device (GoXLR Input) -->
                                        <StackPanel Grid.Column="2" Spacing="2">
                                            <TextBlock Text="Mikrofon-Eingang" Style="{StaticResource Overline}" FontSize="10" />
                                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Bind InputChoices}"
                                                      SelectedIndex="{x:Bind SelectedInputIndex, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="services:AudioEndpointChoice">
                                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind Glyph}" FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                                       FontSize="14" VerticalAlignment="Center" />
                                                            <TextBlock Text="{x:Bind ShortName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- 4. Volume slider & Live Peak Meter -->
                                        <StackPanel Grid.Column="3" Spacing="2" VerticalAlignment="Center">
                                            <Grid>
                                                <TextBlock Text="App-Lautstärke" Style="{StaticResource Overline}" FontSize="10" />
                                                <TextBlock Text="{x:Bind VolumeText, Mode=OneWay}" HorizontalAlignment="Right"
                                                           Style="{StaticResource Caption}" FontWeight="SemiBold" />
                                            </Grid>
                                            <Slider Minimum="0" Maximum="100" StepFrequency="1"
                                                    Value="{x:Bind Volume, Mode=TwoWay}" Margin="0,-4,0,0" />
                                            <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind PeakPercent, Mode=OneWay}"
                                                         Height="3" CornerRadius="2" Margin="0,-2,0,0"
                                                         Foreground="{StaticResource BrandBrush}" Background="#15FFFFFF" />
                                        </StackPanel>

                                        <!-- 5. Mute toggle button -->
                                        <ToggleButton Grid.Column="4" Style="{StaticResource SmoothDangerToggle}"
                                                      IsChecked="{x:Bind IsMuted, Mode=TwoWay}"
                                                      Width="38" Height="38" Padding="0" CornerRadius="10"
                                                      ToolTipService.ToolTip="App stummschalten">
                                            <FontIcon Glyph="&#xE74F;" FontSize="14" />
                                        </ToggleButton>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
