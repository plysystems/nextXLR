<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NextXLR.Views.RoutingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NextXLR.ViewModels"
    Background="Transparent">

    <!--
      GoXLR routing table. Rows (inputs): Mic, Chat, Music, Game, Console, Line In, System, Samples.
      Columns (outputs): Headphones, Broadcast Stream Mix, Line Out, Chat Mic.
      The Sampler (recording input of the sampler) is a separate, highlighted column on the right.
    -->
    <ScrollViewer Style="{StaticResource PageScroller}">
        <StackPanel Spacing="24" MaxWidth="1240" HorizontalAlignment="Center">
            <StackPanel Spacing="6">
                <TextBlock x:Uid="RoutingTitle" Style="{StaticResource PageTitle}" />
            </StackPanel>


            <Border Style="{StaticResource Card}" Padding="20,18">
                <StackPanel Spacing="4">
                    <!-- Header -->
                    <Grid ColumnSpacing="16" Padding="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="132" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Bottom" Padding="0,0,0,12" Spacing="2">
                        </StackPanel>
                        <ItemsRepeater Grid.Column="1" ItemsSource="{x:Bind ViewModel.Buses}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="64" MinItemHeight="74" MinColumnSpacing="10"
                                                   MaximumRowsOrColumns="4" ItemsStretch="Fill" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:BusView">
                                    <StackPanel Spacing="6" Padding="0,0,0,12">
                                        <Border Width="36" Height="36" CornerRadius="12" Background="{StaticResource SurfaceL3Brush}">
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Foreground="{StaticResource BrandBrush}" />
                                        </Border>
                                        <TextBlock Text="{x:Bind Name}" FontSize="12" FontWeight="SemiBold"
                                                   TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <!-- Sampler: separate, highlighted -->
                        <Border Grid.Column="2" CornerRadius="12,12,0,0" Background="#1F2A2F" Padding="0,8,0,12"
                                BorderBrush="#2E4A45" BorderThickness="1,1,1,0">
                            <StackPanel Spacing="6">
                                <Border Width="36" Height="36" CornerRadius="12" Background="#26403B">
                                    <FontIcon Glyph="&#xE7C8;" FontSize="16" Foreground="{StaticResource WarningBrush}" />
                                </Border>
                                <TextBlock Text="{x:Bind ViewModel.SamplerBusName, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                           TextAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Rows -->
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.RouteRows}">
                        <ItemsRepeater.Layout><StackLayout Spacing="0" /></ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:RouteRowViewModel">
                                <Grid ColumnSpacing="16" Padding="12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="132" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Input name + standard outputs, with a row highlight on hover -->
                                    <Border Grid.ColumnSpan="2" Margin="-12,0,0,0" CornerRadius="12" Background="Transparent"
                                            PointerEntered="Row_PointerEntered" PointerExited="Row_PointerExited">
                                        <Border.BackgroundTransition><BrushTransition Duration="0:0:0.2" /></Border.BackgroundTransition>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <Border Width="30" Height="30" CornerRadius="15" Background="{x:Bind Accent}">
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" Foreground="#0E1015" />
                                        </Border>
                                        <TextBlock Text="{x:Bind ChannelName}" VerticalAlignment="Center" FontSize="14"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="118" />
                                    </StackPanel>
                                    <ItemsRepeater Grid.Column="1" ItemsSource="{x:Bind Cells}" Margin="0,5">
                                        <ItemsRepeater.Layout>
                                            <UniformGridLayout MinItemWidth="64" MinItemHeight="44" MinColumnSpacing="10"
                                                               MaximumRowsOrColumns="4" ItemsStretch="Fill" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RouteCellViewModel">
                                                <ToggleButton Style="{StaticResource SmoothToggle}" CornerRadius="10"
                                                              IsChecked="{x:Bind IsRouted, Mode=TwoWay}" IsEnabled="{x:Bind IsEnabled}"
                                                              ToolTipService.ToolTip="{x:Bind Tooltip}"
                                                              AutomationProperties.Name="{x:Bind Tooltip}">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="16" Visibility="{x:Bind IsRouted, Mode=OneWay}" />
                                                </ToggleButton>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                    <!-- Sampler column -->
                                    <Border Grid.Column="2" Background="#1F2A2F" BorderBrush="#2E4A45" BorderThickness="1,0,1,0"
                                            Padding="12,5">
                                        <ToggleButton Style="{StaticResource SmoothToggle}" CornerRadius="10" Height="44"
                                                      IsChecked="{x:Bind SamplerCell.IsRouted, Mode=TwoWay}"
                                                      IsEnabled="{x:Bind SamplerCell.IsEnabled}"
                                                      ToolTipService.ToolTip="{x:Bind SamplerCell.Tooltip}"
                                                      AutomationProperties.Name="{x:Bind SamplerCell.Tooltip}">
                                            <FontIcon Glyph="&#xE7C8;" FontSize="14" Visibility="{x:Bind SamplerCell.IsRouted, Mode=OneWay}" />
                                        </ToggleButton>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <!-- Close the Sampler column -->
                    <Grid ColumnSpacing="16" Padding="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="132" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="2" Height="10" CornerRadius="0,0,12,12" Background="#1F2A2F"
                                BorderBrush="#2E4A45" BorderThickness="1,0,1,1" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
