<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NextXLR.Views.RoutingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NextXLR.ViewModels"
    xmlns:services="using:NextXLR.Services"
    Background="Transparent">

    <!--
      GoXLR routing table. Rows (inputs): Mic, Chat, Music, Game, Console, Line In, System, Samples.
      Columns (outputs): Headphones, Broadcast Stream Mix, Line Out, Chat Mic.
      The Sampler (recording input of the sampler) is a separate, highlighted column on the right.
    -->
    <ScrollViewer Style="{StaticResource PageScroller}">
        <StackPanel Spacing="20" MaxWidth="1320" HorizontalAlignment="Center">
            
            <!-- Studio Cockpit Header: Title & Subtitle -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3" VerticalAlignment="Center">
                    <TextBlock x:Uid="RoutingTitle" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
                    <TextBlock Text="Ultra-Low-Latency Signalverteilung: Verbinde Audioquellen (Mikrofon, Chat, Musik, Game, System) flexibel mit physischen und virtuellen Ausgängen."
                               Style="{StaticResource Caption}" Foreground="{ThemeResource TextMutedBrush}" />
                </StackPanel>

                <!-- Quick Legend / Status Indicator -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Background="{ThemeResource SurfaceL2Brush}" BorderBrush="{ThemeResource SurfaceStrokeSubtleBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource BrandBrush}" />
                            <TextBlock Text="Aktiv Geroutet" FontSize="11" Foreground="{ThemeResource TextMutedBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Background="{ThemeResource SurfaceL2Brush}" BorderBrush="{ThemeResource SurfaceStrokeSubtleBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource WarningBrush}" />
                            <TextBlock Text="Sampler Record" FontSize="11" Foreground="{ThemeResource TextMutedBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Main Routing Matrix Glass Card -->
            <Border Background="{ThemeResource GlassCardBackgroundBrush}" CornerRadius="16"
                    BorderBrush="{ThemeResource GlassCardBorderBrush}" BorderThickness="1" Padding="22,18">
                <StackPanel Spacing="6">
                    <!-- Matrix Cockpit Subheader Bar -->
                    <Grid Padding="12,0,12,12">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8AB;" FontSize="14" Foreground="{StaticResource BrandBrush}" />
                            <TextBlock Text="KREUZSCHIENEN-SIGNALMATRIX" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrandBrush}" />
                            <TextBlock Text="•" Foreground="{ThemeResource TextMutedBrush}" />
                            <TextBlock Text="Echtzeit-Hardware-Routing mit 0 ms Latenz" FontSize="11" Foreground="{ThemeResource TextMutedBrush}" />
                        </StackPanel>
                        <TextBlock Text="Klicke auf eine Zelle, um die Audio-Verbindung ein- oder auszuschalten"
                                   HorizontalAlignment="Right" FontSize="11" Foreground="{ThemeResource TextMutedBrush}" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Column Headers -->
                    <Grid ColumnSpacing="16" Padding="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="132" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Bottom" Padding="0,0,0,12" Spacing="2">
                            <TextBlock Text="EINGANGS-KANAL" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextMutedBrush}" />
                        </StackPanel>
                        <ItemsRepeater Grid.Column="1" ItemsSource="{x:Bind ViewModel.Buses}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout Orientation="Horizontal" MinItemWidth="30" MinItemHeight="74" MinColumnSpacing="8"
                                                   MaximumRowsOrColumns="{x:Bind ViewModel.RoutingColumnCount, Mode=OneWay}" ItemsStretch="Fill" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:BusView">
                                    <StackPanel Spacing="6" Padding="0,0,0,12" HorizontalAlignment="Stretch">
                                        <Border Width="38" Height="38" CornerRadius="12" Background="{ThemeResource SurfaceL3Brush}" HorizontalAlignment="Center">
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Foreground="{StaticResource BrandBrush}" />
                                        </Border>
                                        <TextBlock Text="{x:Bind Name}" FontSize="11" FontWeight="SemiBold"
                                                   TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <!-- Sampler: separate, highlighted -->
                        <Border Grid.Column="2" CornerRadius="12,12,0,0" Background="{ThemeResource SurfaceL3Brush}" Padding="0,8,0,12"
                                BorderBrush="{ThemeResource SurfaceStrokeBrush}" BorderThickness="1,1,1,0">
                            <StackPanel Spacing="6">
                                <Border Width="38" Height="38" CornerRadius="12" Background="{ThemeResource SurfaceL2Brush}">
                                    <FontIcon Glyph="&#xE7C8;" FontSize="16" Foreground="{StaticResource WarningBrush}" />
                                </Border>
                                <TextBlock Text="{x:Bind ViewModel.SamplerBusName, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                           TextAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Routing Rows -->
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.RouteRows}">
                        <ItemsRepeater.Layout><StackLayout Spacing="0" /></ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:RouteRowViewModel">
                                <Grid ColumnSpacing="16" Padding="12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="132" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Input name + standard outputs, with a row highlight on hover -->
                                    <Border Grid.ColumnSpan="2" Margin="-12,0,0,0" CornerRadius="12" Background="Transparent"
                                            PointerEntered="Row_PointerEntered" PointerExited="Row_PointerExited">
                                        <Border.BackgroundTransition><BrushTransition Duration="0:0:0.2" /></Border.BackgroundTransition>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <Border Width="32" Height="32" CornerRadius="16" Background="{x:Bind Accent}">
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" Foreground="#0E1015" />
                                        </Border>
                                        <TextBlock Text="{x:Bind ChannelName}" VerticalAlignment="Center" FontSize="14"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="118" />
                                    </StackPanel>
                                    <ItemsRepeater Grid.Column="1" ItemsSource="{x:Bind Cells}" Margin="0,5">
                                        <ItemsRepeater.Layout>
                                            <UniformGridLayout Orientation="Horizontal" MinItemWidth="30" MinItemHeight="44" MinColumnSpacing="8"
                                                               MaximumRowsOrColumns="{x:Bind ColumnCount}" ItemsStretch="Fill" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RouteCellViewModel">
                                                <ToggleButton Style="{StaticResource SmoothToggle}" CornerRadius="10" IsThreeState="False"
                                                              IsChecked="{x:Bind IsRouted, Mode=TwoWay}" IsEnabled="{x:Bind IsEnabled}"
                                                              services:CursorHelper.UseHandCursor="True"
                                                              ToolTipService.ToolTip="{x:Bind Tooltip}"
                                                              AutomationProperties.Name="{x:Bind Tooltip}">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="16" Visibility="{x:Bind IsRouted, Mode=OneWay}" />
                                                </ToggleButton>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                    <!-- Sampler column -->
                                    <Border Grid.Column="2" Background="{ThemeResource SurfaceL3Brush}" BorderBrush="{ThemeResource SurfaceStrokeBrush}" BorderThickness="1,0,1,0"
                                            Padding="12,5">
                                        <ToggleButton Style="{StaticResource SmoothToggle}" CornerRadius="10" Height="44" IsThreeState="False"
                                                      IsChecked="{x:Bind SamplerCell.IsRouted, Mode=TwoWay}"
                                                      IsEnabled="{x:Bind SamplerCell.IsEnabled}"
                                                      services:CursorHelper.UseHandCursor="True"
                                                      ToolTipService.ToolTip="{x:Bind SamplerCell.Tooltip}"
                                                      AutomationProperties.Name="{x:Bind SamplerCell.Tooltip}">
                                            <FontIcon Glyph="&#xE7C8;" FontSize="14" Visibility="{x:Bind SamplerCell.IsRouted, Mode=OneWay}" />
                                        </ToggleButton>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <!-- Close the Sampler column -->
                    <Grid ColumnSpacing="16" Padding="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="132" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="2" Height="10" CornerRadius="0,0,12,12" Background="{ThemeResource SurfaceL3Brush}"
                                BorderBrush="{ThemeResource SurfaceStrokeBrush}" BorderThickness="1,0,1,1" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== Optimized Auto-Ducking Studio Card ===== -->
            <Border Background="{ThemeResource GlassCardBackgroundBrush}" CornerRadius="16"
                    BorderBrush="{ThemeResource GlassCardBorderBrush}" BorderThickness="1" Padding="22,20">
                <StackPanel Spacing="18">
                    <!-- Header with Title, Status Badge, Presets, and Master Toggle -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7F5;" FontSize="18" Foreground="{StaticResource BrandBrush}" />
                                <TextBlock Text="Intelligentes Auto-Ducking (Sidechain-Spracherkennung)" Style="{StaticResource SectionTitle}" />
                                <Border Background="{ThemeResource SurfaceL3Brush}" BorderBrush="{StaticResource BrandBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind AutoDucking.StatusText, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrandBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Senkt Hintergrundmusik oder Spielsound automatisch ab, sobald du ins Mikrofon sprichst."
                                       Style="{StaticResource Caption}" />
                        </StackPanel>

                        <!-- 1-Click Ducking Presets -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,20,0">
                            <Button Content="Podcast (-18 dB)" Style="{StaticResource SmoothButton}" Tag="podcast" Click="AutoDuckingPreset_Click"
                                    Padding="12,6" services:CursorHelper.UseHandCursor="True" ToolTipService.ToolTip="Starke Absenkung, schneller Wiedereinstieg für Moderatoren" />
                            <Button Content="Gaming (-12 dB)" Style="{StaticResource SmoothButton}" Tag="gaming" Click="AutoDuckingPreset_Click"
                                    Padding="12,6" services:CursorHelper.UseHandCursor="True" ToolTipService.ToolTip="Optimale Absenkung mit stabiler Haltezeit zwischen Callouts" />
                            <Button Content="Subtil (-6 dB)" Style="{StaticResource SmoothButton}" Tag="subtle" Click="AutoDuckingPreset_Click"
                                    Padding="12,6" services:CursorHelper.UseHandCursor="True" ToolTipService.ToolTip="Sanfte Hintergrund-Dämpfung" />
                        </StackPanel>

                        <!-- Master Toggle -->
                        <ToggleSwitch Grid.Column="2" IsOn="{x:Bind AutoDucking.IsEnabled, Mode=TwoWay}"
                                      OnContent="Aktiv" OffContent="Bypass" MinWidth="0" VerticalAlignment="Center"
                                      services:CursorHelper.UseHandCursor="True" />
                    </Grid>

                    <!-- Visual Signal Chain Flow Indicator -->
                    <Border Background="{ThemeResource SurfaceL3Brush}" CornerRadius="12" Padding="18,12"
                            BorderBrush="{ThemeResource SurfaceStrokeSubtleBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Step 1: Trigger -->
                            <StackPanel Spacing="3" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE720;" FontSize="13" Foreground="{StaticResource BrandBrush}" />
                                    <TextBlock Text="1. SPRACH-TRIGGER" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextMutedBrush}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind AutoDucking.TriggerChannel, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Foreground="{ThemeResource TextPrimaryBrush}" />
                            </StackPanel>

                            <!-- Arrow 1 -->
                            <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="13" Foreground="{ThemeResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0" />

                            <!-- Step 2: Threshold Detektor -->
                            <StackPanel Grid.Column="2" Spacing="3" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE9D9;" FontSize="13" Foreground="{StaticResource BrandBrush}" />
                                    <TextBlock Text="2. SCHWELLE" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextMutedBrush}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind AutoDucking.ThresholdLabel, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Foreground="{StaticResource BrandBrush}" />
                            </StackPanel>

                            <!-- Arrow 2 -->
                            <FontIcon Grid.Column="3" Glyph="&#xE76C;" FontSize="13" Foreground="{ThemeResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0" />

                            <!-- Step 3: Absenkung -->
                            <StackPanel Grid.Column="4" Spacing="3" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE7F5;" FontSize="13" Foreground="{StaticResource WarningBrush}" />
                                    <TextBlock Text="3. ABSENKUNG" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextMutedBrush}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind AutoDucking.DuckAmountLabel, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Foreground="{StaticResource WarningBrush}" />
                            </StackPanel>

                            <!-- Arrow 3 -->
                            <FontIcon Grid.Column="5" Glyph="&#xE76C;" FontSize="13" Foreground="{ThemeResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0" />

                            <!-- Step 4: Ziel-Kanal -->
                            <StackPanel Grid.Column="6" Spacing="3" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE767;" FontSize="13" Foreground="{StaticResource BrandBrush}" />
                                    <TextBlock Text="4. ZIEL-KANAL" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextMutedBrush}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind AutoDucking.TargetChannel, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Foreground="{ThemeResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Control Grid: Channel Selection & Parameters with Ample Breathing Room -->
                    <Grid ColumnSpacing="16" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" MinWidth="260" />
                            <ColumnDefinition Width="*" MinWidth="220" />
                            <ColumnDefinition Width="*" MinWidth="220" />
                            <ColumnDefinition Width="1.2*" MinWidth="260" />
                        </Grid.ColumnDefinitions>

                        <!-- Column 1: Signalweg (Trigger ➔ Target) -->
                        <Border Background="{ThemeResource SurfaceL2Brush}" CornerRadius="12" Padding="16,14"
                                BorderBrush="{ThemeResource SurfaceStrokeSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8AB;" FontSize="13" Foreground="{StaticResource BrandBrush}" />
                                    <TextBlock Text="Signalweg-Routing" FontWeight="SemiBold" FontSize="12" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Sprach-Quelle (Trigger):" Style="{StaticResource Caption}" />
                                    <ComboBox ItemsSource="{x:Bind AutoDucking.AvailableTriggerChannels}"
                                              SelectedItem="{x:Bind AutoDucking.TriggerChannel, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch" services:CursorHelper.UseHandCursor="True" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Ziel-Kanal (gedämpft):" Style="{StaticResource Caption}" />
                                    <ComboBox ItemsSource="{x:Bind AutoDucking.AvailableTargetChannels}"
                                              SelectedItem="{x:Bind AutoDucking.TargetChannel, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch" services:CursorHelper.UseHandCursor="True" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Column 2: Ducking Amount (Absenkung) -->
                        <Border Grid.Column="1" Background="{ThemeResource SurfaceL2Brush}" CornerRadius="12" Padding="16,14"
                                BorderBrush="{ThemeResource SurfaceStrokeSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <TextBlock Text="Absenkung (Tiefe):" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="{x:Bind AutoDucking.DuckAmountLabel, Mode=OneWay}" HorizontalAlignment="Right"
                                               Foreground="{StaticResource BrandBrush}" FontWeight="Bold" />
                                </Grid>
                                <Slider Minimum="-30" Maximum="-6" StepFrequency="1"
                                        Value="{x:Bind AutoDucking.DuckAmountDb, Mode=TwoWay}"
                                        services:CursorHelper.UseHandCursor="True" />
                                <TextBlock Text="Wie tief die Musik abgesenkt wird" Style="{StaticResource Caption}" Foreground="{ThemeResource TextMutedBrush}" />
                                
                                <!-- Live Gain Reduction Indicator -->
                                <StackPanel Spacing="3" Margin="0,6,0,0">
                                    <Grid>
                                        <TextBlock Text="Aktuelle Pegelabsenkung:" Style="{StaticResource Overline}" FontSize="9" />
                                        <TextBlock Text="{x:Bind AutoDucking.CurrentAttenuationDbLabel, Mode=OneWay}"
                                                   HorizontalAlignment="Right" FontSize="10" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" />
                                    </Grid>
                                    <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind AutoDucking.DuckReductionPercent, Mode=OneWay}"
                                                 Height="6" CornerRadius="3" Foreground="{StaticResource WarningBrush}" Background="{ThemeResource SurfaceL3Brush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Column 3: Threshold (Ansprechschwelle) -->
                        <Border Grid.Column="2" Background="{ThemeResource SurfaceL2Brush}" CornerRadius="12" Padding="16,14"
                                BorderBrush="{ThemeResource SurfaceStrokeSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <TextBlock Text="Schwelle (Trigger):" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="{x:Bind AutoDucking.ThresholdLabel, Mode=OneWay}" HorizontalAlignment="Right"
                                               Foreground="{StaticResource BrandBrush}" FontWeight="Bold" />
                                </Grid>
                                <Slider Minimum="-50" Maximum="-15" StepFrequency="1"
                                        Value="{x:Bind AutoDucking.ThresholdDb, Mode=TwoWay}"
                                        services:CursorHelper.UseHandCursor="True" />
                                <TextBlock Text="Ab welchem Sprachpegel Ducking anspringt" Style="{StaticResource Caption}" Foreground="{ThemeResource TextMutedBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Column 4: Hold & Release Timers -->
                        <Border Grid.Column="3" Background="{ThemeResource SurfaceL2Brush}" CornerRadius="12" Padding="16,14"
                                BorderBrush="{ThemeResource SurfaceStrokeSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <Grid>
                                    <TextBlock Text="Haltezeit (Hold):" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="{x:Bind AutoDucking.HoldLabel, Mode=OneWay}" HorizontalAlignment="Right"
                                               Foreground="{StaticResource BrandBrush}" FontWeight="Bold" />
                                </Grid>
                                <Slider Minimum="100" Maximum="2000" StepFrequency="50"
                                        Value="{x:Bind AutoDucking.HoldMs, Mode=TwoWay}"
                                        services:CursorHelper.UseHandCursor="True" />
                                <Grid Margin="0,2,0,0">
                                    <TextBlock Text="Abklingzeit (Release):" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="{x:Bind AutoDucking.ReleaseLabel, Mode=OneWay}" HorizontalAlignment="Right"
                                               Foreground="{StaticResource BrandBrush}" FontWeight="Bold" />
                                </Grid>
                                <Slider Minimum="100" Maximum="1500" StepFrequency="50"
                                        Value="{x:Bind AutoDucking.ReleaseMs, Mode=TwoWay}"
                                        services:CursorHelper.UseHandCursor="True" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
