<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NextXLR.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:NextXLR.Services"
    xmlns:views="using:NextXLR.Views"
    Background="{ThemeResource SurfaceL1Brush}">

    <Page.Resources>
        <!-- A settings row: icon, title + description, control on the right. -->
        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="ColumnSpacing" Value="16" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{ThemeResource SurfaceL2Brush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Page.Resources>

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="20" MaxWidth="1120" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Uid="SettingsTitle" Style="{StaticResource PageTitle}" />

        <!-- Side navigation; collapses to a top bar on narrow windows (see VisualStateManager). -->
        <Grid x:Name="Body" Grid.Row="1" ColumnSpacing="28" RowSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavColumn" Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ListView x:Name="SectionList" Grid.RowSpan="2" SelectionMode="Single" SelectionChanged="SectionList_SelectionChanged">
                <ListViewItem Tag="general" IsSelected="True">
                    <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE713;" FontSize="16" /><TextBlock x:Uid="SettingsNavGeneralText" /></StackPanel>
                </ListViewItem>
                <ListViewItem Tag="audio">
                    <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE7F6;" FontSize="16" /><TextBlock Text="Audio &amp; Treiber" /></StackPanel>
                </ListViewItem>
                <ListViewItem Tag="streamdeck">
                    <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE93C;" FontSize="16" /><TextBlock Text="Stream Deck &amp; API" /></StackPanel>
                </ListViewItem>
                <ListViewItem Tag="profiles">
                    <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE77B;" FontSize="16" /><TextBlock x:Uid="SettingsNavProfilesText" /></StackPanel>
                </ListViewItem>
                <ListViewItem Tag="updates" Visibility="Visible">
                    <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE895;" FontSize="16" /><TextBlock x:Uid="SettingsNavUpdatesText" /></StackPanel>
                </ListViewItem>
                <ListViewItem Tag="help">
                    <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE897;" FontSize="16" /><TextBlock x:Uid="SettingsNavHelpText" /></StackPanel>
                </ListViewItem>
            </ListView>

            <ScrollViewer x:Name="ContentScroller" Grid.Column="1" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto">
                <Grid HorizontalAlignment="Stretch">
                    <!-- ===== General ===== -->
                    <StackPanel x:Name="GeneralPanel" Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="SettingsGeneralHeader" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Passe Erscheinungsbild, Autostart-Verhalten und Windows-Systemintegration an." Style="{StaticResource Caption}" />
                        </StackPanel>

                        <!-- Card 1: Erscheinungsbild & Design -->
                        <Border Background="{ThemeResource SurfaceL2Brush}" CornerRadius="14"
                                BorderBrush="{ThemeResource SurfaceStrokeBrush}" BorderThickness="1" Padding="20,16">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="10" Background="{ThemeResource SurfaceL3Brush}">
                                    <FontIcon Glyph="&#xE790;" FontSize="18" Foreground="{StaticResource BrandBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Erscheinungsbild &amp; Design" FontWeight="SemiBold" FontSize="15" />
                                    <TextBlock Text="Wähle zwischen Studio Dark (Obsidian), Studio Light (Nordic) oder System." Style="{StaticResource Caption}" />
                                </StackPanel>
                                <ComboBox x:Name="ThemeComboBox" Grid.Column="2" MinWidth="160" VerticalAlignment="Center"
                                          SelectionChanged="ThemeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Dunkel (Obsidian)" Tag="Dark" />
                                    <ComboBoxItem Content="Hell (Nordic Studio)" Tag="Light" />
                                    <ComboBoxItem Content="System-Standard" Tag="System" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Card 2: Systemverhalten & Autostart -->
                        <Border Background="{ThemeResource SurfaceL2Brush}" CornerRadius="14"
                                BorderBrush="{ThemeResource SurfaceStrokeBrush}" BorderThickness="1" Padding="0">
                            <StackPanel>
                                <!-- Row 1: Mit Windows starten -->
                                <Grid Padding="20,14" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource SurfaceL3Brush}">
                                        <FontIcon Glyph="&#xE7E8;" FontSize="16" Foreground="{ThemeResource TextPrimaryBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Uid="SetAutostartTitle" FontWeight="SemiBold" />
                                        <TextBlock Text="Startet NEXT : XLR automatisch beim Hochfahren des PCs." Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="AutostartToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="Autostart_Toggled" />
                                </Grid>

                                <Border Height="1" Background="{ThemeResource SurfaceStrokeSubtleBrush}" Margin="68,0,20,0" />

                                <!-- Row 2: In den Infobereich minimieren -->
                                <Grid Padding="20,14" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource SurfaceL3Brush}">
                                        <FontIcon Glyph="&#xE921;" FontSize="16" Foreground="{ThemeResource TextPrimaryBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Uid="SetTrayTitle" FontWeight="SemiBold" />
                                        <TextBlock Text="Schließen-Button (X) minimiert die App in den Windows Infobereich." Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="TrayToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="Tray_Toggled" />
                                </Grid>

                                <Border Height="1" Background="{ThemeResource SurfaceStrokeSubtleBrush}" Margin="68,0,20,0" />

                                <!-- Row 3: Minimiert starten -->
                                <Grid Padding="20,14" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource SurfaceL3Brush}">
                                        <FontIcon Glyph="&#xE921;" FontSize="16" Foreground="{ThemeResource TextPrimaryBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Minimiert starten" FontWeight="SemiBold" />
                                        <TextBlock Text="Startet NEXT : XLR direkt minimiert im System-Tray ohne Hauptfenster." Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="StartMinimizedToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="StartMinimized_Toggled" />
                                </Grid>

                                <Border Height="1" Background="{ThemeResource SurfaceStrokeSubtleBrush}" Margin="68,0,20,0" />

                                <!-- Row 4: Beim Start stummschalten (Mute on Startup) -->
                                <Grid Padding="20,14" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource SurfaceL3Brush}">
                                        <FontIcon Glyph="&#xE74F;" FontSize="16" Foreground="{StaticResource WarningBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Uid="SetMuteOnStartupTitle" FontWeight="SemiBold" />
                                        <TextBlock x:Uid="SetMuteOnStartupDesc" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="MuteOnStartupToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" Toggled="MuteOnStartup_Toggled" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Windows Audio & Datenschutz -->
                        <Border Background="{ThemeResource SurfaceL2Brush}" CornerRadius="14"
                                BorderBrush="{ThemeResource SurfaceStrokeBrush}" BorderThickness="1" Padding="0">
                            <StackPanel>
                                <!-- Sprache -->
                                <Grid Padding="20,14" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource SurfaceL3Brush}">
                                        <FontIcon Glyph="&#xE775;" FontSize="16" Foreground="{ThemeResource TextPrimaryBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Uid="SetLanguageTitle" FontWeight="SemiBold" />
                                        <TextBlock Text="Systemsprache und Regionseinstellungen in Windows konfigurieren." Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <HyperlinkButton x:Uid="SetLanguageLink" Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource TextPrimaryBrush}" NavigateUri="ms-settings:regionlanguage" />
                                </Grid>

                                <Border Height="1" Background="{ThemeResource SurfaceStrokeSubtleBrush}" Margin="68,0,20,0" />

                                <!-- Soundgeräte -->
                                <Grid Padding="20,14" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource SurfaceL3Brush}">
                                        <FontIcon Glyph="&#xE767;" FontSize="16" Foreground="{ThemeResource TextPrimaryBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Uid="SetSoundTitle" FontWeight="SemiBold" />
                                        <TextBlock Text="Windows Sound-Systemsteuerung für Ein- und Ausgabegeräte öffnen." Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <HyperlinkButton x:Uid="SetSoundLink" Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource TextPrimaryBrush}" NavigateUri="ms-settings:sound" />
                                </Grid>

                                <Border Height="1" Background="{ThemeResource SurfaceStrokeSubtleBrush}" Margin="68,0,20,0" />

                                <!-- Mikrofon-Datenschutz -->
                                <Grid Padding="20,14" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource SurfaceL3Brush}">
                                        <FontIcon Glyph="&#xE720;" FontSize="16" Foreground="{ThemeResource TextPrimaryBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Windows Mikrofon-Datenschutz" FontWeight="SemiBold" />
                                        <TextBlock Text="Erlaube Desktop-Apps und NEXT : XLR Zugriff auf dein Mikrofon." Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <HyperlinkButton Content="Öffnen" Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource TextPrimaryBrush}" NavigateUri="ms-settings:privacy-microphone" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Card 4: Wartung & Dienststeuerung -->
                        <Border Background="{ThemeResource SurfaceL2Brush}" CornerRadius="14"
                                BorderBrush="{ThemeResource SurfaceStrokeBrush}" BorderThickness="1" Padding="0">
                            <StackPanel>
                                <!-- Altlasten bereinigen -->
                                <Grid Padding="20,14" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource SurfaceL3Brush}">
                                        <FontIcon Glyph="&#xE74D;" FontSize="16" Foreground="{StaticResource WarningBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Altlasten &amp; alte Software-Reste bereinigen" FontWeight="SemiBold" />
                                        <TextBlock Text="Entfernt veraltete Autostarts der TC-Helicon App, verwaiste Dienste und temporäre Cache-Dateien." Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <Button x:Name="CleanupRemnantsButton" Content="Bereinigen" Grid.Column="2" VerticalAlignment="Center" Click="CleanupRemnants_Click" />
                                </Grid>

                                <Border Height="1" Background="{ThemeResource SurfaceStrokeSubtleBrush}" Margin="68,0,20,0" />

                                <!-- Beenden -->
                                <Grid Padding="20,14" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource SurfaceL3Brush}">
                                        <FontIcon Glyph="&#xE7E8;" FontSize="16" Foreground="{StaticResource DangerBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Software &amp; Hintergrunddienst beenden" FontWeight="SemiBold" />
                                        <TextBlock Text="Beendet NEXT : XLR und stoppt den mixforged Hintergrunddienst vollständig." Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <Button x:Name="QuitAppAndServiceButton" Content="Vollständig beenden" Grid.Column="2" VerticalAlignment="Center" Click="QuitAppAndService_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <InfoBar x:Name="GeneralResult" IsOpen="False" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- ===== Audio & Treiber (Dedicated Tab) ===== -->
                    <StackPanel x:Name="AudioPanel" Spacing="14" Visibility="Collapsed">
                        <TextBlock Text="Audio-Ausgabe, Headset &amp; GoXLR Treiber" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />

                        <!-- Bluetooth & Wireless Headset Card -->
                        <Border Style="{StaticResource Card}" Padding="20,16">
                            <StackPanel Spacing="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE7F6;" FontSize="18" Foreground="{StaticResource BrandBrush}" />
                                            <TextBlock Text="Externe Output Quelle" FontWeight="SemiBold" FontSize="16" />
                                        </StackPanel>
                                        <TextBlock Text="Streamt das Kopfhörer-Signal in Echtzeit an ein externes Ausgabegerät (z. B. Bluetooth-, Wireless- oder USB-Headset)." Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="BluetoothToggle" Grid.Column="1" OnContent="Aktiv" OffContent="Aus"
                                                  MinWidth="0" VerticalAlignment="Center" Toggled="BluetoothToggle_Toggled" />
                                </Grid>

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="BluetoothDeviceBox" HorizontalAlignment="Stretch"
                                              PlaceholderText="Externes Ausgabegerät auswählen..."
                                              SelectionChanged="BluetoothDeviceBox_SelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="views:AudioEndpointItem">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" Foreground="{StaticResource BrandBrush}" />
                                                    <TextBlock Text="{x:Bind DisplayName}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Grid.Column="1" ToolTipService.ToolTip="Audiogeräte neu laden" Click="RefreshAudioDevices_Click">
                                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    </Button>
                                </Grid>

                                <CheckBox x:Name="BluetoothSidetoneCheck" IsChecked="True"
                                          Content="Mikrofon-Monitoring bei externer Ausgabe stummschalten (verhindert Echo durch Übertragungslatenz)"
                                          Checked="BluetoothSidetone_Changed" Unchecked="BluetoothSidetone_Changed" />

                                <InfoBar x:Name="BluetoothStatusInfo" IsOpen="True" IsClosable="False" Severity="Informational"
                                         Message="Kopfhörer-Signal wird über die Standard GoXLR 3,5 mm Klinkenbuchse ausgegeben." />
                            </StackPanel>
                        </Border>

                        <!-- GoXLR Audio Treiber Card -->
                        <Border Style="{StaticResource Card}" Padding="20,16">
                            <StackPanel Spacing="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE95A;" FontSize="18" Foreground="{StaticResource BrandBrush}" />
                                            <TextBlock Text="GoXLR Audiotreiber &amp; Windows-Kanäle" FontWeight="SemiBold" FontSize="16" />
                                        </StackPanel>
                                        <TextBlock x:Name="DriverStatusText" Text="Treiberstatus wird geprüft..." Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <Border x:Name="DriverStatusBadge" Grid.Column="1" CornerRadius="12" Padding="10,4"
                                            Background="{ThemeResource SurfaceL3Brush}" VerticalAlignment="Center">
                                        <TextBlock x:Name="DriverBadgeText" Text="Prüfe..." FontSize="12" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>

                                <TextBlock x:Name="DriverEndpointsText" Text="Prüfe Windows Audio-Endpunkte..."
                                           FontSize="13" Foreground="{ThemeResource TextMutedBrush}" TextWrapping="Wrap" />

                                <InfoBar x:Name="DriverResultBar" IsOpen="False" IsClosable="True" />

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="InstallDriverButton" Style="{StaticResource AccentButtonStyle}" Click="InstallDriver_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE896;" FontSize="14" />
                                            <TextBlock Text="Treiber installieren / reparieren" />
                                        </StackPanel>
                                    </Button>
                                    <Button Content="Windows Sound-Systemsteuerung" Click="OpenSoundControl_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===== Stream Deck & Integration ===== -->
                    <StackPanel x:Name="StreamDeckPanel" Spacing="14" Visibility="Collapsed">
                        <TextBlock Text="Elgato Stream Deck &amp; Engine API" Style="{StaticResource SectionTitle}" Margin="0,0,0,2" />
                        <InfoBar x:Name="StreamDeckTestResult" IsClosable="True" />

                        <!-- Live Status Card -->
                        <Border Style="{StaticResource Card}" Padding="20">
                            <StackPanel Spacing="16">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="48" Height="48" CornerRadius="12" Background="{ThemeResource SurfaceL3Brush}">
                                        <FontIcon Glyph="&#xE93C;" FontSize="24" Foreground="{StaticResource BrandBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{x:Bind StreamDeckService.StatusText, Mode=OneWay}" FontWeight="SemiBold" FontSize="16" />
                                            <Ellipse Fill="{x:Bind StreamDeckStatusBrush(StreamDeckService.IsApiOnline, StreamDeckService.IsAppRunning), Mode=OneWay}" Width="10" Height="10" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind StreamDeckService.StatusDetail, Mode=OneWay}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Content="Engine starten" Style="{StaticResource AccentButtonStyle}"
                                                Click="StartEngine_Click" />
                                        <Button Content="Status prüfen" Style="{StaticResource SmoothButton}"
                                                Click="CheckStreamDeckStatus_Click" />
                                    </StackPanel>
                                </Grid>

                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8B8;" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Lokale REST &amp; WebSocket API" FontWeight="SemiBold" />
                                        <TextBlock Text="HTTP http://127.0.0.1:48500 / WebSocket ws://127.0.0.1:48500/ws (Legacy-Port 14565 aktiv)" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="Port 48500" Foreground="{StaticResource BrandBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE774;" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Elgato Stream Deck Software" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind StreamDeckAppStatusText}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Stream Deck öffnen" Style="{StaticResource SmoothButton}"
                                            Click="OpenStreamDeckApp_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Card: Official Stream Deck Plugin Installation -->
                        <Border Style="{StaticResource Card}" Padding="20">
                            <StackPanel Spacing="16">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="48" Height="48" CornerRadius="12" Background="{ThemeResource SurfaceL3Brush}">
                                        <FontIcon Glyph="&#xE74C;" FontSize="24" Foreground="{StaticResource BrandBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="Offizielles NEXT : XLR Stream Deck Plugin" FontWeight="SemiBold" FontSize="16" />
                                            <Border Background="{ThemeResource SurfaceL2Brush}" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="v0.1.9.1" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrandBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind StreamDeckService.PluginStatusText, Mode=OneWay}"
                                                   Foreground="{ThemeResource TextMutedBrush}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Style="{StaticResource AccentButtonStyle}"
                                                Click="InstallStreamDeckPlugin_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE896;" FontSize="13" />
                                                <TextBlock Text="Plugin installieren" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource SmoothButton}" Click="OpenPluginPackage_Click"
                                                ToolTipService.ToolTip="Öffnet die .streamDeckPlugin Datei für Elgato Installer">
                                            <FontIcon Glyph="&#xE8DA;" FontSize="13" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Border Background="{ThemeResource SurfaceL2Brush}" CornerRadius="10" Padding="14"
                                        BorderBrush="{ThemeResource SurfaceStrokeSubtleBrush}" BorderThickness="1">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Enthaltene Aktionen &amp; Features:" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextMutedBrush}" />
                                        <Grid RowSpacing="6" ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE767;" FontSize="13" Foreground="{StaticResource BrandBrush}" />
                                                <TextBlock Text="Lautstärke / Fader (inkl. Stream Deck + Dials)" Style="{StaticResource Caption}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE74F;" FontSize="13" Foreground="{StaticResource BrandBrush}" />
                                                <TextBlock Text="Kanal Mute (Toggle / Stumm / An)" Style="{StaticResource Caption}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE720;" FontSize="13" Foreground="{StaticResource BrandBrush}" />
                                                <TextBlock Text="Mikrofon Mute (Toggle oder Push-to-Mute)" Style="{StaticResource Caption}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xEA18;" FontSize="13" Foreground="{StaticResource BrandBrush}" />
                                                <TextBlock Text="Zensur / Bleep (Piepton halten)" Style="{StaticResource Caption}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE8AB;" FontSize="13" Foreground="{StaticResource BrandBrush}" />
                                                <TextBlock Text="Routing Matrix (Kanal auf Bus schalten)" Style="{StaticResource Caption}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE792;" FontSize="13" Foreground="{StaticResource BrandBrush}" />
                                                <TextBlock Text="Profil laden (Direktes Umschalten per Taste)" Style="{StaticResource Caption}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Interactive Test Controls -->
                        <Border Style="{StaticResource Card}" Padding="20">
                            <StackPanel Spacing="14">
                                <TextBlock Text="API-Befehle testen" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock Text="Sende Testbefehle direkt an die lokale NextXLR Audio-Engine, um die Funktionalität für Stream Deck Tasten zu überprüfen:" Style="{StaticResource Caption}" />

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Style="{StaticResource SmoothButton}" Click="TestBleep_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE74F;" FontSize="14" Foreground="{StaticResource WarningBrush}" />
                                            <TextBlock Text="Test Zensur-Bleep (0.5s)" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SmoothButton}" Click="TestMicMute_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE720;" FontSize="14" />
                                            <TextBlock Text="Test Mic Mute (Toggle)" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SmoothButton}" Click="TestFaderA_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE9E9;" FontSize="14" />
                                            <TextBlock Text="Test Fader A (75%)" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Documentation & Guide Card -->
                        <Border Style="{StaticResource Card}" Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Dokumentation &amp; Stream Deck Plugin-Setup" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock Text="In der Stream Deck Software kannst du Tasten ganz einfach als 'System: Website' (GET-Request) oder über das Elgato API-Plugin anlegen." Style="{StaticResource Caption}" />

                                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                                    <Button Style="{StaticResource AccentButtonStyle}" Click="OpenStreamDeckDoc_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                                            <TextBlock Text="Stream Deck Dokumentation öffnen" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SmoothButton}" Click="OpenApiStatusBrowser_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE774;" FontSize="14" />
                                            <TextBlock Text="API im Browser ansehen (/api/status)" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===== Profiles ===== -->
                    <StackPanel x:Name="ProfilesPanel" Spacing="12" Visibility="Collapsed">
                        <TextBlock x:Uid="SettingsProfilesHeader" Style="{StaticResource SectionTitle}" Margin="0,0,0,2" />
                        <InfoBar x:Name="ProfileResult" IsClosable="True" />

                        <!-- Save current setup -->
                        <Border Style="{StaticResource Card}" Padding="18">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ProfileNameBox" x:Uid="ProfileNameBox" MaxLength="40" />
                                <Button x:Uid="ProfileSave" Grid.Column="1" VerticalAlignment="Bottom"
                                        Style="{StaticResource AccentButtonStyle}" Click="SaveProfile_Click" />
                            </Grid>
                        </Border>

                        <!-- Import / export files -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="ImportProfile_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8B5;" FontSize="14" /><TextBlock x:Uid="ProfileImportText" /></StackPanel>
                            </Button>
                            <Button Click="ExportCurrent_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xEDE1;" FontSize="14" /><TextBlock x:Uid="ProfileExportText" /></StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Library -->
                        <TextBlock x:Uid="ProfileLibraryHeader" Style="{StaticResource CardTitle}" Margin="0,8,0,0" />
                        <TextBlock x:Name="ProfileEmpty" x:Uid="ProfileEmpty" Style="{StaticResource Caption}" />
                        <ItemsRepeater x:Name="ProfileList">
                            <ItemsRepeater.Layout><StackLayout Spacing="8" /></ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="services:ProfileEntry">
                                    <Grid Style="{StaticResource SettingRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE77B;" />
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                                <Border CornerRadius="6" Padding="6,1" Background="{StaticResource BrandBrush}"
                                                        Visibility="{x:Bind DefaultBadge}" VerticalAlignment="Center">
                                                    <TextBlock x:Uid="ProfileDefaultBadge" FontSize="11" FontWeight="SemiBold" Foreground="#0E1015" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind SavedText}" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                            <Button x:Uid="ProfileLoad" Style="{StaticResource AccentButtonStyle}" Tag="{x:Bind}" Click="LoadProfile_Click" />
                                            <Button Tag="{x:Bind}" Click="OverwriteProfile_Click" ToolTipService.ToolTip="{x:Bind OverwriteTooltip}">
                                                <FontIcon Glyph="&#xE74E;" FontSize="14" />
                                            </Button>
                                            <Button Tag="{x:Bind}" Click="DefaultProfile_Click" x:Uid="ProfileSetDefault">
                                                <FontIcon Glyph="{x:Bind DefaultGlyph}" FontSize="14" />
                                            </Button>
                                            <Button Tag="{x:Bind}" Click="ExportProfile_Click" x:Uid="ProfileExportOne">
                                                <FontIcon Glyph="&#xEDE1;" FontSize="14" />
                                            </Button>
                                            <Button Tag="{x:Bind}" Click="DeleteProfile_Click" x:Uid="ProfileDelete">
                                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <!-- ===== Updates ===== -->
                    <StackPanel x:Name="UpdatesPanel" Spacing="12" Visibility="Collapsed">
                        <TextBlock x:Uid="SettingsUpdatesHeader" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                        <Border Style="{StaticResource Card}" Padding="20">
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Image Source="/Assets/nextXLR_icon.ico" Width="52" Height="52" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock x:Uid="AppNameText" Style="{StaticResource SectionTitle}" />
                                    <TextBlock x:Name="AppVersionText" Style="{StaticResource Caption}" />
                                    <TextBlock x:Name="EngineVersionText" Style="{StaticResource Caption}" />
                                    <TextBlock Text="Repository: github.com/plysystems/nextXLR" Style="{StaticResource Caption}" Foreground="{StaticResource BrandBrush}" />
                                </StackPanel>
                                <Button x:Uid="SetCheckUpdates" Grid.Column="2" Style="{StaticResource AccentButtonStyle}"
                                        Padding="16,10" CornerRadius="10" Click="CheckUpdates_Click" />
                            </Grid>
                        </Border>
                        <InfoBar x:Name="UpdateResult" IsClosable="True" />
                        <ProgressBar x:Name="UpdateProgressBar" Visibility="Collapsed" IsIndeterminate="False" Minimum="0" Maximum="100" Margin="0, -6, 0, 8" Height="6" CornerRadius="3" Foreground="{StaticResource BrandBrush}" />

                        <!-- GitHub Links & Release Channels -->
                        <Border Style="{StaticResource Card}" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Offizielle Links &amp; Releases" FontWeight="SemiBold" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button HorizontalAlignment="Stretch" Style="{StaticResource SmoothButton}" Click="OpenGitHubRepo_Click" Padding="12,10">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE774;" FontSize="16" Foreground="{StaticResource BrandBrush}" />
                                            <StackPanel>
                                                <TextBlock Text="GitHub Repository" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Text="plysystems/nextXLR" Style="{StaticResource Caption}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" HorizontalAlignment="Stretch" Style="{StaticResource SmoothButton}" Click="OpenGitHubReleases_Click" Padding="12,10">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xEDE1;" FontSize="16" Foreground="{StaticResource BrandBrush}" />
                                            <StackPanel>
                                                <TextBlock Text="Releases &amp; Downloads" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Text="Neueste Builds &amp; Changelogs" Style="{StaticResource Caption}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Lizenz & Copyright Summary -->
                        <Border Style="{StaticResource Card}" Padding="16">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8D7;" FontSize="16" Foreground="{StaticResource BrandBrush}" />
                                    <TextBlock Text="© plysystems. Alle Rechte vorbehalten." FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Text="Erlaubt für private &amp; kommerzielle Nutzung (Streaming, YouTube, Twitch, firmenintern) sowie Änderungen &amp; Weiterverteilung unter Beibehaltung des Copyright-Hinweises."
                                           FontSize="12" Foreground="{ThemeResource TextMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE895;" />
                            <StackPanel Grid.Column="1"><TextBlock x:Uid="SetAutoUpdateTitle" FontWeight="SemiBold" /></StackPanel>
                            <ToggleSwitch x:Name="AutoUpdateToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="AutoUpdate_Toggled" />
                        </Grid>
                    </StackPanel>

                    <!-- ===== Help ===== -->
                    <StackPanel x:Name="HelpPanel" Spacing="10" Visibility="Collapsed">
                        <TextBlock x:Uid="SettingsHelpHeader" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />

                        <!-- Guided Tour Button -->
                        <Border Style="{StaticResource Card}" Background="{ThemeResource SurfaceL2Brush}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="12" Background="{ThemeResource SurfaceL3Brush}">
                                    <FontIcon Glyph="&#xE735;" FontSize="18" Foreground="{StaticResource BrandBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Interaktive Guided Tour" FontWeight="SemiBold" />
                                    <TextBlock Text="Entdecke alle Funktionen und Neuerungen von NextXLR Schritt für Schritt." Style="{StaticResource Caption}" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Click="StartTour_Click" Content="Tour starten" />
                            </Grid>
                        </Border>

                        <!-- Quickstart & Overview -->
                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                            <Expander.Header><TextBlock x:Uid="HelpQuickstartTitle" FontWeight="SemiBold" Padding="0,8" /></Expander.Header>
                            <StackPanel Spacing="10">
                                <TextBlock x:Uid="HelpQuickstartIntro" TextWrapping="Wrap" />
                                <TextBlock x:Uid="HelpQuickstartRouting" TextWrapping="Wrap" />
                                <TextBlock x:Uid="HelpQuickstartMonitor" TextWrapping="Wrap" />
                                <TextBlock x:Uid="HelpQuickstartBleep" TextWrapping="Wrap" />
                                <TextBlock x:Uid="HelpQuickstartProfiles" TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>

                        <!-- Troubleshooting -->
                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                            <Expander.Header><TextBlock x:Uid="HelpTroubleTitle" FontWeight="SemiBold" Padding="0,8" /></Expander.Header>
                            <StackPanel Spacing="10">
                                <TextBlock x:Uid="HelpTrouble1" TextWrapping="Wrap" />
                                <TextBlock x:Uid="HelpTrouble2" TextWrapping="Wrap" />
                                <TextBlock x:Uid="HelpTroubleUsb" TextWrapping="Wrap" />
                                <TextBlock x:Uid="HelpTrouble3" TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>

                        <!-- Controls & Shortcuts -->
                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                            <Expander.Header><TextBlock x:Uid="HelpControlsTitle" FontWeight="SemiBold" Padding="0,8" /></Expander.Header>
                            <StackPanel Spacing="10">
                                <TextBlock x:Uid="HelpControls1" TextWrapping="Wrap" />
                                <TextBlock x:Uid="HelpControlsMixerPages" TextWrapping="Wrap" />
                                <TextBlock x:Uid="HelpControlsInput" TextWrapping="Wrap" />
                                <TextBlock x:Uid="HelpControls2" TextWrapping="Wrap" />
                                <TextBlock x:Uid="HelpControls3" TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8F1;" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Uid="HelpCreditsTitle" FontWeight="SemiBold" />
                                <TextBlock x:Uid="HelpCreditsDesc" Style="{StaticResource Caption}" />
                            </StackPanel>
                            <HyperlinkButton x:Uid="HelpCreditsLink" Grid.Column="2" NavigateUri="https://github.com/GoXLR-on-Linux/goxlr-utility" />
                        </Grid>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8B7;" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Uid="HelpDataTitle" FontWeight="SemiBold" />
                                <TextBlock x:Uid="HelpDataDesc" Style="{StaticResource Caption}" />
                            </StackPanel>
                            <Button x:Uid="HelpDataButton" Grid.Column="2" Click="OpenDataFolder_Click" />
                        </Grid>

                        <!-- ===== Copyright & Lizenz (plysystems) ===== -->
                        <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,4,0,0">
                            <StackPanel Spacing="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE8D7;" FontSize="18" Foreground="{StaticResource BrandBrush}" />
                                            <TextBlock Text="Urheberrecht &amp; Lizenz (plysystems)" FontWeight="SemiBold" FontSize="16" />
                                        </StackPanel>
                                        <TextBlock Text="NEXT : XLR ist ein Projekt von plysystems. © 2026 plysystems. Alle Rechte vorbehalten." FontSize="13" Foreground="{ThemeResource TextMutedBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" CornerRadius="8" Padding="10,4" Background="{ThemeResource SurfaceL3Brush}" VerticalAlignment="Center">
                                        <TextBlock Text="MIT-Lizenz" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrandBrush}" />
                                    </Border>
                                </Grid>

                                <Grid ColumnSpacing="16" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Erlaubt -->
                                    <Border Background="{ThemeResource SurfaceL3Brush}" CornerRadius="10" Padding="14,12">
                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="#10B981" />
                                                <TextBlock Text="Erlaubt (MIT)" FontWeight="Bold" FontSize="13" Foreground="#10B981" />
                                            </StackPanel>
                                            <TextBlock Text="• Private Nutzung (kostenfrei &amp; unbegrenzt)" FontSize="12" Foreground="{ThemeResource TextMutedBrush}" />
                                            <TextBlock Text="• Kommerzielle Nutzung (Streaming, YouTube, Twitch, Podcasts)" FontSize="12" Foreground="{ThemeResource TextMutedBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="• Firmeninterne Nutzung in Unternehmen &amp; Studios" FontSize="12" Foreground="{ThemeResource TextMutedBrush}" />
                                            <TextBlock Text="• Modifikation &amp; Erweiterung des Quellcodes" FontSize="12" Foreground="{ThemeResource TextMutedBrush}" />
                                            <TextBlock Text="• Weiterverteilung &amp; Integration" FontSize="12" Foreground="{ThemeResource TextMutedBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Pflicht -->
                                    <Border Grid.Column="1" Background="{ThemeResource SurfaceL3Brush}" CornerRadius="10" Padding="14,12">
                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="#F59E0B" />
                                                <TextBlock Text="Bedingungen &amp; Hinweise" FontWeight="Bold" FontSize="13" Foreground="#F59E0B" />
                                            </StackPanel>
                                            <TextBlock Text="• Copyright-Hinweis (plysystems) beibehalten" FontSize="12" Foreground="{ThemeResource TextMutedBrush}" />
                                            <TextBlock Text="• MIT-Lizenztext beibehalten" FontSize="12" Foreground="{ThemeResource TextMutedBrush}" />
                                            <TextBlock Text="• Drittanbieter-Lizenzen (Third-Party Notices) beachten" FontSize="12" Foreground="{ThemeResource TextMutedBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Click="OpenLicense_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                                            <TextBlock Text="Lizenzdatei anzeigen (MIT)" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OpenThirdPartyNotices_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE943;" FontSize="14" />
                                            <TextBlock Text="Drittanbieter-Lizenzen (Third-Party)" />
                                        </StackPanel>
                                    </Button>
                                    <HyperlinkButton Content="plysystems auf GitHub" NavigateUri="https://github.com/plysystems/nextXLR" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1000" /></VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!-- Section list moves above the content -->
                        <Setter Target="NavColumn.Width" Value="0" />
                        <Setter Target="SectionList.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="SectionList.(Grid.RowSpan)" Value="1" />
                        <Setter Target="ContentScroller.(Grid.Column)" Value="0" />
                        <Setter Target="ContentScroller.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="ContentScroller.(Grid.Row)" Value="1" />
                        <Setter Target="ContentScroller.(Grid.RowSpan)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
