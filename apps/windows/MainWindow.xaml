<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NextXLR.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:NextXLR.Services">

    <Grid x:Name="RootWindowGrid" Background="{ThemeResource SurfaceL1Brush}"
          AllowDrop="True" DragOver="App_DragOver" Drop="App_Drop">

        <Grid.Resources>
            <Style x:Key="NavCapsuleButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Height" Value="42" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="services:CursorHelper.UseHandCursor" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid CornerRadius="{TemplateBinding CornerRadius}">
                                <Border x:Name="RootBorder" CornerRadius="{TemplateBinding CornerRadius}"
                                        Background="{TemplateBinding Background}" />
                                <Border x:Name="HoverOverlay" CornerRadius="{TemplateBinding CornerRadius}"
                                        Background="{ThemeResource SurfaceHighlightBrush}" Opacity="0" />
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Padding="{TemplateBinding Padding}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0:0:0.15">
                                                <VisualTransition.GeneratedEasingFunction>
                                                    <CubicEase EasingMode="EaseInOut" />
                                                </VisualTransition.GeneratedEasingFunction>
                                            </VisualTransition>
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="Normal">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MenuToggleButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="services:CursorHelper.UseHandCursor" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid CornerRadius="{TemplateBinding CornerRadius}">
                                <Border x:Name="RootBorder" CornerRadius="{TemplateBinding CornerRadius}"
                                        Background="{TemplateBinding Background}" />
                                <Border x:Name="HoverOverlay" CornerRadius="{TemplateBinding CornerRadius}"
                                        Background="{ThemeResource SurfaceHighlightBrush}" Opacity="0" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition GeneratedDuration="0:0:0.15">
                                                <VisualTransition.GeneratedEasingFunction>
                                                    <CubicEase EasingMode="EaseInOut" />
                                                </VisualTransition.GeneratedEasingFunction>
                                            </VisualTransition>
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="Normal">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <!-- Atmospheric Studio Ambient Glow (Top-center subtle cyan lighting bloom from Bild 1) -->
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="0.55, 0.0" RadiusX="0.65" RadiusY="0.55" GradientOrigin="0.55, 0.0">
                    <GradientStop Color="{ThemeResource AmbientGlowStart}" Offset="0" />
                    <GradientStop Color="{ThemeResource AmbientGlowMid}" Offset="0.5" />
                    <GradientStop Color="{ThemeResource AmbientGlowEnd}" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- Main Layout: Docked Sidebar (Left) + Content Stage (Right) -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Column 0: Docked Sidebar Panel (Flush with top, left, bottom window edges) -->
            <Border x:Name="SidebarIsland" Grid.Column="0" Width="230"
                    CornerRadius="0" Margin="0"
                    Background="{ThemeResource SurfaceL3Brush}"
                    BorderBrush="{ThemeResource SurfaceStrokeBrush}" BorderThickness="0,0,1,0">
                <Grid Padding="12,14,12,14" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Header: [≡] next:xlr -->
                        <RowDefinition Height="*" />    <!-- Navigation Items -->
                        <RowDefinition Height="Auto" /> <!-- Footer Status Cards -->
                    </Grid.RowDefinitions>

                    <!-- Header: Minimalist Hamburger + next:xlr Typography -->
                    <Grid Grid.Row="0" Margin="4,2,4,6">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Button x:Name="MenuToggleButton" Style="{StaticResource MenuToggleButtonStyle}"
                                    Click="MenuToggleButton_Click" ToolTipService.ToolTip="Menü ein-/ausklappen">
                                <FontIcon Glyph="&#xE700;" FontSize="15" Foreground="{ThemeResource TextPrimaryBrush}" />
                            </Button>
                            <TextBlock x:Name="BrandTitleText" Text="next:xlr" FontSize="18" FontWeight="Bold"
                                       FontFamily="{StaticResource DisplayFont}" Foreground="{ThemeResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" Margin="2,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Navigation Items -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="4">
                            <!-- Mixer -->
                            <Button x:Name="Btn_Mixer" Tag="mixer" Style="{StaticResource NavCapsuleButtonStyle}" Click="NavButton_Click"
                                    ToolTipService.ToolTip="Mixer">
                                <Grid Height="40" Padding="8,0" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon x:Name="Icon_Mixer" Grid.Column="0" Glyph="&#xE9E9;" FontSize="17"
                                              Foreground="{StaticResource BrandBrush}" Width="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock x:Name="Text_Mixer" Grid.Column="1" Text="Mixer" FontSize="13.5"
                                               FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- Mikrofon -->
                            <Button x:Name="Btn_Mic" Tag="mic" Style="{StaticResource NavCapsuleButtonStyle}" Click="NavButton_Click"
                                    ToolTipService.ToolTip="Mikrofon">
                                <Grid Height="40" Padding="8,0" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon x:Name="Icon_Mic" Grid.Column="0" Glyph="&#xE720;" FontSize="17"
                                              Foreground="{ThemeResource TextMutedBrush}" Width="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock x:Name="Text_Mic" Grid.Column="1" Text="Mikrofon" FontSize="13.5"
                                               FontWeight="Normal" Foreground="{ThemeResource TextMutedBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- Routing -->
                            <Button x:Name="Btn_Routing" Tag="routing" Style="{StaticResource NavCapsuleButtonStyle}" Click="NavButton_Click"
                                    ToolTipService.ToolTip="Routing">
                                <Grid Height="40" Padding="8,0" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon x:Name="Icon_Routing" Grid.Column="0" Glyph="&#xE8AB;" FontSize="17"
                                              Foreground="{ThemeResource TextMutedBrush}" Width="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock x:Name="Text_Routing" Grid.Column="1" Text="Routing" FontSize="13.5"
                                               FontWeight="Normal" Foreground="{ThemeResource TextMutedBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- Effekte (HasEffects) -->
                            <Button x:Name="Btn_Effects" Tag="effects" Style="{StaticResource NavCapsuleButtonStyle}" Click="NavButton_Click"
                                    Visibility="{x:Bind ViewModel.Hardware.HasEffects, Mode=OneWay}"
                                    ToolTipService.ToolTip="Effekte">
                                <Grid Height="40" Padding="8,0" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon x:Name="Icon_Effects" Grid.Column="0" Glyph="&#xE945;" FontSize="17"
                                              Foreground="{ThemeResource TextMutedBrush}" Width="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock x:Name="Text_Effects" Grid.Column="1" Text="Effekte" FontSize="13.5"
                                               FontWeight="Normal" Foreground="{ThemeResource TextMutedBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- Sampler (HasSampler) -->
                            <Button x:Name="Btn_Sampler" Tag="sampler" Style="{StaticResource NavCapsuleButtonStyle}" Click="NavButton_Click"
                                    Visibility="{x:Bind ViewModel.Hardware.HasSampler, Mode=OneWay}"
                                    ToolTipService.ToolTip="Sampler">
                                <Grid Height="40" Padding="8,0" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon x:Name="Icon_Sampler" Grid.Column="0" Glyph="&#xE93C;" FontSize="17"
                                              Foreground="{ThemeResource TextMutedBrush}" Width="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock x:Name="Text_Sampler" Grid.Column="1" Text="Sampler" FontSize="13.5"
                                               FontWeight="Normal" Foreground="{ThemeResource TextMutedBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- Beleuchtung -->
                            <Button x:Name="Btn_Lighting" Tag="lighting" Style="{StaticResource NavCapsuleButtonStyle}" Click="NavButton_Click"
                                    ToolTipService.ToolTip="Beleuchtung">
                                <Grid Height="40" Padding="8,0" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon x:Name="Icon_Lighting" Grid.Column="0" Glyph="&#xE781;" FontSize="17"
                                              Foreground="{ThemeResource TextMutedBrush}" Width="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock x:Name="Text_Lighting" Grid.Column="1" Text="Beleuchtung" FontSize="13.5"
                                               FontWeight="Normal" Foreground="{ThemeResource TextMutedBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- Virtuelle Kanäle -->
                            <Button x:Name="Btn_Virtual" Tag="virtual" Style="{StaticResource NavCapsuleButtonStyle}" Click="NavButton_Click"
                                    ToolTipService.ToolTip="Virtuelle Kanäle">
                                <Grid Height="40" Padding="8,0" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon x:Name="Icon_Virtual" Grid.Column="0" Glyph="&#xE7F4;" FontSize="17"
                                              Foreground="{ThemeResource TextMutedBrush}" Width="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock x:Name="Text_Virtual" Grid.Column="1" Text="Virtuelle Kanäle" FontSize="13.5"
                                               FontWeight="Normal" Foreground="{ThemeResource TextMutedBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- Einstellungen -->
                            <Button x:Name="Btn_Settings" Tag="settings" Style="{StaticResource NavCapsuleButtonStyle}" Click="NavButton_Click"
                                    ToolTipService.ToolTip="Einstellungen">
                                <Grid Height="40" Padding="8,0" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon x:Name="Icon_Settings" Grid.Column="0" Glyph="&#xE713;" FontSize="17"
                                              Foreground="{ThemeResource TextMutedBrush}" Width="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock x:Name="Text_Settings" Grid.Column="1" Text="Einstellungen" FontSize="13.5"
                                               FontWeight="Normal" Foreground="{ThemeResource TextMutedBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer Status Cards (Bild 1) -->
                    <StackPanel Grid.Row="2" Spacing="6" Margin="0,4,0,0">
                        <!-- Card 1: NEXT:XLR / Verbunden -->
                        <Border x:Name="StatusCardConnection" CornerRadius="12" Padding="12,10"
                                Background="{ThemeResource SurfaceL2Brush}" BorderBrush="{ThemeResource SurfaceStrokeBrush}" BorderThickness="1">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- Glowing Status Dot -->
                                <Grid Width="16" Height="16" VerticalAlignment="Center">
                                    <Ellipse Fill="{x:Bind StatusBrush(ViewModel.IsConnected), Mode=OneWay}" Opacity="0.35" Width="16" Height="16" />
                                    <Ellipse Fill="{x:Bind StatusBrush(ViewModel.IsConnected), Mode=OneWay}" Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" x:Name="StatusConnectionPanel">
                                    <TextBlock Text="NEXT:XLR" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.ConnectionText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextMutedBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Card 2: Stream Deck / Verfügbarkeit (1:1 wie NEXT:XLR Verbunden) -->
                        <Border x:Name="StatusCardStreamDeck" CornerRadius="12" Padding="12,10"
                                Background="{ThemeResource SurfaceL2Brush}" BorderBrush="{ThemeResource SurfaceStrokeBrush}" BorderThickness="1"
                                ToolTipService.ToolTip="{x:Bind ViewModel.StreamDeck.StatusDetail, Mode=OneWay}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- Glowing Status Dot (1:1 wie NEXT:XLR) -->
                                <Grid Width="16" Height="16" VerticalAlignment="Center">
                                    <Ellipse Fill="{x:Bind StatusBrush(ViewModel.StreamDeck.IsAppRunning), Mode=OneWay}" Opacity="0.35" Width="16" Height="16" />
                                    <Ellipse Fill="{x:Bind StatusBrush(ViewModel.StreamDeck.IsAppRunning), Mode=OneWay}" Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" x:Name="StatusStreamDeckPanel">
                                    <TextBlock Text="Stream Deck" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.StreamDeck.SoftwareStatusText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextMutedBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Card 3: GoXLR / Seriennummer -->
                        <Border x:Name="StatusCardHardware" CornerRadius="12" Padding="12,10"
                                Background="{ThemeResource SurfaceL2Brush}" BorderBrush="{ThemeResource SurfaceStrokeBrush}" BorderThickness="1">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="16" Height="16" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE88E;" FontSize="14" Foreground="{StaticResource BrandBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" x:Name="StatusHardwarePanel">
                                    <TextBlock Text="{x:Bind ViewModel.Hardware.DeviceName, Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind ViewModel.Hardware.DeviceDetail, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Column 1: Main Content Stage -->
            <Grid Grid.Column="1" Margin="0">
                <!-- Top Drag Area for window moving -->
                <Grid x:Name="AppDragArea" Height="44" VerticalAlignment="Top" Background="Transparent" Margin="16,0,150,0">
                    <!-- Allgemeiner animierter Lade-Indikator -->
                    <StackPanel x:Name="AppLoadingPanel" Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}">
                        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="16" Height="16"
                                      Foreground="{StaticResource BrandBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.BusyText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Page Content Frame (Transparent to reveal Ambient Studio Glow + canvas background) -->
                <Frame x:Name="ContentFrame" Margin="0,44,0,0" Background="Transparent"
                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                <!-- InfoBars overlay on top when active, zero height/gap when closed -->
                <StackPanel VerticalAlignment="Top" Spacing="8" Margin="0,44,0,0">
                    <InfoBar x:Uid="EngineOffline" IsOpen="{x:Bind Not(ViewModel.IsConnected), Mode=OneWay}"
                             Margin="40,8,40,0" Severity="Warning" IsClosable="False" />
                    <InfoBar x:Uid="EngineError" IsOpen="{x:Bind HasText(ViewModel.LastError), Mode=OneWay}"
                             Margin="40,8,40,0" Severity="Error" Message="{x:Bind ViewModel.LastError, Mode=OneWay}" />
                    <InfoBar x:Name="DriverMissingBar" IsOpen="False" Severity="Warning"
                             Margin="40,8,40,0"
                             Title="GoXLR Audiotreiber nicht eingerichtet"
                             Message="Damit Windows alle Kanäle (System, Chat, Musik, Game) anbietet, muss der GoXLR Treiber installiert werden."
                             IsClosable="True">
                        <InfoBar.ActionButton>
                            <Button Content="Treiber jetzt installieren" Click="InstallDriver_Click"
                                    services:CursorHelper.UseHandCursor="True" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                </StackPanel>

                <!-- Animiertes Lade-Overlay bei Start, Seitenwechsel, Plugin-Scan oder Profil-Laden -->
                <Grid x:Name="GlobalLoadingOverlay" Background="#55050505"
                      Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                      IsHitTestVisible="False" Canvas.ZIndex="500">
                    <Border Background="{ThemeResource SurfaceL2Brush}" BorderBrush="{ThemeResource SurfaceStrokeSubtleBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="28,20"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="28" Height="28"
                                          Foreground="{StaticResource BrandBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.BusyText, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Interactive Welcome & Guided Tour Modal Overlay -->
        <Grid x:Name="TourOverlay" Visibility="Collapsed" Canvas.ZIndex="1000"
              Background="#C0050505" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="620" Padding="32" CornerRadius="20"
                    BorderBrush="{StaticResource BrandBrush}" BorderThickness="1.5"
                    Background="{ThemeResource SurfaceL1Brush}">
                <StackPanel Spacing="20">
                    <!-- Header with Icon & Step Count -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="48" Height="48" CornerRadius="14" Background="{ThemeResource SurfaceL2Brush}">
                            <FontIcon x:Name="TourIcon" Glyph="&#xE735;" FontSize="22" Foreground="{StaticResource BrandBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="TourTitle" Text="Willkommen bei NextXLR" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}" />
                            <TextBlock x:Name="TourStepLabel" Text="Schritt 1 von 7" Style="{StaticResource Caption}" Foreground="{StaticResource BrandBrush}" />
                        </StackPanel>
                        <Button Grid.Column="2" Padding="8" Background="Transparent" BorderThickness="0"
                                ToolTipService.ToolTip="Tour überspringen" Click="TourSkip_Click">
                            <FontIcon Glyph="&#xE711;" FontSize="14" />
                        </Button>
                    </Grid>

                    <ProgressBar x:Name="TourProgressBar" Maximum="7" Value="1" Height="4" CornerRadius="2" Foreground="{StaticResource BrandBrush}" />

                    <!-- Content Text -->
                    <Border CornerRadius="12" Background="{ThemeResource SurfaceL2Brush}" Padding="18">
                        <TextBlock x:Name="TourDescription" FontSize="14" LineHeight="22" TextWrapping="Wrap" />
                    </Border>

                    <!-- Footer with Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="TourBackButton" Content="Zurück" Click="TourBack_Click" Visibility="Collapsed" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                            <Button x:Name="TourSkipButton" Content="Überspringen" Click="TourSkip_Click" />
                            <Button x:Name="TourNextButton" Style="{StaticResource AccentButtonStyle}" Content="Weiter" Click="TourNext_Click" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>