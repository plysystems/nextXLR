<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="NextXLR.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Styles/Motion.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <!-- ============ Default Theme (Fallback to Dark - Obsidian Cyber Studio) ============ -->
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="SurfaceL1Brush" Color="#0D0F15" />
                    <SolidColorBrush x:Key="SurfaceL2Brush" Color="#151822" />
                    <SolidColorBrush x:Key="SurfaceL3Brush" Color="#090A0E" />
                    <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="#262A38" />
                    <SolidColorBrush x:Key="SurfaceStrokeSubtleBrush" Color="#1C1F2B" />
                    <SolidColorBrush x:Key="SurfaceHighlightBrush" Color="#32384D" />
                    <SolidColorBrush x:Key="MeterTrackBrush" Color="#090A0E" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC" />
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#8E98AB" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#8E98AB" />

                    <!-- NavigationView styling for Dark: Header matches Content #0D0F15 perfectly -->
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#0D0F15" />
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#090A0E" />
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#090A0E" />
                    <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#0D0F15" />
                    <SolidColorBrush x:Key="NavigationViewMinimalHeaderBackground" Color="#0D0F15" />
                    <SolidColorBrush x:Key="NavigationViewItemIndicatorBrush" Color="#00F5A0" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#151822" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#00F5A0" />
                </ResourceDictionary>

                <!-- ============ Dark Theme (Obsidian Cyber Studio) ============ -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SurfaceL1Brush" Color="#0D0F15" />
                    <SolidColorBrush x:Key="SurfaceL2Brush" Color="#151822" />
                    <SolidColorBrush x:Key="SurfaceL3Brush" Color="#090A0E" />
                    <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="#262A38" />
                    <SolidColorBrush x:Key="SurfaceStrokeSubtleBrush" Color="#1C1F2B" />
                    <SolidColorBrush x:Key="SurfaceHighlightBrush" Color="#32384D" />
                    <SolidColorBrush x:Key="MeterTrackBrush" Color="#090A0E" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC" />
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#8E98AB" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#8E98AB" />

                    <!-- NavigationView styling for Dark: Header matches Content #0D0F15 perfectly -->
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#0D0F15" />
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#090A0E" />
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#090A0E" />
                    <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#0D0F15" />
                    <SolidColorBrush x:Key="NavigationViewMinimalHeaderBackground" Color="#0D0F15" />
                    <SolidColorBrush x:Key="NavigationViewItemIndicatorBrush" Color="#00F5A0" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#151822" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#00F5A0" />
                </ResourceDictionary>

                <!-- ============ Light Theme (Nordic Studio Titanium) ============ -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SurfaceL1Brush" Color="#F5F7FA" />
                    <SolidColorBrush x:Key="SurfaceL2Brush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SurfaceL3Brush" Color="#E9EDF3" />
                    <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="#D2D7E0" />
                    <SolidColorBrush x:Key="SurfaceStrokeSubtleBrush" Color="#E2E6ED" />
                    <SolidColorBrush x:Key="SurfaceHighlightBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="MeterTrackBrush" Color="#E4E8EF" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#64748B" />

                    <!-- NavigationView styling for Light: Titanium Sidebar / Crisp Studio White Content -->
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#F5F7FA" />
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#EBEEF3" />
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#EBEEF3" />
                    <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#F5F7FA" />
                    <SolidColorBrush x:Key="NavigationViewMinimalHeaderBackground" Color="#F5F7FA" />
                    <SolidColorBrush x:Key="NavigationViewItemIndicatorBrush" Color="#0D9488" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#0D9488" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- ============ Design tokens ============ -->

            <!-- Accent: one brand colour drives every Fluent control (sliders, toggles, focus). -->
            <Color x:Key="SystemAccentColor">#00F5A0</Color>
            <Color x:Key="SystemAccentColorLight1">#33F7B3</Color>
            <Color x:Key="SystemAccentColorLight2">#66F9C6</Color>
            <Color x:Key="SystemAccentColorLight3">#99FBD9</Color>
            <Color x:Key="SystemAccentColorDark1">#00D48A</Color>
            <Color x:Key="SystemAccentColorDark2">#00A86D</Color>
            <Color x:Key="SystemAccentColorDark3">#007D51</Color>

            <!-- Surfaces / Fallbacks -->
            <SolidColorBrush x:Key="BrandBrush" Color="#00F5A0" />
            <SolidColorBrush x:Key="DangerBrush" Color="#F0506A" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#F0506A" />
            <SolidColorBrush x:Key="WarningBrush" Color="#F5B942" />
            <SolidColorBrush x:Key="HeadphoneBrush" Color="#38BDF8" />
            <SolidColorBrush x:Key="StreamBrush" Color="#00F5A0" />

            <LinearGradientBrush x:Key="MeterBrush" StartPoint="0,1" EndPoint="0,0">
                <GradientStop Color="#00D48A" Offset="0" />
                <GradientStop Color="#00F5A0" Offset="0.65" />
                <GradientStop Color="#F5B942" Offset="0.85" />
                <GradientStop Color="#F0506A" Offset="1" />
            </LinearGradientBrush>

            <!-- Spacing scale (4-pt grid) -->
            <Thickness x:Key="PagePadding">40,12,40,32</Thickness>
            <Thickness x:Key="InfoBarMargin">40,16,40,0</Thickness>
            <Thickness x:Key="CardPadding">24</Thickness>
            <CornerRadius x:Key="CardRadius">16</CornerRadius>
            <CornerRadius x:Key="ControlRadius">10</CornerRadius>

            <!-- ============ Typography ============ -->
            <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
            <FontFamily x:Key="MonoFont">Cascadia Code, Consolas, Segoe UI Variable Display, Segoe UI</FontFamily>

            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            </Style>
            <Style x:Key="PageSubtitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="MaxWidth" Value="760" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            </Style>
            <Style x:Key="CardTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            </Style>
            <Style x:Key="Caption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
            </Style>
            <Style x:Key="Overline" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="100" />
                <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
            </Style>

            <!-- ============ Surfaces ============ -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SurfaceL2Brush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeSubtleBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
                <Setter Property="Padding" Value="{StaticResource CardPadding}" />
            </Style>

            <Style x:Key="PageScroller" TargetType="ScrollViewer">
                <Setter Property="Padding" Value="{StaticResource PagePadding}" />
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            </Style>

            <!-- Large square toggle tiles (presets, effect buttons, banks): animated, see Styles/Motion.xaml -->
            <Style x:Key="TileToggle" TargetType="ToggleButton" BasedOn="{StaticResource SmoothToggle}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
