<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="NextXLR.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Styles/Motion.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ============ Design tokens ============ -->

            <!-- Accent: one brand colour drives every Fluent control (sliders, toggles, focus). -->
            <Color x:Key="SystemAccentColor">#1FC79A</Color>
            <Color x:Key="SystemAccentColorLight1">#33D6AA</Color>
            <Color x:Key="SystemAccentColorLight2">#4FE0B8</Color>
            <Color x:Key="SystemAccentColorLight3">#7DEACB</Color>
            <Color x:Key="SystemAccentColorDark1">#18A982</Color>
            <Color x:Key="SystemAccentColorDark2">#128A6A</Color>
            <Color x:Key="SystemAccentColorDark3">#0C6B52</Color>

            <!-- Surfaces: elevation is expressed by lightness, not heavy shadows. -->
            <SolidColorBrush x:Key="BrandBrush" Color="#4FE0B8" />
            <SolidColorBrush x:Key="DangerBrush" Color="#F0506A" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#F0506A" />
            <SolidColorBrush x:Key="WarningBrush" Color="#F5B942" />
            <SolidColorBrush x:Key="SurfaceL1Brush" Color="#15181E" />
            <SolidColorBrush x:Key="SurfaceL2Brush" Color="#1B1F27" />
            <SolidColorBrush x:Key="SurfaceL3Brush" Color="#232833" />
            <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="#2A303C" />
            <SolidColorBrush x:Key="SurfaceStrokeSubtleBrush" Color="#20252E" />
            <SolidColorBrush x:Key="MeterTrackBrush" Color="#0F1116" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F0F3F6" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#8B93A3" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#8B93A3" />

            <LinearGradientBrush x:Key="MeterBrush" StartPoint="0,1" EndPoint="0,0">
                <GradientStop Color="#1BB38C" Offset="0" />
                <GradientStop Color="#4FE0B8" Offset="0.65" />
                <GradientStop Color="#F5B942" Offset="0.85" />
                <GradientStop Color="#F0506A" Offset="1" />
            </LinearGradientBrush>

            <!-- Spacing scale (4-pt grid) -->
            <Thickness x:Key="PagePadding">40,12,40,32</Thickness>
            <Thickness x:Key="InfoBarMargin">40,16,40,0</Thickness>
            <Thickness x:Key="CardPadding">24</Thickness>
            <CornerRadius x:Key="CardRadius">16</CornerRadius>
            <CornerRadius x:Key="ControlRadius">10</CornerRadius>

            <!-- ============ Typography ============ -->
            <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>

            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="PageSubtitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="MaxWidth" Value="760" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="CardTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="Caption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            </Style>
            <Style x:Key="Overline" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="100" />
                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            </Style>

            <!-- ============ Surfaces ============ -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceL2Brush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SurfaceStrokeSubtleBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
                <Setter Property="Padding" Value="{StaticResource CardPadding}" />
            </Style>

            <Style x:Key="PageScroller" TargetType="ScrollViewer">
                <Setter Property="Padding" Value="{StaticResource PagePadding}" />
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            </Style>

            <!-- Large square toggle tiles (presets, effect buttons, banks): animated, see Styles/Motion.xaml -->
            <Style x:Key="TileToggle" TargetType="ToggleButton" BasedOn="{StaticResource SmoothToggle}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
