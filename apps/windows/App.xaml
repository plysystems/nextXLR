<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="NextXLR.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:NextXLR.Services">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Styles/Motion.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <!-- ============ Default Theme (Fallback to Dark - Studio Cyber Onyx) ============ -->
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="SurfaceL1Brush" Color="#050505" />
                    <SolidColorBrush x:Key="SurfaceL2Brush" Color="#12151B" />
                    <SolidColorBrush x:Key="SurfaceL3Brush" Color="#0A0B0E" />
                    <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="#1A1D24" />
                    <SolidColorBrush x:Key="SurfaceStrokeSubtleBrush" Color="#13161D" />
                    <SolidColorBrush x:Key="SurfaceHighlightBrush" Color="#1E222D" />
                    <SolidColorBrush x:Key="MeterTrackBrush" Color="#050505" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A0ABBA" />
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#8E98AB" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#8E98AB" />

                    <!-- Brand theme colors -->
                    <SolidColorBrush x:Key="BrandBrush" Color="#3DDFD9" />
                    <SolidColorBrush x:Key="BrandGlowBrush" Color="#333DDFD9" />
                    <SolidColorBrush x:Key="BrandGlowSubtleBrush" Color="#1A3DDFD9" />

                    <!-- NavigationView styling for Dark: Docked Sidebar in #0A0B0E -->
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#0A0B0E" />
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#0A0B0E" />
                    <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#0A0B0E" />
                    <SolidColorBrush x:Key="NavigationViewMinimalHeaderBackground" Color="#0A0B0E" />
                    <SolidColorBrush x:Key="NavigationViewItemIndicatorBrush" Color="#3DDFD9" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#161922" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#3DDFD9" />

                    <!-- Refined Studio ToggleSwitches (No radioactive neon) -->
                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#24C5BF" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#3DDFD9" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#1AA29D" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#18181C" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#2E2E36" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#8E98AB" />

                    <!-- Button Hover Styling -->
                    <SolidColorBrush x:Key="ButtonBackground" Color="#12151B" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1E232F" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#0B0D12" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#1A1E26" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#3DDFD9" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#1AA29D" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="#F8FAFC" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />

                    <!-- Accent Button Hover Styling -->
                    <SolidColorBrush x:Key="AccentButtonBackground" Color="#24C5BF" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#3DDFD9" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#1AA29D" />
                    <SolidColorBrush x:Key="AccentButtonForeground" Color="#050505" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#000000" />
                    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#5EE5DF" />

                    <!-- Glassmorphism Studio Tokens -->
                    <SolidColorBrush x:Key="GlassCardBackgroundBrush" Color="#B310131A" />
                    <SolidColorBrush x:Key="GlassCardBorderBrush" Color="#26FFFFFF" />
                    <SolidColorBrush x:Key="GlassCardPointerOverBorderBrush" Color="#663DDFD9" />
                    <SolidColorBrush x:Key="GlassCardActiveFaderBorderBrush" Color="#993DDFD9" />
                    <SolidColorBrush x:Key="GlassInnerBayBackground" Color="#40000000" />
                    <SolidColorBrush x:Key="GlassTrackBackground" Color="#CC0A0D12" />
                    <SolidColorBrush x:Key="GlassTrackBorder" Color="#2E3544" />

                    <!-- Ambient Studio Glow Colors (#050505 canvas with vivid cyan bloom) -->
                    <Color x:Key="AmbientGlowStart">#351A6662</Color>
                    <Color x:Key="AmbientGlowMid">#14164845</Color>
                    <Color x:Key="AmbientGlowEnd">#00050505</Color>
                </ResourceDictionary>

                <!-- ============ Dark Theme (Studio Cyber Onyx #050505 / Sidebar #0A0B0E) ============ -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SurfaceL1Brush" Color="#050505" />
                    <SolidColorBrush x:Key="SurfaceL2Brush" Color="#12151B" />
                    <SolidColorBrush x:Key="SurfaceL3Brush" Color="#0A0B0E" />
                    <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="#1A1D24" />
                    <SolidColorBrush x:Key="SurfaceStrokeSubtleBrush" Color="#13161D" />
                    <SolidColorBrush x:Key="SurfaceHighlightBrush" Color="#1E222D" />
                    <SolidColorBrush x:Key="MeterTrackBrush" Color="#050505" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A0ABBA" />
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#8E98AB" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#8E98AB" />

                    <!-- Brand theme colors -->
                    <SolidColorBrush x:Key="BrandBrush" Color="#3DDFD9" />
                    <SolidColorBrush x:Key="BrandGlowBrush" Color="#333DDFD9" />
                    <SolidColorBrush x:Key="BrandGlowSubtleBrush" Color="#1A3DDFD9" />

                    <!-- NavigationView styling for Dark: Docked Sidebar in #0A0B0E -->
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#0A0B0E" />
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#0A0B0E" />
                    <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#0A0B0E" />
                    <SolidColorBrush x:Key="NavigationViewMinimalHeaderBackground" Color="#0A0B0E" />
                    <SolidColorBrush x:Key="NavigationViewItemIndicatorBrush" Color="#3DDFD9" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#161922" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#3DDFD9" />

                    <!-- Refined Studio ToggleSwitches (No radioactive neon) -->
                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#24C5BF" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#3DDFD9" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#1AA29D" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#18181C" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#2E2E36" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#8E98AB" />

                    <!-- Button Hover Styling -->
                    <SolidColorBrush x:Key="ButtonBackground" Color="#12151B" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1E232F" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#0B0D12" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#1A1E26" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#3DDFD9" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#1AA29D" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="#F8FAFC" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />

                    <!-- Accent Button Hover Styling -->
                    <SolidColorBrush x:Key="AccentButtonBackground" Color="#24C5BF" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#3DDFD9" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#1AA29D" />
                    <SolidColorBrush x:Key="AccentButtonForeground" Color="#050505" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#000000" />
                    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#5EE5DF" />

                    <!-- Glassmorphism Studio Tokens -->
                    <SolidColorBrush x:Key="GlassCardBackgroundBrush" Color="#B310131A" />
                    <SolidColorBrush x:Key="GlassCardBorderBrush" Color="#26FFFFFF" />
                    <SolidColorBrush x:Key="GlassCardPointerOverBorderBrush" Color="#663DDFD9" />
                    <SolidColorBrush x:Key="GlassCardActiveFaderBorderBrush" Color="#993DDFD9" />
                    <SolidColorBrush x:Key="GlassInnerBayBackground" Color="#40000000" />
                    <SolidColorBrush x:Key="GlassTrackBackground" Color="#CC0A0D12" />
                    <SolidColorBrush x:Key="GlassTrackBorder" Color="#2E3544" />

                    <!-- Ambient Studio Glow Colors (#050505 canvas with vivid cyan bloom) -->
                    <Color x:Key="AmbientGlowStart">#351A6662</Color>
                    <Color x:Key="AmbientGlowMid">#14164845</Color>
                    <Color x:Key="AmbientGlowEnd">#00050505</Color>
                </ResourceDictionary>

                <!-- ============ Light Theme (Nordic Studio #F6F7F9 / Sidebar #EAECEF) ============ -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SurfaceL1Brush" Color="#F6F7F9" />
                    <SolidColorBrush x:Key="SurfaceL2Brush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SurfaceL3Brush" Color="#EAECEF" />
                    <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="#D8DCE4" />
                    <SolidColorBrush x:Key="SurfaceStrokeSubtleBrush" Color="#E4E7EE" />
                    <SolidColorBrush x:Key="SurfaceHighlightBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="MeterTrackBrush" Color="#E2E5EC" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569" />
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#64748B" />

                    <!-- Brand theme colors for Light mode: rich studio teal with high contrast -->
                    <SolidColorBrush x:Key="BrandBrush" Color="#0D9488" />
                    <SolidColorBrush x:Key="BrandGlowBrush" Color="#250D9488" />
                    <SolidColorBrush x:Key="BrandGlowSubtleBrush" Color="#120D9488" />

                    <!-- NavigationView styling for Light: Soft Platinum chassis #EAECEF / Content #F6F7F9 -->
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#EAECEF" />
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#EAECEF" />
                    <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#EAECEF" />
                    <SolidColorBrush x:Key="NavigationViewMinimalHeaderBackground" Color="#EAECEF" />
                    <SolidColorBrush x:Key="NavigationViewItemIndicatorBrush" Color="#0D9488" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#0D9488" />

                    <!-- Refined Studio ToggleSwitches for Light Mode -->
                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#0D9488" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#0F766E" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#115E59" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#E2E6ED" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#C8CED8" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#64748B" />

                    <!-- Glassmorphism Studio Tokens for Light Mode -->
                    <SolidColorBrush x:Key="GlassCardBackgroundBrush" Color="#E6FFFFFF" />
                    <SolidColorBrush x:Key="GlassCardBorderBrush" Color="#26000000" />
                    <SolidColorBrush x:Key="GlassCardPointerOverBorderBrush" Color="#800D9488" />
                    <SolidColorBrush x:Key="GlassCardActiveFaderBorderBrush" Color="#B30D9488" />
                    <SolidColorBrush x:Key="GlassInnerBayBackground" Color="#40F0F3F8" />
                    <SolidColorBrush x:Key="GlassTrackBackground" Color="#E4E8F0" />
                    <SolidColorBrush x:Key="GlassTrackBorder" Color="#CAD0DC" />

                    <!-- Button Hover Styling -->
                    <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#F1F3F8" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#E2E6EE" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#D8DCE4" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#0D9488" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#115E59" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="#0F172A" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#000000" />

                    <!-- Accent Button Hover Styling -->
                    <SolidColorBrush x:Key="AccentButtonBackground" Color="#0D9488" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#0F766E" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#115E59" />
                    <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#0D9488" />

                    <!-- Ambient Studio Glow Colors for Light mode -->
                    <Color x:Key="AmbientGlowStart">#180D9488</Color>
                    <Color x:Key="AmbientGlowMid">#080D9488</Color>
                    <Color x:Key="AmbientGlowEnd">#00F6F7F9</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- ============ Design tokens ============ -->

            <!-- Accent: NEXT:XLR Logo Brand Color #3DDFD9 -->
            <Color x:Key="SystemAccentColor">#3DDFD9</Color>
            <Color x:Key="SystemAccentColorLight1">#5EE5DF</Color>
            <Color x:Key="SystemAccentColorLight2">#80EBE6</Color>
            <Color x:Key="SystemAccentColorLight3">#A2F1EC</Color>
            <Color x:Key="SystemAccentColorDark1">#24C5BF</Color>
            <Color x:Key="SystemAccentColorDark2">#1AA29D</Color>
            <Color x:Key="SystemAccentColorDark3">#137E7A</Color>

            <!-- Surfaces / Fallbacks -->
            <SolidColorBrush x:Key="BrandGlowStrongBrush" Color="#553DDFD9" />
            <SolidColorBrush x:Key="DangerBrush" Color="#F0506A" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#F0506A" />
            <SolidColorBrush x:Key="WarningBrush" Color="#F5B942" />
            <SolidColorBrush x:Key="HeadphoneBrush" Color="#38BDF8" />
            <SolidColorBrush x:Key="StreamBrush" Color="#3DDFD9" />

            <LinearGradientBrush x:Key="MeterBrush" StartPoint="0,1" EndPoint="0,0">
                <GradientStop Color="#1AA29D" Offset="0" />
                <GradientStop Color="#3DDFD9" Offset="0.65" />
                <GradientStop Color="#F5B942" Offset="0.85" />
                <GradientStop Color="#F0506A" Offset="1" />
            </LinearGradientBrush>

            <!-- Spacing scale (4-pt grid) -->
            <Thickness x:Key="PagePadding">40,12,40,32</Thickness>
            <Thickness x:Key="InfoBarMargin">40,16,40,0</Thickness>
            <Thickness x:Key="CardPadding">24</Thickness>
            <CornerRadius x:Key="CardRadius">16</CornerRadius>
            <CornerRadius x:Key="ControlRadius">10</CornerRadius>

            <!-- ============ Typography ============ -->
            <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
            <FontFamily x:Key="MonoFont">Cascadia Code, Consolas, Segoe UI Variable Display, Segoe UI</FontFamily>

            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            </Style>
            <Style x:Key="PageSubtitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="MaxWidth" Value="760" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            </Style>
            <Style x:Key="CardTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            </Style>
            <Style x:Key="Caption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
            </Style>
            <Style x:Key="Overline" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="100" />
                <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
            </Style>

            <!-- ============ Surfaces ============ -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource GlassCardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource GlassCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
                <Setter Property="Padding" Value="{StaticResource CardPadding}" />
            </Style>

            <Style x:Key="GlassCard" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource GlassCardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource GlassCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
                <Setter Property="Padding" Value="{StaticResource CardPadding}" />
            </Style>

            <Style x:Key="PageScroller" TargetType="ScrollViewer">
                <Setter Property="Padding" Value="{StaticResource PagePadding}" />
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            </Style>

            <!-- Large square toggle tiles (presets, effect buttons, banks): animated, see Styles/Motion.xaml -->
            <Style x:Key="TileToggle" TargetType="ToggleButton" BasedOn="{StaticResource SmoothToggle}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
