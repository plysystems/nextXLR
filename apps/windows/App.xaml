<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="NextXLR.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Styles/Motion.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <!-- ============ Default Theme (Fallback to Dark - Studio Cyber Onyx) ============ -->
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="SurfaceL1Brush" Color="#0A0A0A" />
                    <SolidColorBrush x:Key="SurfaceL2Brush" Color="#141416" />
                    <SolidColorBrush x:Key="SurfaceL3Brush" Color="#050505" />
                    <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="#222226" />
                    <SolidColorBrush x:Key="SurfaceStrokeSubtleBrush" Color="#18181B" />
                    <SolidColorBrush x:Key="SurfaceHighlightBrush" Color="#2E2E34" />
                    <SolidColorBrush x:Key="MeterTrackBrush" Color="#050505" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC" />
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#8E98AB" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#8E98AB" />

                    <!-- NavigationView styling for Dark: Sidebar & Topbar chassis in #050505 -->
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#0A0A0A" />
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#050505" />
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#050505" />
                    <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#050505" />
                    <SolidColorBrush x:Key="NavigationViewMinimalHeaderBackground" Color="#050505" />
                    <SolidColorBrush x:Key="NavigationViewItemIndicatorBrush" Color="#3DDFD9" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#141416" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#3DDFD9" />

                    <!-- Refined Studio ToggleSwitches (No radioactive neon) -->
                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#24C5BF" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#3DDFD9" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#1AA29D" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#18181C" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#2E2E36" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#8E98AB" />
                </ResourceDictionary>

                <!-- ============ Dark Theme (Studio Cyber Onyx #0A0A0A / Sidebar & Topbar #050505) ============ -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SurfaceL1Brush" Color="#0A0A0A" />
                    <SolidColorBrush x:Key="SurfaceL2Brush" Color="#141416" />
                    <SolidColorBrush x:Key="SurfaceL3Brush" Color="#050505" />
                    <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="#222226" />
                    <SolidColorBrush x:Key="SurfaceStrokeSubtleBrush" Color="#18181B" />
                    <SolidColorBrush x:Key="SurfaceHighlightBrush" Color="#2E2E34" />
                    <SolidColorBrush x:Key="MeterTrackBrush" Color="#050505" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC" />
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#8E98AB" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#8E98AB" />

                    <!-- NavigationView styling for Dark: Sidebar & Topbar chassis in #050505 -->
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#0A0A0A" />
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#050505" />
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#050505" />
                    <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#050505" />
                    <SolidColorBrush x:Key="NavigationViewMinimalHeaderBackground" Color="#050505" />
                    <SolidColorBrush x:Key="NavigationViewItemIndicatorBrush" Color="#3DDFD9" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#141416" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#3DDFD9" />

                    <!-- Refined Studio ToggleSwitches (No radioactive neon) -->
                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#24C5BF" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#3DDFD9" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#1AA29D" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#18181C" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#2E2E36" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#8E98AB" />
                </ResourceDictionary>

                <!-- ============ Light Theme (Nordic Studio #F6F7F9 / Sidebar & Topbar #EAECEF) ============ -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SurfaceL1Brush" Color="#F6F7F9" />
                    <SolidColorBrush x:Key="SurfaceL2Brush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SurfaceL3Brush" Color="#EAECEF" />
                    <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="#D8DCE4" />
                    <SolidColorBrush x:Key="SurfaceStrokeSubtleBrush" Color="#E4E7EE" />
                    <SolidColorBrush x:Key="SurfaceHighlightBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="MeterTrackBrush" Color="#E2E5EC" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#64748B" />

                    <!-- NavigationView styling for Light: Soft Platinum chassis #EAECEF / Content #F6F7F9 -->
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#F6F7F9" />
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#EAECEF" />
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#EAECEF" />
                    <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#EAECEF" />
                    <SolidColorBrush x:Key="NavigationViewMinimalHeaderBackground" Color="#EAECEF" />
                    <SolidColorBrush x:Key="NavigationViewItemIndicatorBrush" Color="#168B87" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#168B87" />

                    <!-- Refined Studio ToggleSwitches for Light Mode -->
                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#168B87" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#1AA29D" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#137E7A" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#E2E6ED" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#C8CED8" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#64748B" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- ============ Design tokens ============ -->

            <!-- Accent: NEXT:XLR Logo Brand Color #3DDFD9 -->
            <Color x:Key="SystemAccentColor">#3DDFD9</Color>
            <Color x:Key="SystemAccentColorLight1">#5EE5DF</Color>
            <Color x:Key="SystemAccentColorLight2">#80EBE6</Color>
            <Color x:Key="SystemAccentColorLight3">#A2F1EC</Color>
            <Color x:Key="SystemAccentColorDark1">#24C5BF</Color>
            <Color x:Key="SystemAccentColorDark2">#1AA29D</Color>
            <Color x:Key="SystemAccentColorDark3">#137E7A</Color>

            <!-- Surfaces / Fallbacks -->
            <SolidColorBrush x:Key="BrandBrush" Color="#3DDFD9" />
            <SolidColorBrush x:Key="BrandGlowBrush" Color="#333DDFD9" />
            <SolidColorBrush x:Key="BrandGlowSubtleBrush" Color="#1A3DDFD9" />
            <SolidColorBrush x:Key="BrandGlowStrongBrush" Color="#553DDFD9" />
            <SolidColorBrush x:Key="DangerBrush" Color="#F0506A" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#F0506A" />
            <SolidColorBrush x:Key="WarningBrush" Color="#F5B942" />
            <SolidColorBrush x:Key="HeadphoneBrush" Color="#38BDF8" />
            <SolidColorBrush x:Key="StreamBrush" Color="#3DDFD9" />

            <LinearGradientBrush x:Key="MeterBrush" StartPoint="0,1" EndPoint="0,0">
                <GradientStop Color="#1AA29D" Offset="0" />
                <GradientStop Color="#3DDFD9" Offset="0.65" />
                <GradientStop Color="#F5B942" Offset="0.85" />
                <GradientStop Color="#F0506A" Offset="1" />
            </LinearGradientBrush>

            <!-- Spacing scale (4-pt grid) -->
            <Thickness x:Key="PagePadding">40,12,40,32</Thickness>
            <Thickness x:Key="InfoBarMargin">40,16,40,0</Thickness>
            <Thickness x:Key="CardPadding">24</Thickness>
            <CornerRadius x:Key="CardRadius">16</CornerRadius>
            <CornerRadius x:Key="ControlRadius">10</CornerRadius>

            <!-- ============ Typography ============ -->
            <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
            <FontFamily x:Key="MonoFont">Cascadia Code, Consolas, Segoe UI Variable Display, Segoe UI</FontFamily>

            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            </Style>
            <Style x:Key="PageSubtitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="MaxWidth" Value="760" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            </Style>
            <Style x:Key="CardTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
            </Style>
            <Style x:Key="Caption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
            </Style>
            <Style x:Key="Overline" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="100" />
                <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
            </Style>

            <!-- ============ Surfaces ============ -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SurfaceL2Brush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeSubtleBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
                <Setter Property="Padding" Value="{StaticResource CardPadding}" />
            </Style>

            <Style x:Key="PageScroller" TargetType="ScrollViewer">
                <Setter Property="Padding" Value="{StaticResource PagePadding}" />
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            </Style>

            <!-- Large square toggle tiles (presets, effect buttons, banks): animated, see Styles/Motion.xaml -->
            <Style x:Key="TileToggle" TargetType="ToggleButton" BasedOn="{StaticResource SmoothToggle}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
