<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NextXLR.Controls.Fader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="50" MinHeight="140">

    <Grid x:Name="Root" Background="Transparent">
        <!-- Level Meter on the left (runs parallel to the fader track) -->
        <Grid x:Name="MeterHost" Width="4" HorizontalAlignment="Left" Margin="2,14,0,14" VerticalAlignment="Stretch">
            <!-- Meter background track -->
            <Border x:Name="MeterTrackBorder" CornerRadius="2" Background="{ThemeResource GlassTrackBackground}" BorderBrush="{ThemeResource GlassTrackBorder}" BorderThickness="1" />
            <!-- Gradient level fill -->
            <Border x:Name="MeterGradient" CornerRadius="2" Background="{StaticResource MeterBrush}" Opacity="0.0" />
            <!-- Top mask to hide gradient down to current audio level -->
            <Border x:Name="MeterMask" VerticalAlignment="Top" CornerRadius="2,2,0,0" Background="{ThemeResource GlassTrackBackground}" />
            <!-- Peak hold line -->
            <Border x:Name="MeterHold" VerticalAlignment="Top" Height="2" CornerRadius="1"
                    Background="#FFFFFF" Opacity="0.0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="MeterHoldOffset" />
                </Border.RenderTransform>
            </Border>
            <!-- When not metered (outputs / unmetered inputs): subtle dark groove guide -->
            <Border x:Name="NoMeterGuide" Width="2" HorizontalAlignment="Center" CornerRadius="1"
                    Background="{ThemeResource SurfaceStrokeSubtleBrush}" Visibility="Collapsed" />
        </Grid>

        <!-- Scale ticks on the right (0 / 25 / 50 / 75 / 100 %) -->
        <Canvas x:Name="Ticks" IsHitTestVisible="False" />

        <!-- Central recessed studio fader track slot -->
        <Border x:Name="Track" Width="4" CornerRadius="2" HorizontalAlignment="Center"
                Margin="0,14,0,14" VerticalAlignment="Stretch"
                Background="{ThemeResource GlassTrackBackground}" BorderBrush="{ThemeResource GlassTrackBorder}" BorderThickness="1" />

        <!-- Floating live dB indicator badge (visible on drag or hover above the cap) -->
        <Border x:Name="FloatingBubble" HorizontalAlignment="Center" VerticalAlignment="Top"
                CornerRadius="6" Padding="6,2" Margin="0,-24,0,0"
                Background="{ThemeResource SurfaceL3Brush}" BorderBrush="{ThemeResource GlassCardBorderBrush}"
                BorderThickness="1" Opacity="0.0" IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform x:Name="FloatingBubbleOffset" />
            </Border.RenderTransform>
            <TextBlock x:Name="FloatingText" Text="0.0 dB"
                       FontSize="10" FontWeight="Bold" FontFamily="{StaticResource MonoFont}"
                       Foreground="{StaticResource BrandBrush}" HorizontalAlignment="Center" />
        </Border>

        <!-- Tactile modern studio fader cap -->
        <Grid x:Name="Cap" Width="30" Height="28" VerticalAlignment="Top" HorizontalAlignment="Center">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="CapOffset" />
            </Grid.RenderTransform>

            <!-- Soft modern drop shadow under the fader knob -->
            <Border CornerRadius="7" Margin="-2,1,-2,-3" Background="#000000" Opacity="0.45" />

            <!-- Main sculpted knob body with clean modern finish -->
            <Border x:Name="CapBevel" CornerRadius="7" BorderThickness="1" BorderBrush="#3A404D">
                <Border.Background>
                    <LinearGradientBrush x:Name="CapBg" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#262B36" Offset="0.0" />
                        <GradientStop Color="#161922" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Subtle top specular edge highlight on knob -->
            <Border Height="1" Margin="3,1,3,0" VerticalAlignment="Top" CornerRadius="0.5"
                    Background="#30FFFFFF" IsHitTestVisible="False" />

            <!-- Center indicator index mark (high-precision illuminated studio LED notch) -->
            <Grid Height="5" Margin="4,0" VerticalAlignment="Center">
                <!-- Soft glow behind indicator -->
                <Border x:Name="IndicatorGlow" Height="5" CornerRadius="2.5" Opacity="0.35" />
                <!-- Crisp LED line -->
                <Border x:Name="IndicatorLine" Height="2.5" CornerRadius="1.25" Margin="1,1.25" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
