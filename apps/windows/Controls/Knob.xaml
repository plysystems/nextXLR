<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NextXLR.Controls.Knob"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="True" UseSystemFocusVisuals="True" CornerRadius="60">

    <StackPanel Spacing="10" HorizontalAlignment="Center">
        <Grid x:Name="Dial" Width="104" Height="104" Background="Transparent">
            <!-- 270° track and value arc (drawn in code-behind). -->
            <Path x:Name="TrackArc" Stroke="{ThemeResource SurfaceL3Brush}" StrokeThickness="7"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Path x:Name="ValueArc" Stroke="{x:Bind Accent, Mode=OneWay}" StrokeThickness="7"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <!-- Cap with pointer -->
            <Ellipse Width="70" Height="70" Fill="{ThemeResource SurfaceL3Brush}"
                     Stroke="{ThemeResource SurfaceStrokeBrush}" StrokeThickness="1" />
            <Grid Width="70" Height="70" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <RotateTransform x:Name="PointerRotation" />
                </Grid.RenderTransform>
                <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Top"
                           Margin="0,8,0,0" Fill="{x:Bind Accent, Mode=OneWay}" />
            </Grid>
            <TextBlock x:Name="ValueText" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="13" FontWeight="SemiBold" Margin="0,10,0,0" />
        </Grid>
        <TextBlock Text="{x:Bind Header, Mode=OneWay}" HorizontalAlignment="Center" FontWeight="SemiBold" />
    </StackPanel>
</UserControl>
