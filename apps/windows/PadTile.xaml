<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NextXLR.PadTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NextXLR.Controls"
    AllowDrop="True" DragOver="Pad_DragOver" Drop="Pad_Drop">

    <!--
      One sampler pad. The content hugs the pad's OUTER side, so the round Clear button that sits
      in the middle of the four pads never covers anything (Mirror = right-hand column).
    -->
    <Border x:Name="Body" CornerRadius="20" BorderThickness="2" Padding="18,16"
            Background="{x:Bind PadBackground(ViewModel.IsPlaying, ViewModel.HasSample), Mode=OneWay}"
            BorderBrush="{x:Bind PadBorder(ViewModel.IsSelected, ViewModel.IsPlaying), Mode=OneWay}"
            AutomationProperties.Name="{x:Bind ViewModel.Label}">
        <Border.BackgroundTransition><BrushTransition Duration="0:0:0.2" /></Border.BackgroundTransition>
        <Border.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem Text="Pad bearbeiten" Click="EditPad_Click">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Sound ersetzen..." Click="ReplaceSample_Click">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Pad leeren" Click="ClearPad_Click">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Border.ContextFlyout>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: label + mode, settings at the outer corner -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="SettingsButton" x:Uid="SamplerPadSettings" Grid.Column="{x:Bind GearColumn}" Padding="6"
                        ToolTipService.ToolTip="Pad bearbeiten"
                        Background="Transparent" BorderThickness="0" Click="Settings_Click">
                    <FontIcon Glyph="&#xE70F;" FontSize="14" />
                </Button>
                <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="{x:Bind Side}">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="{x:Bind Side}">
                        <Border Background="{ThemeResource SurfaceL3Brush}" CornerRadius="6" Padding="8,3"
                                BorderBrush="{ThemeResource SurfaceStrokeBrush}" BorderThickness="1">
                            <TextBlock Text="{x:Bind ViewModel.Label}" FontSize="12" FontWeight="Bold"
                                       FontFamily="{StaticResource DisplayFont}" />
                        </Border>
                        <Border Background="{ThemeResource SurfaceL3Brush}" CornerRadius="6" Padding="6,3"
                                BorderBrush="{ThemeResource SurfaceStrokeSubtleBrush}" BorderThickness="1"
                                Opacity="0.85">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="{x:Bind ViewModel.ModeGlyph, Mode=OneWay}" FontSize="10" />
                                <TextBlock Text="{x:Bind ViewModel.ModeText, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="{x:Bind Side}" Spacing="6">
                <!-- Sample loaded state -->
                <StackPanel Visibility="{x:Bind ViewModel.HasSample, Mode=OneWay}" Spacing="6" HorizontalAlignment="{x:Bind Side}">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="{x:Bind Side}">
                        <FontIcon Glyph="&#xE8D6;" FontSize="13" Foreground="{StaticResource BrandBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.SampleName, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" MaxWidth="210" />
                    </StackPanel>
                    <Button x:Name="EditPadButton" Click="EditPad_Click" Padding="8,3" CornerRadius="6"
                            Background="{ThemeResource SurfaceL3Brush}" BorderThickness="1" BorderBrush="{ThemeResource SurfaceStrokeBrush}"
                            HorizontalAlignment="{x:Bind Side}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE70F;" FontSize="10" />
                            <TextBlock Text="Bearbeiten" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Empty pad state -->
                <StackPanel Visibility="{x:Bind VisibleIfNot(ViewModel.HasSample), Mode=OneWay}"
                            HorizontalAlignment="{x:Bind Side}" Spacing="3" Opacity="0.55">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="{x:Bind Side}">
                        <FontIcon Glyph="&#xE8F1;" FontSize="13" />
                        <TextBlock Text="Leer (Hier ablegen)" FontSize="12" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <controls:WaveformView Grid.Row="2" Height="36" Width="180" HorizontalAlignment="{x:Bind Side}"
                                   Peaks="{x:Bind ViewModel.Peaks, Mode=OneWay}"
                                   Start="{x:Bind ViewModel.TrimStart, Mode=OneWay}" End="{x:Bind ViewModel.TrimEnd, Mode=OneWay}"
                                   Cursor="{x:Bind ViewModel.Cursor, Mode=OneWay}" IsHitTestVisible="False"
                                   Visibility="{x:Bind ViewModel.HasSample, Mode=OneWay}" />
        </Grid>
    </Border>
</UserControl>
